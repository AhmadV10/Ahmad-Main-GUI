function SilenceUI:SelfTest()
	local results = {}
	local function run(name, callback)
		local ok, message = xpcall(callback, debug.traceback)
		table.insert(results, {
			Name = name,
			Success = ok,
			Message = ok and nil or tostring(message),
		})
	end

	run("Theme resolution", function()
		local silence = Themes.Resolve(nil)
		assert(silence.Name == "Silence", "Silence is not the default theme")
		assert(silence.Dark == true, "Silence must use dark mode")
		assert(
			silence.Accent == Color3.fromRGB(255, 0, 0),
			"Silence accent color is invalid"
		)
		assert(
			silence.TabIconBackground == Color3.fromRGB(138, 0, 0),
			"Silence tab icon background is invalid"
		)
		local names = Themes.GetNames()
		assert(
			names[1] == "Silence"
				and names[2] == "Light"
				and names[3] == "Dark"
				and names[4] == "Custom",
			"Built-in theme order is invalid"
		)
		local dark = Themes.Resolve("Dark")
		assert(dark.Dark == true, "Dark theme flag is invalid")
		assert(typeof(dark.Accent) == "Color3", "Accent is not Color3")
		local patched = Themes.Patch(dark, {
			RadiusWindow = 999,
			TabSelected = Color3.fromRGB(255, 0, 255),
			TabIconSelected = Color3.fromRGB(255, 0, 255),
		})
		assert(patched.RadiusWindow == 64, "Theme numeric validation failed")
		assert(
			patched.TabSelected == TAB_SELECTION_DARK,
			"Active tab color must not be theme-patchable"
		)
		assert(
			patched.TabIconSelected == TAB_ICON_GLYPH_COLOR,
			"Tab glyph color must not be theme-patchable"
		)
		local preferenceValue = {
			Color = Color3.fromRGB(10, 20, 30),
			Position = UDim2.new(0.5, 12, 0.25, -8),
		}
		local preferenceRoundtrip = decodePreferenceValue(
			encodePreferenceValue(preferenceValue)
		)
		assert(
			preferenceRoundtrip.Position == preferenceValue.Position,
			"ThemeConfig UDim2 serialization failed"
		)
		local migrated = migrateNativePreferences({
			Version = 3,
			ThemeMode = "Custom",
			Theme = {
				Control = Color3.fromRGB(43, 35, 37),
				ControlHover = Color3.fromRGB(57, 43, 46),
				ControlPressed = Color3.fromRGB(72, 50, 54),
			},
		})
		assert(migrated.Version == 4, "ThemeConfig migration version failed")
		assert(migrated.Theme.Control == Themes.Silence.Control, "ThemeConfig control migration failed")
	end)

	run("Serializer roundtrip", function()
		local source = {
			Boolean = true,
			Number = 42.5,
			String = "hello",
			Color = Color3.fromRGB(10, 20, 30),
			Vector = Vector2.new(4, 8),
			Dimension = UDim2.fromOffset(100, 200),
			Key = Enum.KeyCode.K,
			Array = { "a", "b", "c" },
		}
		local encoded = Serializer.Encode(source)
		local decoded = Serializer.Decode(encoded)
		assert(decoded.Boolean == source.Boolean, "Boolean mismatch")
		assert(decoded.Number == source.Number, "Number mismatch")
		assert(decoded.String == source.String, "String mismatch")
		assert(decoded.Color == source.Color, "Color mismatch")
		assert(decoded.Vector == source.Vector, "Vector mismatch")
		assert(decoded.Dimension == source.Dimension, "UDim2 mismatch")
		assert(decoded.Key == source.Key, "Enum mismatch")
		assert(#decoded.Array == 3, "Array mismatch")
	end)

	run("Memory storage", function()
		local storage = MemoryStorage.new()
		assert(storage:Write("test", "content") == true, "Write failed")
		assert(storage:Exists("test") == true, "Exists failed")
		assert(storage:Read("test") == "content", "Read failed")
		assert(#storage:List() == 1, "List failed")
		assert(storage:Delete("test") == true, "Delete failed")
		assert(storage:Exists("test") == false, "Delete did not remove value")
	end)

	run("Signal lifecycle", function()
		local signal = Signal.new()
		local fired = 0
		local connection = signal:Connect(function()
			fired += 1
		end)
		signal:Fire()
		task.wait()
		assert(fired == 1, "Signal did not fire")
		connection:Disconnect()
		signal:Fire()
		task.wait()
		assert(fired == 1, "Disconnected signal fired")
		signal:Destroy()
	end)

	local success = true
	for _, result in ipairs(results) do
		if not result.Success then
			success = false
			break
		end
	end
	return {
		Success = success,
		Version = self.Version,
		Results = results,
		Timestamp = os.time(),
	}
end

function SilenceUI:CreateWindow(options)
	options = options or {}
	if options.AllowMultipleWindows ~= true and options.AllowDuplicate ~= true then
		local previousWindows = {}
		for window in pairs(runtimeRegistry.Windows) do
			table.insert(previousWindows, window)
		end
		for _, window in ipairs(previousWindows) do
			if type(window) == "table"
				and window.Destroyed ~= true
				and type(window.Destroy) == "function" then
				local ok, message = pcall(window.Destroy, window)
				if not ok then
					warn("[SilenceUI] Failed to destroy previous window:", message)
				end
			end
			runtimeRegistry.Windows[window] = nil
		end
	end
	local id = options.Id or "SilenceUI"
	local existing = self.Windows[id]
	if existing and not existing.Destroyed then
		if options.AllowDuplicate then
			id = id .. "_" .. HttpService:GenerateGUID(false)
			options = Util.Copy(options)
			options.Id = id
		else
			existing:Destroy()
		end
	end
	local window = Window.new(options)
	self.Windows[window.Id] = window
	runtimeRegistry.Windows[window] = true
	if options.Search ~= false then
		window:AddSearch(type(options.Search) == "table" and options.Search or {})
	end
	if options.ToggleButton then
		window:AddToggleButton(
			type(options.ToggleButton) == "table" and options.ToggleButton or {}
		)
	end
	if options.Config ~= false then
		window:CreateConfigManager(type(options.Config) == "table" and options.Config or {})
	end
	if options and options.AppearanceTab then
		window:AddAppearanceTab(
			type(options.AppearanceTab) == "table" and options.AppearanceTab or {}
		)
	end
	if options and options.DiagnosticsTab then
		window:AddDiagnosticsTab(
			type(options.DiagnosticsTab) == "table" and options.DiagnosticsTab or {}
		)
	end
	if options and (options.ConfigTab or options.BuildConfigTab) then
		local configTabOptions = options.ConfigTab or options.BuildConfigTab
		window:AddConfigTab(
			type(configTabOptions) == "table" and configTabOptions or {}
		)
	end
	return window
end

function SilenceUI:GetWindow(id)
	return self.Windows[id]
end

function SilenceUI:Unload(id)
	local window = self.Windows[id]
	if not window then
		return false
	end
	window:Destroy()
	return true
end

function SilenceUI:UnloadAll()
	local windows = {}
	for _, window in pairs(self.Windows) do
		table.insert(windows, window)
	end
	for _, window in ipairs(windows) do
		if not window.Destroyed then
			window:Destroy()
		end
	end
	table.clear(self.Windows)
end

function SilenceUI:GetStats()
	local windows = {}
	local windowCount = 0
	local totalInstances = 0
	local totalControls = 0
	for id, window in pairs(self.Windows) do
		if not window.Destroyed then
			windowCount += 1
			local stats = window:GetStats()
			windows[id] = stats
			totalInstances += stats.Instances
			totalControls += stats.Controls
		end
	end
	return {
		Version = self.Version,
		WindowCount = windowCount,
		TotalInstances = totalInstances,
		TotalControls = totalControls,
		Windows = windows,
	}
end

function SilenceUI:IsExecutorFileStorageAvailable()
	return FileStorage.IsSupported()
