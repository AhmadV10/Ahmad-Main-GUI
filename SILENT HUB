		Size = UDim2.fromOffset(14, 28),
		Parent = track,
	})
	Util.Corner(knob, 7)
	Util.Stroke(knob, theme.Border, 0.45, 1)

	local bubble = Util.Create("Frame", {
		Name = "SliderBubble",
		AnchorPoint = Vector2.new(0.5, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(0.5, 0, 0, -12),
		Size = UDim2.fromOffset(0, 26),
		Visible = false,
		ZIndex = 3000,
		Parent = knob,
	})
	Util.Corner(bubble, 6)
	local bubblePadding = Util.Padding(bubble, 0, 8)
	
	local bubbleScale = Util.Create("UIScale", {
		Scale = 0,
		Parent = bubble,
	})

	local bubbleLabel = Util.Create("TextLabel", {
		Name = "ValueLabel",
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 12,
		Size = UDim2.fromScale(0, 1),
		TextWrapped = false,
		ZIndex = 3001,
		Parent = bubble,
	})

	local bubbleArrow = Util.Create("Frame", {
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, 0, 1, 0),
		Rotation = 45,
		Size = UDim2.fromOffset(8, 8),
		ZIndex = 2999,
		Parent = bubble,
	})
	local function createEndpoint(name, value)
		if value == nil or tostring(value) == "" then
			return nil
		end
		local asset = iconAsset(value)
		if asset then
			return Util.Create("ImageLabel", {
				Name = name,
				BackgroundTransparency = 1,
				Image = asset,
				ImageColor3 = theme.TextMuted,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(0, 0),
				Size = UDim2.fromOffset(22, 22),
				Parent = self.Content,
			})
		end
		return Util.Create("TextLabel", {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Text = tostring(value or ""),
			TextColor3 = theme.TextMuted,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.fromOffset(0, 28),
			Parent = self.Content,
		})
	end
	local leftIcon = createEndpoint(
		"LeftIcon",
		options.LeftIcon or options.MinIcon or options.LeftText or options.MinLabel or options.StartLabel
	)
	local rightIcon = createEndpoint(
		"RightIcon",
		options.RightIcon or options.MaxIcon or options.RightText or options.MaxLabel or options.EndLabel
	)
	local hasEndpoints = leftIcon ~= nil or rightIcon ~= nil

	local function updateLayout()
		if self.Destroyed then
			return
		end
		local compact = self.Content.AbsoluteSize.X > 0 and self.Content.AbsoluteSize.X < 340
		local valueWidth = compact and 76 or 100
		valueLabel.Size = UDim2.fromOffset(valueWidth, 18)

		if hasEndpoints then
			local endpointGap = compact and 8 or 12
			local maxEndpointWidth = math.max(self.Content.AbsoluteSize.X * 0.28, 36)
			local function endpointWidth(endpoint)
				if not endpoint then return 0 end
				if endpoint:IsA("TextLabel") then
					local width = math.clamp(endpoint.TextBounds.X + 2, 22, maxEndpointWidth)
					endpoint.AutomaticSize = Enum.AutomaticSize.None
					endpoint.Size = UDim2.fromOffset(width, 28)
					return width
				end
				return math.max(endpoint.AbsoluteSize.X, 22)
			end
			local leftWidth = endpointWidth(leftIcon)
			local rightWidth = endpointWidth(rightIcon)
			local trackLeft = leftWidth > 0 and leftWidth + endpointGap or 0
			local trackRight = rightWidth > 0 and rightWidth + endpointGap or 0
			local trackY = options.ShowTitle == false and 0.5 or 1
			local trackYOffset = options.ShowTitle == false and 0 or -15
			self.TitleLabel.Position = UDim2.fromOffset(0, 0)
			self.TitleLabel.Size = UDim2.new(0.58, 0, 1, 0)
			valueLabel.Position = UDim2.new(1, 0, 0, 7)
			track.Position = UDim2.new(0, trackLeft, trackY, trackYOffset)
			track.Size = UDim2.new(1, -(trackLeft + trackRight), 0, 7)
			if leftIcon then
				leftIcon.AnchorPoint = Vector2.new(0, 0.5)
				leftIcon.Position = UDim2.new(0, 0, trackY, trackYOffset)
			end
			if rightIcon then
				rightIcon.AnchorPoint = Vector2.new(1, 0.5)
				rightIcon.Position = UDim2.new(1, 0, trackY, trackYOffset)
			end
		else
			local trackGap = compact and 12 or 18
			local titleWidth = options.ShowTitle == false
					and 0
				or math.clamp(self.TitleLabel.TextBounds.X + 2, 0, self.Content.AbsoluteSize.X * 0.3)
			local measuredValueWidth = options.HideValue == true
					and 0
				or math.clamp(valueLabel.TextBounds.X + 4, 36, valueWidth)
			local trackLeft = titleWidth > 0 and titleWidth + trackGap or 0
			local trackRight = measuredValueWidth > 0 and measuredValueWidth + trackGap or 0
			self.TitleLabel.Position = UDim2.fromOffset(0, 0)
			self.TitleLabel.Size = UDim2.new(0, titleWidth, 1, 0)
			valueLabel.AnchorPoint = Vector2.new(1, 0.5)
			valueLabel.Position = UDim2.new(1, 0, 0.5, 0)
			valueLabel.Size = UDim2.fromOffset(measuredValueWidth, 18)
			track.Position = UDim2.new(0, trackLeft, 0.5, 0)
			track.Size = UDim2.new(1, -(trackLeft + trackRight), 0, 7)
		end
	end
	self._maid:Give(self.Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout))
	self._maid:Give(self.TitleLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	self._maid:Give(valueLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	if leftIcon and leftIcon:IsA("TextLabel") then
		self._maid:Give(leftIcon:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	end
	if rightIcon and rightIcon:IsA("TextLabel") then
		self._maid:Give(rightIcon:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	end
	task.defer(updateLayout)

	local dragging = false

	local function ratio()
		return (self._value - minimum) / (maximum - minimum)
	end

	local function render(nextTheme, animate)
		local currentRatio = ratio()
		valueLabel.Text = tostring(self._value) .. (options.Suffix or "")
		valueLabel.TextColor3 = nextTheme.Accent
		valueLabel.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
		valueLabel.TextSize = (nextTheme.TextSizeOffset or 0) + 13
		track.BackgroundColor3 = nextTheme.Control
		fill.BackgroundColor3 = nextTheme.Accent
		if leftIcon and leftIcon:IsA("ImageLabel") then
			leftIcon.ImageColor3 = nextTheme.TextMuted
		elseif leftIcon then
			leftIcon.TextColor3 = nextTheme.TextMuted
		end
		if rightIcon and rightIcon:IsA("ImageLabel") then
			rightIcon.ImageColor3 = nextTheme.TextMuted
		elseif rightIcon then
			rightIcon.TextColor3 = nextTheme.TextMuted
		end
		local duration = animate and context:GetMotion("Fast") or 0
		Util.Tween(fill, duration, { Size = UDim2.fromScale(currentRatio, 1) })
		Util.Tween(knob, duration, { Position = UDim2.fromScale(currentRatio, 0.5) })

		styleGlass(bubble, nextTheme, context.Quality, nil, "Overlay")
		bubbleLabel.TextColor3 = nextTheme.Text
		bubbleLabel.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
		bubbleLabel.TextSize = (nextTheme.TextSizeOffset or 0) + 12
		bubbleLabel.Text = tostring(self._value) .. (options.Suffix or "")
		
		local glassTint = nextTheme.Dark and nextTheme.SurfaceOverlay or nextTheme.GlassTint:Lerp(nextTheme.SurfaceRaised, 0.86)
		bubbleArrow.BackgroundColor3 = glassTint
		bubbleArrow.BackgroundTransparency = bubble.BackgroundTransparency
	end
	self._renderControl = render

	function self:SetValue(value, silent)
		if type(value) ~= "number" then
			return
		end
		local nextValue = math.clamp(Util.Round(value, step), minimum, maximum)
		if self._value == nextValue then
			return
		end
		self._value = nextValue
		render(context:GetTheme(), not dragging)
		if not silent then
			self.Changed:Fire(nextValue)
			Util.SafeCall(self._callback, nextValue)
		end
	end

	local function setFromPosition(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local currentRatio = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		self:SetValue(minimum + (maximum - minimum) * currentRatio, true)
	end

	self._maid:Give(track.InputBegan:Connect(function(input)
		if self.Disabled or not Util.IsPrimaryInput(input) then
			return
		end
		dragging = true
		bubble.Visible = true
		bubbleScale.Scale = 0
		Util.Tween(bubbleScale, context:GetMotion("Fast") or 0.15, { Scale = 1 })
		setFromPosition(input.Position.X)
		local dragMaid = Maid.new()
		self._maid:Set("SliderDrag", dragMaid)
		dragMaid:Give(UserInputService.InputChanged:Connect(function(changedInput)
			if dragging and (
				changedInput.UserInputType == Enum.UserInputType.MouseMovement
				or changedInput.UserInputType == Enum.UserInputType.Touch
			) then
				setFromPosition(changedInput.Position.X)
			end
		end))
		dragMaid:Give(input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				self._maid:Set("SliderDrag", nil)
				Util.Tween(bubbleScale, context:GetMotion("Fast") or 0.15, { Scale = 0 })
				task.delay(context:GetMotion("Fast") or 0.15, function()
					if not dragging and not self.Destroyed then
						bubble.Visible = false
					end
				end)
				self.Changed:Fire(self._value)
				Util.SafeCall(self._callback, self._value)
			end
		end))
	end))
	render(theme, false)
	return self
end

-- Number input ---------------------------------------------------------------

local NumberInputControl = {}

function NumberInputControl.new(context, parent, options)
	local minimum = tonumber(options.Min)
	local maximum = tonumber(options.Max)
	local step = math.max(tonumber(options.Step) or 1, 0.000001)
	local default = tonumber(options.Default) or minimum or 0
	if minimum then default = math.max(default, minimum) end
	if maximum then default = math.min(default, maximum) end
	default = Util.Round(default, step)

	local self = BaseControl.new(context, parent, options, 60)
	self._default = default
	self._value = default
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	local holder = Util.Create("Frame", {
		Name = "NumberInput",
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(168, 38),
		Parent = self.Content,
	})
	Util.Corner(holder, theme.RadiusSmall)
	local holderStroke = Util.Stroke(holder, theme.Border, 0.78, 1)
	holderStroke.Name = "GlassStroke"
	styleGlass(holder, theme, context.Quality, nil, "Inset")

	local decrease = Util.Create("TextButton", {
		Name = "Decrease",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "-",
		TextColor3 = theme.Text,
		TextSize = 17,
		Size = UDim2.fromOffset(34, 36),
		Parent = holder,
	})
	local increase = Util.Create("TextButton", {
		Name = "Increase",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "+",
		TextColor3 = theme.Text,
		TextSize = 17,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(34, 36),
		Parent = holder,
	})
	local box = Util.Create("TextBox", {
		Name = "Value",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamMedium,
		Text = tostring(default),
		TextColor3 = theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -68, 1, 0),
		Parent = holder,
	})
	Util.BindFocusRing(box, function() return context:GetTheme() end, self._maid)
	Util.BindFocusRing(decrease, function() return context:GetTheme() end, self._maid)
	Util.BindFocusRing(increase, function() return context:GetTheme() end, self._maid)

	local internal = false
	local function clamp(value)
		if minimum then value = math.max(value, minimum) end
		if maximum then value = math.min(value, maximum) end
		return Util.Round(value, step)
	end

	local function display(value)
		local decimals = math.max(0, math.ceil(-math.log10(step)))
		local text
		if decimals > 0 and decimals < 7 then
			text = string.format("%." .. tostring(decimals) .. "f", value)
		else
			text = tostring(value)
		end
		return (options.Prefix or "") .. text .. (options.Suffix or "")
	end

	self._renderControl = function(nextTheme)
		styleGlass(holder, nextTheme, context.Quality, nil, "Inset")
		decrease.TextColor3 = self.Disabled and nextTheme.TextDisabled
			or nextTheme.Dark and Color3.new(1, 1, 1)
			or nextTheme.Text
		decrease.Font = nextTheme.FontBold or Enum.Font.GothamBold
		decrease.TextSize = (nextTheme.TextSizeOffset or 0) + 17
		increase.TextColor3 = self.Disabled and nextTheme.TextDisabled
			or nextTheme.Dark and Color3.new(1, 1, 1)
			or nextTheme.Text
		increase.Font = nextTheme.FontBold or Enum.Font.GothamBold
		increase.TextSize = (nextTheme.TextSizeOffset or 0) + 17
		box.TextColor3 = self.Disabled and nextTheme.TextDisabled
			or nextTheme.Dark and Color3.new(1, 1, 1)
			or nextTheme.Text
		box.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
		box.TextSize = (nextTheme.TextSizeOffset or 0) + 12
	end

	function self:SetValue(value, silent)
		value = tonumber(value)
		if not value then
			return
		end
		local nextValue = clamp(value)
		if self._value == nextValue then
			internal = true
			box.Text = display(nextValue)
			internal = false
			return
		end
		self._value = nextValue
		internal = true
		box.Text = display(nextValue)
		internal = false
		if not silent then
			self.Changed:Fire(nextValue)
			Util.SafeCall(self._callback, nextValue)
		end
	end

	local function commitText()
		local clean = box.Text
		if options.Prefix and options.Prefix ~= "" then
			clean = clean:gsub("^" .. options.Prefix:gsub("(%W)", "%%%1"), "")
		end
		if options.Suffix and options.Suffix ~= "" then
			clean = clean:gsub(options.Suffix:gsub("(%W)", "%%%1") .. "$", "")
		end
		local value = tonumber(clean)
		if value then
			self:SetValue(value)
		else
			internal = true
			box.Text = display(self._value)
			internal = false
		end
	end

	self._maid:Give(decrease.Activated:Connect(function()
		if not self.Disabled then
			self:SetValue(self._value - step)
		end
	end))
	self._maid:Give(increase.Activated:Connect(function()
		if not self.Disabled then
			self:SetValue(self._value + step)
		end
	end))
	self._maid:Give(box.FocusLost:Connect(commitText))
	self._maid:Give(box:GetPropertyChangedSignal("Text"):Connect(function()
		if internal then return end
		local clean = box.Text:gsub("[^%d%.%-]", "")
		if clean ~= box.Text and not options.Prefix and not options.Suffix then
			box.Text = clean
		end
	end))

	function self:Increment(amount, silent)
		self:SetValue(self._value + (tonumber(amount) or step), silent)
	end

	function self:Decrement(amount, silent)
		self:SetValue(self._value - (tonumber(amount) or step), silent)
	end

	function self:Focus()
		box:CaptureFocus()
	end

	internal = true
	box.Text = display(default)
	internal = false
	return self
end

