		Height = 180,
		MaxLength = 1000000,
		Save = false,
	})
	portability:AddButton({
		Id = "__ExportConfig",
		Title = "Export current values",
		ButtonText = "Export",
		Callback = function()
			local content = manager:Export()
			if not content then
				self:Notify({
					Title = "Export failed",
					Type = "Error",
