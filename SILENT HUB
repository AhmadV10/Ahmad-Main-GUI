function Window:_captureNativePreferences()
	local minimizePosition = self._options.MinimizePosition
	if self._minimizeButton and self._minimizeButton.Root then
		minimizePosition = self._minimizeButton.Root.Position
	end
	return {
		Version = 4,
		Theme = Util.Copy(self._theme),
		ThemeMode = self._themeMode or "Custom",
		Quality = self.RequestedQuality,
		Scale = self.Scale,
		ReducedMotion = self.ReducedMotion,
		Minimized = self._minimized,
		MinimizePosition = minimizePosition,
		WindowPosition = self._fullscreen and self._restorePosition or self.Frame.Position,
		WindowSize = self._fullscreen and self._restoreSize or self.Frame.Size,
		SelectedTab = self._selectedTab,
	}
end

function Window:_saveNativePreferences()
	if not self._preferenceEnabled or self.Destroyed or not self._preferenceDirty then
		return false
	end
	if self._preferenceSaveThread then
		task.cancel(self._preferenceSaveThread)
		self._preferenceSaveThread = nil
	end
	local success, message = NativePreferences:Save(
		self.Id,
		self:_captureNativePreferences()
	)
	if not success then
		warn("[SilenceUI] Failed to save native appearance:", message)
	else
		self._preferenceDirty = false
	end
	return success
end

function Window:_queueNativePreferenceSave()
	if not self._preferenceEnabled or self.Destroyed then
		return
	end
	if self._preferenceSaveThread then
		task.cancel(self._preferenceSaveThread)
	end
	self._preferenceDirty = true
	self._preferenceSaveThread = task.delay(0.35, function()
		self._preferenceSaveThread = nil
		if not self.Destroyed then
			self:_saveNativePreferences()
		end
	end)
end

function Window:SetNativePreferencesEnabled(enabled)
	self._preferenceEnabled = enabled == true
	if self._preferenceEnabled then
		self:_queueNativePreferenceSave()
	elseif self._preferenceSaveThread then
		task.cancel(self._preferenceSaveThread)
		self._preferenceSaveThread = nil
	end
end

function Window:ResetNativePreferences(applyDefaults)
	if self._preferenceSaveThread then
		task.cancel(self._preferenceSaveThread)
		self._preferenceSaveThread = nil
	end
	NativePreferences:Delete()
	self._preferenceDirty = false
	if applyDefaults ~= false then
		self._theme = Themes.Resolve("Silence")
		self._themeMode = "Silence"
		self.RequestedQuality = "Auto"
		self.Quality = resolveQuality("Auto", self.Frame.AbsoluteSize)
		self.Scale = 1
		self.ReducedMotion = false
		self._uiScale.Scale = 1
		self:_applyTheme()
	end
end

function Window:SaveAppearanceNow()
	self._preferenceDirty = true
	return self:_saveNativePreferences()
end

function Window:ExportAppearance()
	local data = self:_captureNativePreferences()
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, encodePreferenceValue(data))
	if not ok then
		return nil, encoded
	end
	return encoded
end

function Window:ImportAppearance(content, save)
	if type(content) ~= "string" or content == "" then
		return false, "Appearance JSON is empty"
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
	if not ok or type(decoded) ~= "table" then
		return false, decoded
	end
	local data = migrateNativePreferences(decodePreferenceValue(decoded))
	if type(data.Theme) == "table" then
		self._theme = Themes.Resolve(data.Theme)
		self._themeMode = data.ThemeMode or self._theme.Name or "Custom"
	end
	if type(data.Quality) == "string" then
		self:SetQuality(data.Quality)
	end
	if type(data.Scale) == "number" then
		self.Scale = math.clamp(data.Scale, 0.65, 1.5)
		self._uiScale.Scale = self.Scale
	end
	if type(data.ReducedMotion) == "boolean" then
		self.ReducedMotion = data.ReducedMotion
	end
	self:_applyTheme()
	if save ~= false then
		self:_queueNativePreferenceSave()
	end
	return true
end

function Window:GetMotion(token)
	if self.ReducedMotion then
		return 0
	end
	if token == "Fast" then
		return self._theme.MotionFast
	elseif token == "Slow" then
		return self._theme.MotionSlow
	end
	return self._theme.MotionNormal
end

function Window:GiveTask(taskObject)
	assert(not self.Destroyed, "Cannot add a task to a destroyed window")
	return self._maid:Give(taskObject)
end

function Window:SpawnTask(callback, ...)
	assert(type(callback) == "function", "Task callback must be a function")
	local arguments = table.pack(...)
	local taskHandle = {
		Thread = nil,
	}
	function taskHandle:Destroy()
		local threadObject = self.Thread
		if threadObject and coroutine.status(threadObject) ~= "dead" then
			task.cancel(threadObject)
		end
		self.Thread = nil
	end
	taskHandle.Cancel = taskHandle.Destroy
	local threadObject = task.spawn(function()
		local ok, message = xpcall(function()
			callback(table.unpack(arguments, 1, arguments.n))
		end, debug.traceback)
		if not ok then
			warn("[SilenceUI] Window task failed:\n" .. tostring(message))
		end
	end)
	taskHandle.Thread = threadObject
	self:GiveTask(taskHandle)
	return taskHandle
end

function Window:WatchTheme(callback)
	assert(type(callback) == "function", "Theme callback must be a function")
	table.insert(self._themeListeners, callback)
	local connected = true
	return function()
		if not connected then
			return
		end
		connected = false
		local index = table.find(self._themeListeners, callback)
		if index then
			table.remove(self._themeListeners, index)
		end
	end
end

function Window:RegisterControl(control)
	assert(self._controls[control.Id] == nil, "Duplicate control Id: " .. control.Id)
	self._controls[control.Id] = control
	if control.Changed then
		control._maid:Give(control.Changed:Connect(function(value)
			self.ControlChanged:Fire(control.Id, value, control)
		end))
	end
	if self._configManager then
		task.defer(function()
			if not self.Destroyed and not control.Destroyed and self._configManager then
				self._configManager:RestoreControl(control)
			end
		end)
	end
end

function Window:RegisterKeybindControl(control)
	if table.find(self._keybindControls, control) then
		return
	end
	table.insert(self._keybindControls, control)
	if #self._keybindControls == 1 then
		self._maid:Set("SharedKeybindBegan", UserInputService.InputBegan:Connect(function(input, processed)
			for _, keybind in ipairs(table.clone(self._keybindControls)) do
				if not keybind.Destroyed then
					keybind:_HandleInputBegan(input, processed)
				end
			end
		end))
		self._maid:Set("SharedKeybindEnded", UserInputService.InputEnded:Connect(function(input)
			for _, keybind in ipairs(table.clone(self._keybindControls)) do
				if not keybind.Destroyed then
					keybind:_HandleInputEnded(input)
				end
			end
		end))
	end
end

function Window:UnregisterKeybindControl(control)
	local index = table.find(self._keybindControls, control)
	if index then
		table.remove(self._keybindControls, index)
	end
	if #self._keybindControls == 0 then
		self._maid:Set("SharedKeybindBegan", nil)
		self._maid:Set("SharedKeybindEnded", nil)
