		Id = "__ImportConfig",
		Title = "Import JSON",
		ButtonText = "Import",
		Style = "Accent",
		Callback = function()
			local content = configText:GetValue()
			local success, message = manager:Import(content, true)
			self:Notify({
				Title = success and "Config imported" or "Import failed",
				Content = success and "Element values were restored." or message,
				Type = success and "Success" or "Error",
			})
		end,
	})
