local InputControl = {}

function InputControl.new(context, parent, options)
	local self = BaseControl.new(context, parent, options, 62)
	self._default = tostring(options.Default or "")
	self._value = self._default
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	local box = Util.Create("TextBox", {
		Name = "Input",
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		ClearTextOnFocus = options.ClearOnFocus == true,
		Font = Enum.Font.Gotham,
		PlaceholderText = options.Placeholder or "Enter value",
		PlaceholderColor3 = theme.TextMuted,
		Text = self._value,
		TextColor3 = theme.Text,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(210, 38),
		Parent = self.Content,
	})
	Util.Corner(box, theme.RadiusSmall)
	Util.Padding(box, 0, 10, 0, 10)
	local boxStroke = Util.Stroke(box, theme.Border, 0.78, 1)
	boxStroke.Name = "GlassStroke"
	styleGlass(box, theme, context.Quality, nil, "Inset")
	Util.BindFocusRing(box, function() return context:GetTheme() end, self._maid)
	local internal = false

	local function sanitize(value)
		value = tostring(value)
		if options.NumbersOnly then
			value = value:gsub("[^%d%.%-]", "")
		end
		local maxLength = tonumber(options.MaxLength)
		if maxLength and #value > maxLength then
			value = value:sub(1, maxLength)
		end
		return value
	end

	self._renderControl = function(nextTheme)
		styleGlass(box, nextTheme, context.Quality, nil, "Inset")
		box.TextColor3 = nextTheme.Dark and Color3.new(1, 1, 1) or nextTheme.Text
		box.PlaceholderColor3 = nextTheme.Dark and Color3.new(1, 1, 1) or nextTheme.TextMuted
		box.Font = nextTheme.FontNormal or Enum.Font.Gotham
		box.TextSize = (nextTheme.TextSizeOffset or 0) + 14
	end

	function self:SetValue(value, silent)
		if type(value) ~= "string" and type(value) ~= "number" then
			return
		end
		local nextValue = sanitize(value)
		if self._value == nextValue then
			return
		end
		self._value = nextValue
		internal = true
		box.Text = nextValue
		internal = false
		if not silent then
			self.Changed:Fire(nextValue)
			Util.SafeCall(self._callback, nextValue)
		end
	end

	self._maid:Give(box:GetPropertyChangedSignal("Text"):Connect(function()
		if internal then
			return
		end
		local clean = sanitize(box.Text)
		if clean ~= box.Text then
			box.Text = clean
		end
		self:SetValue(clean)
	end))
	self._maid:Give(box.Focused:Connect(function()
		boxStroke.Color = context:GetTheme().FocusRing
		boxStroke.Transparency = 0.1
	end))
	self._maid:Give(box.FocusLost:Connect(function(enterPressed)
		boxStroke.Color = context:GetTheme().Accent
		boxStroke.Transparency = 0
		if enterPressed then
			Util.SafeCall(options.OnSubmitted, self._value)
		end
	end))

	function self:Focus()
		box:CaptureFocus()
	end

	function self:Clear(silent)
		self:SetValue("", silent)
	end

	function self:SetPlaceholder(value)
		box.PlaceholderText = tostring(value or "")
	end
	return self
end

