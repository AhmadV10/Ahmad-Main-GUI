local ProgressControl = {}

function ProgressControl.new(context, parent, options)
	local minimum = tonumber(options.Min) or 0
	local maximum = tonumber(options.Max) or 100
	if maximum <= minimum then
		maximum = minimum + 1
	end
	local default = math.clamp(tonumber(options.Default) or minimum, minimum, maximum)

	local self = BaseControl.new(context, parent, options, 74)
	self.Save = options.Save == true
	self._default = default
	self._value = default
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	self.TitleLabel.Position = UDim2.fromOffset(0, 4)
	self.TitleLabel.Size = UDim2.new(1, -110, 0, 26)
	local valueLabel = Util.Create("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.TextMuted,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 8),
		Size = UDim2.fromOffset(90, 18),
		Parent = self.Content,
	})
	local track = Util.Create("Frame", {
		Name = "Track",
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -16),
		Size = UDim2.new(1, 0, 0, 8),
		Parent = self.Content,
	})
	Util.Corner(track, 4)
	local fill = Util.Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = options.Color or theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Util.Corner(fill, 4)

	local function ratio()
		return math.clamp((self._value - minimum) / (maximum - minimum), 0, 1)
	end

	local function render(nextTheme, animate)
		track.BackgroundColor3 = nextTheme.Control
		fill.BackgroundColor3 = options.Color or nextTheme.Accent
		valueLabel.TextColor3 = nextTheme.TextMuted
		local currentRatio = ratio()
		valueLabel.Text = options.HideValue and "" or (
			tostring(math.round(currentRatio * 100))
			.. (options.Suffix or "%")
		)
		Util.Tween(fill, animate and context:GetMotion("Normal") or 0, {
			Size = UDim2.fromScale(currentRatio, 1),
		})
	end
	self._renderControl = render

	function self:SetValue(value, silent)
		if type(value) ~= "number" then
			return
		end
		local nextValue = math.clamp(value, minimum, maximum)
		if self._value == nextValue then
			return
		end
		self._value = nextValue
		render(context:GetTheme(), true)
		if not silent then
			self.Changed:Fire(nextValue)
			Util.SafeCall(self._callback, nextValue)
		end
	end

	function self:SetColor(color)
		if typeof(color) == "Color3" then
			options.Color = color
			render(context:GetTheme(), true)
		end
	end

	render(theme, false)
	return self
end

