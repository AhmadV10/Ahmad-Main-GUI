function Window:RemoveTab(id)
	local tab = self._tabById[id]
	if not tab then
		return false
	end
	local wasSelected = self._selectedTab == id
	self._tabById[id] = nil
	local index = table.find(self._tabs, tab)
	if index then
		table.remove(self._tabs, index)
	end
	tab:Destroy()
	for tabIndex, candidate in ipairs(self._tabs) do
		local previous = self._tabs[tabIndex - 1]
		local following = self._tabs[tabIndex + 1]
		candidate.NavigationButton.NextSelectionUp = previous and previous.NavigationButton or nil
		candidate.NavigationButton.NextSelectionDown = following and following.NavigationButton or nil
	end

	if wasSelected then
		self._selectedTab = nil
		for _, candidate in ipairs(self._tabs) do
			if candidate.Visible and not candidate.Disabled then
				self:SelectTab(candidate.Id)
				break
			end
		end
	end
	return true
end

function Window:SelectTab(id)
	local selected = self._tabById[id]
	if not selected or selected.Disabled or not selected.Visible then
		return
	end
	if self._selectedTab == id then
		return
	end
	self._selectedTab = id
	if self._pageTitle then
		self._pageTitle.Text = selected.Title
	end
	for _, tab in ipairs(self._tabs) do
		tab:SetSelected(tab == selected)
	end
	self.TabChanged:Fire(id, selected)
	self:_queueNativePreferenceSave()
end

function Window:SetFullscreen(fullscreen)
	fullscreen = fullscreen == true
	if self._fullscreen == fullscreen then
		return
	end
	self._fullscreen = fullscreen
	if self._resizeHandle then
		self._resizeHandle.Visible = not fullscreen
	end
	if fullscreen then
		self._restoreSize = self.Frame.Size
		self._restorePosition = self.Frame.Position
		self.Frame.AnchorPoint = Vector2.new(0.5, 0.5)
		Util.Tween(self.Frame, self:GetMotion("Normal"), {
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, -24, 1, -24),
		})
	else
		Util.Tween(self.Frame, self:GetMotion("Normal"), {
			Position = self._restorePosition,
			Size = self._restoreSize,
		})
	end
	local actions = self._header:FindFirstChild("WindowActions")
	local button = actions and actions:FindFirstChild("Fullscreen")
	local icon = button and button:FindFirstChild("Icon")
	if icon and icon:IsA("ImageLabel") then
		icon.Image = iconAsset(fullscreen and "minimize-2" or "maximize")
	end
	self:_queueNativePreferenceSave()
end

