			titleLabel.TextColor3 = nextTheme.Text
			titleLabel.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
			titleLabel.TextSize = (nextTheme.TextSizeOffset or 0) + 14
		end
		local stroke = root:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = nextTheme.Border
