	})
	Util.Corner(search, 6)
	Util.Padding(search, 0, 8, 0, 8)
	styleGlass(search, theme, context.Quality, nil, "Inset")
	local clearButton = Util.Create("TextButton", {
		Name = "Clear",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = "Clear",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 9,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -60, 0.5, 0),
		Size = UDim2.fromOffset(50, 28),
		Parent = toolbar,
	})
	Util.Corner(clearButton, 6)
	styleGlass(clearButton, theme, context.Quality, nil, "Inset")
	local copyButton = Util.Create("TextButton", {
		Name = "Copy",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = "Copy",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 9,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(48, 28),
		Parent = toolbar,
	})
	Util.Corner(copyButton, 6)
	styleGlass(copyButton, theme, context.Quality, nil, "Inset")

	local scroller = Util.Create("ScrollingFrame", {
		Name = "Entries",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarImageColor3 = theme.TextMuted,
		ScrollBarThickness = 3,
		Position = UDim2.fromOffset(8, 50),
		Size = UDim2.new(1, -16, 1, -58),
		Parent = root,
	})
	Util.List(scroller, 3)

	local maid = Maid.new()
	maid:Give(root)
	local entries = {}
	local entryById = {}
	local sequence = 0
	local severityVisibility = {
		Info = true,
		Success = true,
		Warning = true,
		Error = true,
		Debug = true,
	}

	local function severityColor(severity, nextTheme)
		return severity == "Error" and nextTheme.Danger
			or severity == "Warning" and nextTheme.Warning
			or severity == "Success" and nextTheme.Success
			or severity == "Debug" and nextTheme.TextMuted
			or nextTheme.Accent
	end

	local function matches(entry)
		if severityVisibility[entry.Severity] == false then
			return false
		end
		local query = string.lower(search.Text)
		if query == "" then return true end
		return string.find(string.lower(entry.Text), query, 1, true) ~= nil
	end

	local function updateEntry(entry)
		if not entry.Root then return end
		entry.Root.Visible = matches(entry)
		local nextTheme = context:GetTheme()
		entry.Root.BackgroundColor3 = nextTheme.SurfaceRaised
		local marker = entry.Root:FindFirstChild("Marker")
		local text = entry.Root:FindFirstChild("Text")
		local time = entry.Root:FindFirstChild("Time")
		if marker then marker.BackgroundColor3 = severityColor(entry.Severity, nextTheme) end
		if text then
			text.TextColor3 = nextTheme.Text
			text.TextSize = (nextTheme.TextSizeOffset or 0) + (tonumber(options.TextSize) or 10)
		end
		if time then
			time.TextColor3 = nextTheme.TextMuted
			time.TextSize = (nextTheme.TextSizeOffset or 0) + 9
		end
	end

	local function removeOldest()
		while #entries > maxEntries do
			local entry = table.remove(entries, 1)
			entryById[entry.Id] = nil
			if entry.Root then
				entry.Root:Destroy()
				entry.Root = nil
			end
		end
	end

	local function createEntry(entry)
		local row = Util.Create("Frame", {
			Name = entry.Id,
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = theme.SurfaceRaised,
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
			LayoutOrder = entry.Sequence,
			Size = UDim2.new(1, 0, 0, 0),
			Parent = scroller,
		})
		Util.Corner(row, 6)
		Util.Create("Frame", {
			Name = "Marker",
			BackgroundColor3 = severityColor(entry.Severity, theme),
			BorderSizePixel = 0,
			Size = UDim2.new(0, 3, 1, 0),
			Parent = row,
		})
		Util.Create("TextLabel", {
			Name = "Time",
			BackgroundTransparency = 1,
			Font = Enum.Font.Code,
			Text = entry.Time,
			TextColor3 = theme.TextMuted,
			TextSize = (theme.TextSizeOffset or 0) + 9,
			TextXAlignment = Enum.TextXAlignment.Left,
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.fromOffset(54, 16),
			Parent = row,
		})
		Util.Create("TextLabel", {
			Name = "Text",
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = Enum.Font.Code,
			RichText = options.RichText == true,
			Text = entry.Text,
			TextColor3 = theme.Text,
			TextSize = (theme.TextSizeOffset or 0) + (tonumber(options.TextSize) or 10),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(68, 6),
			Size = UDim2.new(1, -78, 0, 0),
			Parent = row,
		})
		Util.Create("UIPadding", {
			PaddingBottom = UDim.new(0, 6),
			Parent = row,
		})
		entry.Root = row
		updateEntry(entry)
	end

	local api = {
		Id = options.Id or "Console",
		Save = false,
		Root = root,
		Destroyed = false,
	}

	function api:Log(value, severity)
		sequence += 1
		local entry = {
			Id = "Entry_" .. tostring(sequence),
			Sequence = sequence,
			Text = tostring(value),
			Severity = severity or "Info",
			Time = os.date("%H:%M:%S"),
			Root = nil,
		}
		table.insert(entries, entry)
		entryById[entry.Id] = entry
		createEntry(entry)
		removeOldest()
		task.defer(function()
			if not api.Destroyed and options.AutoScroll ~= false then
				scroller.CanvasPosition = Vector2.new(
					0,
					math.max(0, scroller.AbsoluteCanvasSize.Y - scroller.AbsoluteSize.Y)
				)
			end
		end)
		return entry.Id
	end

	function api:Info(value) return self:Log(value, "Info") end
	function api:Success(value) return self:Log(value, "Success") end
	function api:Warn(value) return self:Log(value, "Warning") end
	function api:Error(value) return self:Log(value, "Error") end
	function api:Debug(value) return self:Log(value, "Debug") end

	function api:Remove(id)
		local entry = entryById[id]
		if not entry then return false end
		entryById[id] = nil
		local index = table.find(entries, entry)
		if index then table.remove(entries, index) end
		if entry.Root then entry.Root:Destroy() end
		return true
	end

	function api:Clear()
		for _, entry in ipairs(entries) do
			if entry.Root then entry.Root:Destroy() end
		end
		table.clear(entries)
		table.clear(entryById)
	end

	function api:SetFilter(severity, visible)
		severityVisibility[severity] = visible == true
		for _, entry in ipairs(entries) do
			updateEntry(entry)
		end
	end

	function api:SetQuery(query)
		search.Text = tostring(query or "")
	end

	function api:GetText()
		local lines = {}
		for _, entry in ipairs(entries) do
			table.insert(lines, string.format("[%s] [%s] %s", entry.Time, entry.Severity, entry.Text))
		end
		return table.concat(lines, "\n")
	end

	function api:SetVisible(visible)
		root.Visible = visible == true
	end

	function api:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		maid:Destroy()
	end

	maid:Give(search:GetPropertyChangedSignal("Text"):Connect(function()
		for _, entry in ipairs(entries) do
			updateEntry(entry)
		end
	end))
	maid:Give(clearButton.Activated:Connect(function()
		api:Clear()
	end))
	maid:Give(copyButton.Activated:Connect(function()
		local clipboard = getGlobal("setclipboard")
		if type(clipboard) == "function" then
			pcall(clipboard, api:GetText())
		end
	end))
	maid:Give(context:WatchTheme(function(nextTheme)
		styleGlass(root, nextTheme, context.Quality, nil, "Panel")
		styleGlass(toolbar, nextTheme, context.Quality, nil, "Inset")
		title.TextColor3 = nextTheme.Text
		title.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		title.TextSize = (nextTheme.TextSizeOffset or 0) + 12
		styleGlass(search, nextTheme, context.Quality, nil, "Inset")
		search.TextColor3 = nextTheme.Text
		search.PlaceholderColor3 = nextTheme.TextMuted
		search.Font = nextTheme.FontNormal or Enum.Font.Gotham
		search.TextSize = (nextTheme.TextSizeOffset or 0) + 10
		styleGlass(clearButton, nextTheme, context.Quality, nil, "Inset")
		clearButton.TextColor3 = nextTheme.Text
		clearButton.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		clearButton.TextSize = (nextTheme.TextSizeOffset or 0) + 9
		styleGlass(copyButton, nextTheme, context.Quality, nil, "Inset")
		copyButton.TextColor3 = nextTheme.Text
		copyButton.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		copyButton.TextSize = (nextTheme.TextSizeOffset or 0) + 9
		scroller.ScrollBarImageColor3 = nextTheme.TextMuted
		for _, entry in ipairs(entries) do
			updateEntry(entry)
		end
	end))

	for _, entry in ipairs(options.InitialEntries or {}) do
		if type(entry) == "table" then
			api:Log(entry.Text or entry.Message or "", entry.Severity or entry.Type)
		else
			api:Log(entry)
		end
	end
	return api
end

