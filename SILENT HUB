			if success then refreshList(newName) end
		end,
	})
	persistence:AddDescription({
		Id = "__RenameConfigDescription",
		Text = "Uses the name entered above as the new name.",
	})
	persistence:AddButton({
		Id = "__DuplicateConfig",
		Title = "Duplicate selected config",
		ButtonText = "Duplicate",
		Callback = function()
			local sourceName = configList:GetValue()
			local targetName = nameInput:GetValue()
			local success, message = manager:Duplicate(sourceName, targetName)
			self:Notify({
				Title = success and "Config duplicated" or "Duplicate failed",
