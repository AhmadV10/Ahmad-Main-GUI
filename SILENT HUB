			self._minimizeButton = self:AddToggleButton({
				Icon = BRAND_ICON,
				Position = self._options.MinimizePosition or UDim2.new(1, -22, 0, 22),
				Size = self._options.MinimizeSize or 58,
				Draggable = true,
				Round = self._options.MinimizeRound == true,
				InternalMinimize = true,
			})
		end
		self._minimizeButton:SetVisible(true)
		self.Root.Enabled = false
	else
		self.Root.Enabled = true
		if self._minimizeButton then
