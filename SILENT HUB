function Window:AddDiagnosticsTab(options)
	options = options or {}
	local id = options.Id or "__SilenceUIDiagnostics"
	local existing = self:GetTab(id)
	if existing then
		return existing
	end
	local tab = self:AddTab({
		Id = id,
		Title = options.Title or "Diagnostics",
		Icon = options.Icon or "info",
		Order = options.Order or 10001,
	})
	local overview = tab:AddSection({
		Id = "__DiagnosticsOverview",
		Title = "Runtime",
		Description = "Statistics are calculated only when refreshed.",
	})
	local windowStats = overview:AddParagraph({
		Id = "__WindowStats",
		Title = "Window statistics",
		Content = "Not measured yet.",
	})
	local libraryStats = overview:AddParagraph({
		Id = "__LibraryStats",
		Title = "Library statistics",
		Content = "Not measured yet.",
	})
	local testResults = overview:AddParagraph({
		Id = "__SelfTest",
		Title = "Self test",
		Content = "Not run yet.",
	})

	local function formatWindowStats()
		local stats = self:GetStats()
		return string.format(
			"Instances: %d\nTabs: %d\nControls: %d\nKeybinds: %d\nCommands: %d\nQuality: %s\nInput: %s",
			stats.Instances,
			stats.Tabs,
			stats.Controls,
			stats.Keybinds,
			stats.Commands,
			stats.Quality,
			self:GetInputMode()
		)
	end

	local function formatLibraryStats()
		local stats = SilenceUI:GetStats()
		return string.format(
			"Version: %s\nWindows: %d\nInstances: %d\nControls: %d",
			stats.Version,
			stats.WindowCount,
			stats.TotalInstances,
			stats.TotalControls
		)
	end

	local function formatTestReport(report)
		local lines = {
			report.Success and "All tests passed." or "One or more tests failed.",
		"",
	}
		for _, result in ipairs(report.Results) do
			table.insert(lines, string.format(
				"[%s] %s%s",
				result.Success and "PASS" or "FAIL",
				result.Name,
				result.Message and (": " .. result.Message) or ""
			))
		end
		return table.concat(lines, "\n")
	end

	local latestReport = nil
	overview:AddButton({
		Id = "__RefreshDiagnostics",
		Title = "Refresh statistics",
		ButtonText = "Refresh",
		Style = "Accent",
		Callback = function()
			windowStats:SetContent(formatWindowStats())
			libraryStats:SetContent(formatLibraryStats())
		end,
	})
	overview:AddButton({
		Id = "__RunSelfTest",
		Title = "Run self test",
		ButtonText = "Run",
		Callback = function()
			latestReport = SilenceUI:SelfTest()
			testResults:SetContent(formatTestReport(latestReport))
			self:Notify({
				Title = latestReport.Success and "Self test passed" or "Self test failed",
				Type = latestReport.Success and "Success" or "Error",
			})
		end,
	})
	overview:AddDescription({
		Id = "__RunSelfTestDescription",
		Text = "Checks serializer, themes and storage without rebuilding the UI.",
	})
	overview:AddButton({
		Id = "__CopyDiagnostics",
		Title = "Copy report",
		ButtonText = "Copy",
		Callback = function()
			local text = formatWindowStats()
				.. "\n\n"
				.. formatLibraryStats()
				.. (latestReport and ("\n\n" .. formatTestReport(latestReport)) or "")
			local clipboard = getGlobal("setclipboard")
			if type(clipboard) == "function" then
				local ok = pcall(clipboard, text)
				self:Notify({
					Title = ok and "Report copied" or "Copy failed",
					Type = ok and "Success" or "Error",
				})
			else
				self:Notify({
					Title = "Clipboard unavailable",
					Content = "This executor does not expose setclipboard.",
					Type = "Warning",
				})
			end
		end,
	})
	windowStats:SetContent(formatWindowStats())
	libraryStats:SetContent(formatLibraryStats())
	return tab
end

