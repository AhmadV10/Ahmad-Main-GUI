			ZIndex = 100,
			Parent = frame,
		})
		self._resizeHandle = handle
		local isHovered = false
		local isResizing = false

		local clipper = Util.Create("Frame", {
			Name = "Clipper",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 101,
			Parent = handle,
		})

		local gripArc = Util.Create("Frame", {
			Name = "GripArc",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ZIndex = 102,
			Parent = clipper,
		})
		Util.Corner(gripArc, 99)
		local gripStroke = Util.Stroke(gripArc, theme.Text, theme.Dark and 0.22 or 0.12, 4.0)

		local function updateHandleVisuals()
			local expanded = isHovered or isResizing
			local targetTheme = self:GetTheme()
			local motion = self:GetMotion("Normal")
			local radius = targetTheme.RadiusWindow or 34

			-- Values for normal vs expanded
			local strokeThickness = expanded and 6.0 or 4.0
			local arcRadius = expanded and (radius - 5) or (radius - 9)
			local d = expanded and 2 or 4

			local strokeColor = targetTheme.Text
			local strokeTransparency = expanded and 0 or (targetTheme.Dark and 0.22 or 0.12)

			-- Clipper size and position
			local clipperSize = radius - d
			local clipperPos = -radius + d

			Util.Tween(clipper, motion, {
				Size = UDim2.fromOffset(clipperSize, clipperSize),
				Position = UDim2.new(1, clipperPos, 1, clipperPos),
			})

			local arcSize = math.max(arcRadius * 2, 4)
			Util.Tween(gripArc, motion, {
				Size = UDim2.fromOffset(arcSize, arcSize),
				Position = UDim2.new(0, -d, 0, -d),
			})

			Util.Tween(gripStroke, motion, {
				Thickness = strokeThickness,
				Color = strokeColor,
				Transparency = strokeTransparency,
			})
		end

		maid:Give(self:WatchTheme(function(nextTheme)
			gripStroke.Color = nextTheme.Text
			updateHandleVisuals()
		end))

		local resizing = false
		local resizeStart = Vector2.zero
		local sizeStart = Vector2.zero
		local positionStart = UDim2.zero
		local minimum = options.MinSize or Vector2.new(500, 340)
		local maximum = options.MaxSize or Vector2.new(1400, 900)

		maid:Give(handle.MouseEnter:Connect(function()
			isHovered = true
			updateHandleVisuals()
		end))
		maid:Give(handle.MouseLeave:Connect(function()
			isHovered = false
			updateHandleVisuals()
		end))

		maid:Give(handle.InputBegan:Connect(function(input)
			if not self._fullscreen and Util.IsPrimaryInput(input) then
				isResizing = true
				resizing = true
				resizeStart = input.Position
				sizeStart = frame.AbsoluteSize
				positionStart = frame.Position
				updateHandleVisuals()
			end
		end))
		maid:Give(UserInputService.InputChanged:Connect(function(input)
			if resizing and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then
				local delta = (input.Position - resizeStart) / self.Scale
				local nextSize = Vector2.new(
					math.clamp(sizeStart.X + delta.X, minimum.X, maximum.X),
					math.clamp(sizeStart.Y + delta.Y, minimum.Y, maximum.Y)
				)
				local dSize = nextSize - sizeStart
				frame.Size = UDim2.fromOffset(nextSize.X, nextSize.Y)
				frame.Position = UDim2.new(
					positionStart.X.Scale,
					positionStart.X.Offset + dSize.X / 2,
					positionStart.Y.Scale,
					positionStart.Y.Offset + dSize.Y / 2
				)
			end
		end))
		maid:Give(UserInputService.InputEnded:Connect(function(input)
			if Util.IsPrimaryInput(input) then
				resizing = false
				isResizing = false
				updateHandleVisuals()
				self:_queueNativePreferenceSave()
			end
		end))
	end

	self:_applyTheme()
	if not savedPreferences then
		self:_queueNativePreferenceSave()
	end

	pcall(function()
		game:BindToClose(function()
			if not self.Destroyed and self._preferenceEnabled and self._preferenceDirty then
				self:_saveNativePreferences()
			end
		end)
	end)

