function Themes.Patch(base, patch)
	local result = Util.Copy(base)
	for key, value in pairs(patch or {}) do
		if not lockedThemeTokens[key] and result[key] ~= nil and value ~= nil then
			local limits = themeNumberLimits[key]
			if limits and type(value) == "number" then
				result[key] = math.clamp(value, limits[1], limits[2])
			elseif typeof(value) == typeof(result[key]) then
				result[key] = value
			end
		end
	end
	return result
end

