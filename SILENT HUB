		body.Text = tostring(content)
	end
	function self:SetVisible(visible)
		root.Visible = visible == true
	end
	function self:Destroy()
		if self.Destroyed then
			return
		end
		self.Destroyed = true
		maid:Destroy()
	end
	return self
end

