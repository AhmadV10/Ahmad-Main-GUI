local ButtonControl = {}

function ButtonControl.new(context, parent, options)
	local self = BaseControl.new(context, parent, options, 64)
	self.Save = false
	self._loading = false
	self._buttonStyle = options.Style or "Default"
	self._buttonText = options.ButtonText or options.Value or ""
	self._callback = options.Callback

	local theme = context:GetTheme()
	local action = Util.Create("TextButton", {
		Name = "Action",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		Text = self._buttonText,
		TextColor3 = theme.Text,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 100, 0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = self.Content,
	})
	Util.Corner(action, theme.RadiusSmall)
	Util.Padding(action, 0, 16, 0, 16)
	local stroke = Util.Stroke(action, theme.Border, 0.78, 1)
	stroke.Name = "GlassStroke"
	styleGlass(action, theme, context.Quality, nil, "Inset")
	local actionLabel = Util.Create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Font = action.Font,
		Text = self._buttonText,
		TextColor3 = theme.Dark and Color3.new(1, 1, 1) or theme.Text,
		TextSize = action.TextSize,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = action.ZIndex + 2,
		Parent = action,
	})
	action.TextTransparency = 1
	Util.BindFocusRing(action, function() return context:GetTheme() end, self._maid)

	local hovering = false
	local pressing = false

	local function render(nextTheme, animate)
		local foreground = nextTheme.Dark and Color3.new(1, 1, 1) or nextTheme.Text
		local bg = nextTheme.Control
		local strokeColor = nextTheme.Accent
		
		if self._buttonStyle == "Danger" then
			bg = nextTheme.Danger
			foreground = Color3.new(1, 1, 1)
			strokeColor = nextTheme.Danger
		elseif self._buttonStyle == "Accent" then
			bg = nextTheme.Accent
			foreground = nextTheme.AccentText or Color3.new(1, 1, 1)
			strokeColor = nextTheme.Accent
		end
		
		action.Font = nextTheme.FontNormal or Enum.Font.Gotham
		action.TextSize = (nextTheme.TextSizeOffset or 0) + 14
		actionLabel.Font = action.Font
		actionLabel.TextSize = action.TextSize

		local materialTint = self._buttonStyle == "Default" and nil or bg
		styleGlass(action, nextTheme, context.Quality, nil, "Inset", materialTint)
		local surface = action:FindFirstChild("GlassSurface")
		if surface then
			local baseTransparency = self._buttonStyle == "Default"
					and (nextTheme.Dark and 0.16 or 0.24)
				or (nextTheme.Dark and 0.08 or 0.14)
			local interactionOffset = pressing and 0.12 or hovering and -0.06 or 0
			local surfaceTransparency = math.clamp(baseTransparency + interactionOffset, 0, 1)
			if animate then
				Util.Tween(surface, context:GetMotion("Fast"), {
					BackgroundTransparency = surfaceTransparency,
				})
			else
				surface.BackgroundTransparency = surfaceTransparency
			end
		end
		actionLabel.TextColor3 = foreground
		stroke.Color = strokeColor
		stroke.Transparency = 0
	end

	self._renderControl = render
	self._maid:Give(action.MouseEnter:Connect(function()
		hovering = true
		render(context:GetTheme(), true)
	end))
	self._maid:Give(action.MouseLeave:Connect(function()
		hovering = false
		pressing = false
		render(context:GetTheme(), true)
	end))
	self._maid:Give(action.MouseButton1Down:Connect(function()
		if self.Disabled or self._loading then
			return
		end
		pressing = true
		render(context:GetTheme(), true)
	end))
	self._maid:Give(action.MouseButton1Up:Connect(function()
		pressing = false
		render(context:GetTheme(), true)
	end))
	self._maid:Give(action.Activated:Connect(function()
		if not self.Disabled and not self._loading then
			Util.SafeCall(self._callback)
		end
	end))

	function self:Fire()
		if not self.Disabled and not self._loading then
			Util.SafeCall(self._callback)
		end
	end

	function self:SetText(value)
		self._buttonText = tostring(value or "")
		if not self._loading then
			action.Text = self._buttonText
			actionLabel.Text = self._buttonText
		end
	end

	function self:SetStyle(style)
		assert(
			style == "Default" or style == "Accent" or style == "Danger",
			"Button style must be Default, Accent or Danger"
		)
		self._buttonStyle = style
		render(context:GetTheme(), true)
	end

	function self:SetLoading(loading, text)
		self._loading = loading == true
		local displayText = self._loading and (text or "Loading...") or self._buttonText
		action.Text = displayText
		actionLabel.Text = displayText
		actionLabel.TextTransparency = self._loading and 0.18 or 0
		render(context:GetTheme(), true)
	end

	function self:IsLoading()
		return self._loading
	end

	render(theme, false)
	return self
end

