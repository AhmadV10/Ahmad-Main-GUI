function Window:AttachTooltip(target, options)
	assert(typeof(target) == "Instance" and target:IsA("GuiObject"), "Tooltip target must be a GuiObject")
	options = type(options) == "string" and { Text = options } or options or {}
	local maid = Maid.new()
	local showThread
	local moveConnection
	local tooltip

	local function destroyTooltip()
		if showThread then
			task.cancel(showThread)
			showThread = nil
		end
		if moveConnection then
			moveConnection:Disconnect()
			moveConnection = nil
		end
		if tooltip then
			tooltip:Destroy()
			tooltip = nil
		end
	end

	local function positionTooltip(inputPosition)
		if not tooltip then
			return
		end
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
		local width = tooltip.AbsoluteSize.X
		local height = tooltip.AbsoluteSize.Y
		local x = math.clamp(inputPosition.X + 14, 8, math.max(8, viewport.X - width - 8))
		local y = math.clamp(inputPosition.Y + 16, 8, math.max(8, viewport.Y - height - 8))
		tooltip.Position = UDim2.fromOffset(x, y)
	end

	local function showTooltip()
		if self.Destroyed or tooltip then
			return
		end
		local theme = self:GetTheme()
		tooltip = Util.Create("TextLabel", {
			Name = "Tooltip",
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundColor3 = theme.SurfaceOverlay,
			BackgroundTransparency = 0.04,
			BorderSizePixel = 0,
			Font = theme.FontNormal or Enum.Font.Gotham,
			Text = tostring(options.Text or ""),
			TextColor3 = theme.Text,
			TextSize = (theme.TextSizeOffset or 0) + 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromOffset(0, 0),
			ZIndex = 500,
			Parent = self.Root,
		})
		tooltip.TextWrapped = true
		tooltip.AutomaticSize = Enum.AutomaticSize.Y
		tooltip.Size = UDim2.fromOffset(tonumber(options.Width) or 220, 0)
		Util.Corner(tooltip, theme.RadiusSmall)
		Util.Stroke(tooltip, theme.Border, 0.38, 1)
		Util.Padding(tooltip, 8, 10, 8, 10)
		positionTooltip(UserInputService:GetMouseLocation())
		moveConnection = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				positionTooltip(input.Position)
			end
		end)
	end

	maid:Give(target.MouseEnter:Connect(function()
		destroyTooltip()
		showThread = task.delay(math.max(tonumber(options.Delay) or 0.35, 0), function()
			showThread = nil
			showTooltip()
		end)
	end))
	maid:Give(target.MouseLeave:Connect(destroyTooltip))
	maid:Give(target.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			destroyTooltip()
		end
	end))
	maid:Give(destroyTooltip)
	return maid
end

function Window:SearchControls(query)
	query = string.lower(tostring(query or ""))
	query = query:gsub("^%s+", ""):gsub("%s+$", "")
	local matches = 0

	for _, control in pairs(self._controls) do
		if control.Root and control.Root.Parent then
			local title = control.TitleLabel and control.TitleLabel.Text or control.Id
			local description = control.DescriptionLabel and control.DescriptionLabel.Text or ""
			local searchable = string.lower(tostring(title) .. " " .. tostring(description) .. " " .. tostring(control.Id))
			local matched = query == "" or string.find(searchable, query, 1, true) ~= nil
			control.Root.Visible = matched and control.Visible ~= false
			if matched then
				matches += 1
			end
		end
	end
	for _, tab in ipairs(self._tabs) do
		for _, section in ipairs(tab._sections) do
			for _, control in ipairs(section._controls) do
				if control.Standalone and control.DescriptionLabel and control.Root then
					local searchable = string.lower(
						tostring(control.DescriptionLabel.Text) .. " " .. tostring(control.Id)
					)
					local matched = query == "" or string.find(searchable, query, 1, true) ~= nil
					control.Root.Visible = matched and control.Visible ~= false
					if matched then
						matches += 1
					end
				end
			end
			if query == "" then
				section.Root.Visible = section.Visible ~= false
			else
				local anyVisible = false
				for _, control in ipairs(section._controls) do
					if control.Root and control.Root.Visible then
						anyVisible = true
						break
					end
				end
				section.Root.Visible = anyVisible
			end
		end
	end
	return matches
end

