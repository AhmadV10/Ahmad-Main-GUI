-- Persistent list ------------------------------------------------------------

local ListControl = {}

local function normalizeListItems(items)
	local normalized = {}
	for _, item in ipairs(items or {}) do
		if type(item) == "string" then
			table.insert(normalized, {
				Id = item,
				Title = item,
			})
		elseif type(item) == "table" and type(item.Id) == "string" then
			table.insert(normalized, {
				Id = item.Id,
				Title = item.Title or item.Id,
				Description = item.Description,
				Icon = item.Icon,
				Disabled = item.Disabled == true,
			})
		end
	end
	return normalized
end

function ListControl.new(context, parent, options)
	local items = normalizeListItems(options.Items or options.Options)
	local multi = options.Multi == true
	local default
	if multi then
		default = Util.DeepCopy(options.DefaultMulti or options.Default or {})
	else
		default = options.Default or (items[1] and items[1].Id or "")
	end

	local rowHeight = math.max(tonumber(options.RowHeight) or 42, 32)
	local visibleRows = math.clamp(tonumber(options.VisibleRows) or 4, 1, 10)
	local headerHeight = 32
	local totalHeight = headerHeight + rowHeight * visibleRows + 16
	local self = BaseControl.new(context, parent, options, totalHeight)
	self._default = default
	self._value = Util.DeepCopy(default)
	self._callback = options.OnChanged

	self.TitleLabel.Size = UDim2.new(1, 0, 0, 22)

	local theme = context:GetTheme()
	local list = Util.Create("ScrollingFrame", {
		Name = "List",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarImageColor3 = theme.TextMuted,
		ScrollBarThickness = 3,
		Position = UDim2.fromOffset(0, headerHeight),
		Size = UDim2.new(1, 0, 1, -headerHeight - 10),
		Parent = self.Content,
	})
	Util.Corner(list, theme.RadiusSmall)
	Util.Padding(list, 4)
	Util.List(list, 2)
	local listStroke = Util.Stroke(list, theme.Border, 0.62, 1)
	listStroke.Name = "GlassStroke"
	styleGlass(list, theme, context.Quality, nil, "Inset")
	local rows = {}
	local rowMaid = Maid.new()
	self._maid:Set("ListRows", rowMaid)

	local function selected(id)
		if multi then
			return table.find(self._value, id) ~= nil
		end
		return self._value == id
	end

	local function fireValue(silent)
		if not silent then
			local value = Util.DeepCopy(self._value)
			self.Changed:Fire(value)
			Util.SafeCall(self._callback, value)
		end
	end

	local function render(nextTheme, animate)
		styleGlass(list, nextTheme, context.Quality, nil, "Inset")
		list.ScrollBarImageColor3 = nextTheme.TextMuted
		for id, row in pairs(rows) do
			local isSelected = selected(id)
			local item
			for _, candidate in ipairs(items) do
				if candidate.Id == id then
					item = candidate
					break
				end
			end
			local background = isSelected and nextTheme.Accent or nextTheme.SurfaceRaised
			local foreground = isSelected and nextTheme.AccentText
				or (item and item.Disabled and nextTheme.TextDisabled or nextTheme.Text)
			local properties = {
				BackgroundColor3 = background,
				BackgroundTransparency = isSelected and 0.16 or 0.34,
			}
			if animate then
				Util.Tween(row, context:GetMotion("Fast"), properties)
			else
				for property, value in pairs(properties) do
					row[property] = value
				end
			end
			local title = row:FindFirstChild("Title")
			local description = row:FindFirstChild("Description")
			local icon = row:FindFirstChild("Icon")
			if title then
				title.TextColor3 = foreground
				title.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
				title.TextSize = (nextTheme.TextSizeOffset or 0) + 12
			end
			if description then
				description.TextColor3 = isSelected and nextTheme.AccentText or nextTheme.TextMuted
				description.Font = nextTheme.FontNormal or Enum.Font.Gotham
				description.TextSize = (nextTheme.TextSizeOffset or 0) + 10
			end
			if icon and icon:IsA("ImageLabel") then
				icon.ImageColor3 = foreground
			end
		end
	end
	self._renderControl = render

	local function buildRows()
		rowMaid:Destroy()
		rowMaid = Maid.new()
		self._maid:Set("ListRows", rowMaid)
		for _, row in pairs(rows) do
			row:Destroy()
		end
		table.clear(rows)

		for index, item in ipairs(items) do
			local row = Util.Create("TextButton", {
				Name = item.Id,
				AutoButtonColor = false,
				BackgroundColor3 = theme.SurfaceRaised,
				BackgroundTransparency = 0.28,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Text = "",
				Size = UDim2.new(1, 0, 0, rowHeight),
				Parent = list,
			})
			Util.Corner(row, math.max(theme.RadiusSmall - 2, 0))
			local left = item.Icon and 38 or 10
			if item.Icon then
				Util.Create("ImageLabel", {
					Name = "Icon",
					BackgroundTransparency = 1,
					Image = iconAsset(item.Icon),
					ImageColor3 = theme.Icon,
					Position = UDim2.fromOffset(10, math.floor((rowHeight - 20) / 2)),
					Size = UDim2.fromOffset(20, 20),
					Parent = row,
				})
			end
			Util.Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				Text = item.Title,
				TextColor3 = item.Disabled and theme.TextDisabled or theme.Text,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(left, item.Description and 5 or 0),
				Size = UDim2.new(1, -left - 10, item.Description and 0.5 or 1, 0),
				Parent = row,
			})
			if item.Description then
				Util.Create("TextLabel", {
					Name = "Description",
					BackgroundTransparency = 1,
					Font = Enum.Font.Gotham,
					Text = item.Description,
					TextColor3 = theme.TextMuted,
					TextSize = 10,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, left, 0.5, 0),
					Size = UDim2.new(1, -left - 10, 0.5, -4),
					Parent = row,
				})
			end
			rows[item.Id] = row
			rowMaid:Give(row.Activated:Connect(function()
				if self.Disabled or item.Disabled then
					return
				end
				if multi then
					local nextValue = table.clone(self._value)
					local found = table.find(nextValue, item.Id)
					if found then
						table.remove(nextValue, found)
					else
						table.insert(nextValue, item.Id)
					end
					self._value = nextValue
				else
					self._value = item.Id
				end
				render(context:GetTheme(), true)
				fireValue(false)
			end))
		end
		render(context:GetTheme(), false)
	end

	function self:SetValue(value, silent)
		local nextValue
		if multi then
			if type(value) ~= "table" then
				return
			end
			nextValue = {}
			for _, id in ipairs(value) do
				for _, item in ipairs(items) do
					if id == item.Id and not table.find(nextValue, id) then
						table.insert(nextValue, id)
						break
					end
				end
			end
		else
			if type(value) ~= "string" then
				return
			end
			local valid = false
			for _, item in ipairs(items) do
				if item.Id == value then
					valid = true
					break
				end
			end
			if not valid then
				return
			end
			nextValue = value
		end
		self._value = nextValue
		render(context:GetTheme(), true)
		fireValue(silent)
	end

	function self:SetItems(nextItems, preserveValue)
		items = normalizeListItems(nextItems)
		if not preserveValue then
			self._value = multi and {} or (items[1] and items[1].Id or "")
		end
		buildRows()
	end

	function self:AddItem(item)
		local normalized = normalizeListItems({ item })[1]
		if not normalized then
			return false
		end
		for _, existing in ipairs(items) do
			if existing.Id == normalized.Id then
				return false
			end
		end
		table.insert(items, normalized)
		buildRows()
		return true
	end

	function self:RemoveItem(id)
		for index, item in ipairs(items) do
			if item.Id == id then
				table.remove(items, index)
				if multi then
					local selectedIndex = table.find(self._value, id)
					if selectedIndex then
						table.remove(self._value, selectedIndex)
					end
				elseif self._value == id then
					self._value = items[1] and items[1].Id or ""
				end
				buildRows()
				return true
			end
		end
		return false
	end

	function self:GetItems()
		return Util.DeepCopy(items)
	end

	buildRows()
	return self
end

