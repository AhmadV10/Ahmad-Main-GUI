function Window:Destroy()
	if self.Destroyed then
		return
	end
	if self._configManager then
		self._configManager:Destroy()
		self._configManager = nil
	end
	local controls = {}
	for _, control in pairs(self._controls) do
		table.insert(controls, control)
	end
	for _, control in ipairs(controls) do
		if not control.Destroyed and type(control.GetValue) == "function" then
			local value = control:GetValue()
			if type(value) == "boolean" and value == true
				and type(control.SetValue) == "function" then
				control:SetValue(false, false)
			elseif type(control.Reset) == "function" then
				control:Reset(true)
			end
		end
	end
	self.Destroying:Fire(self)
	if self._qualityCalibration then
		self._qualityCalibration:Destroy()
		self._qualityCalibration = nil
	end
	if self._preferenceEnabled and self._preferenceDirty then
		self:_saveNativePreferences()
	end
	self.Destroyed = true
	for _, tab in ipairs(self._tabs) do
		tab:Destroy()
	end
	table.clear(self._tabs)
	table.clear(self._tabById)
	table.clear(self._controls)
	table.clear(self._themeListeners)
	self._appearanceSync = nil
	for _, dialog in ipairs(table.clone(self._dialogs)) do
		dialog:Destroy()
	end
	table.clear(self._dialogs)
	self._maid:Destroy()
	if SilenceUI.Windows[self.Id] == self then
		SilenceUI.Windows[self.Id] = nil
	end
	runtimeRegistry.Windows[self] = nil
	Util.SafeCall(self._options.OnDestroy, self)
end

-- Config serialization -------------------------------------------------------

local Serializer = {}

function Serializer.EncodeValue(value, visited)
	local kind = typeof(value)
	if kind == "nil" or kind == "boolean" or kind == "number" or kind == "string" then
		return value
	elseif kind == "Color3" then
		return {
			__type = "Color3",
			R = value.R,
			G = value.G,
			B = value.B,
		}
	elseif kind == "Vector2" then
		return {
			__type = "Vector2",
			X = value.X,
			Y = value.Y,
		}
	elseif kind == "UDim" then
		return {
			__type = "UDim",
			Scale = value.Scale,
			Offset = value.Offset,
		}
	elseif kind == "UDim2" then
		return {
			__type = "UDim2",
			XScale = value.X.Scale,
			XOffset = value.X.Offset,
			YScale = value.Y.Scale,
			YOffset = value.Y.Offset,
		}
	elseif kind == "EnumItem" then
		return {
			__type = "EnumItem",
			Enum = tostring(value.EnumType):gsub("^Enum%.", ""),
			Name = value.Name,
		}
	elseif kind == "table" then
		visited = visited or {}
		if visited[value] then
			error("Cannot serialize cyclic tables")
		end
		visited[value] = true
		local output = {}
		for key, nested in pairs(value) do
			if type(key) ~= "string" and type(key) ~= "number" then
				error("Config table keys must be strings or numbers")
			end
			output[key] = Serializer.EncodeValue(nested, visited)
		end
		visited[value] = nil
		return output
	end
	error("Unsupported config value: " .. kind)
end

function Serializer.DecodeValue(value)
	if type(value) ~= "table" then
		return value
	end
	if value.__type == "Color3" then
		return Color3.new(value.R or 0, value.G or 0, value.B or 0)
	elseif value.__type == "Vector2" then
		return Vector2.new(value.X or 0, value.Y or 0)
	elseif value.__type == "UDim" then
		return UDim.new(value.Scale or 0, value.Offset or 0)
	elseif value.__type == "UDim2" then
		return UDim2.new(
			value.XScale or 0,
			value.XOffset or 0,
			value.YScale or 0,
			value.YOffset or 0
		)
	elseif value.__type == "EnumItem" then
		local enumType = Enum[value.Enum]
		return enumType and enumType[value.Name] or nil
	end
	local output = {}
	for key, nested in pairs(value) do
		output[key] = Serializer.DecodeValue(nested)
	end
	return output
end

function Serializer.Encode(value)
	return HttpService:JSONEncode(Serializer.EncodeValue(value))
end

function Serializer.Decode(value)
	local decoded = HttpService:JSONDecode(value)
	return Serializer.DecodeValue(decoded)
end

-- Storage adapters -----------------------------------------------------------

local MemoryStorage = {}
MemoryStorage.__index = MemoryStorage

function MemoryStorage.new()
	return setmetatable({
		_files = {},
	}, MemoryStorage)
end

function MemoryStorage:Write(name, content)
	self._files[name] = content
	return true
end

function MemoryStorage:Read(name)
	return self._files[name]
end

function MemoryStorage:Delete(name)
	self._files[name] = nil
	return true
end

function MemoryStorage:Exists(name)
	return self._files[name] ~= nil
end

function MemoryStorage:List()
	local result = {}
	for name in pairs(self._files) do
		table.insert(result, name)
	end
	table.sort(result)
	return result
end

local FileStorage = {}
FileStorage.__index = FileStorage

local function sanitizePathPart(value)
	return tostring(value)
		:gsub("[<>:\"/\\|%?%*]", "_")
		:gsub("%.%.", "_")
		:gsub("^%s+", "")
		:gsub("%s+$", "")
end

local function normalizeConfigName(value)
	if type(value) ~= "string" then
		return nil
	end
	local name = sanitizePathPart(value)
	if name == "" or name == "." or name == "_" then
		return nil
	end
	return name
end

function FileStorage.IsSupported()
	return type(getGlobal("writefile")) == "function"
		and type(getGlobal("readfile")) == "function"
		and type(getGlobal("isfile")) == "function"
end

function FileStorage.new(folder)
	local self = setmetatable({
		Folder = sanitizePathPart(folder or "SilenceUI"),
		_writefile = getGlobal("writefile"),
		_readfile = getGlobal("readfile"),
		_isfile = getGlobal("isfile"),
		_delfile = getGlobal("delfile"),
		_listfiles = getGlobal("listfiles"),
		_isfolder = getGlobal("isfolder"),
		_makefolder = getGlobal("makefolder"),
	}, FileStorage)
	self:_ensureFolder()
	return self
end

function FileStorage:_ensureFolder()
	if type(self._makefolder) ~= "function" then
		return
	end
	local exists = false
	if type(self._isfolder) == "function" then
		local ok, result = pcall(self._isfolder, self.Folder)
		exists = ok and result
	end
	if not exists then
		pcall(self._makefolder, self.Folder)
	end
end

function FileStorage:_path(name)
	return self.Folder .. "/" .. sanitizePathPart(name) .. ".json"
end

function FileStorage:Write(name, content)
	self:_ensureFolder()
	local ok, message = pcall(self._writefile, self:_path(name), content)
	return ok, message
end

function FileStorage:Read(name)
	local path = self:_path(name)
	local existsOk, exists = pcall(self._isfile, path)
	if not existsOk or not exists then
		return nil
	end
	local ok, content = pcall(self._readfile, path)
	return ok and content or nil
end

function FileStorage:Delete(name)
	if type(self._delfile) ~= "function" then
		return false, "delfile is unavailable"
	end
	local path = self:_path(name)
	local existsOk, exists = pcall(self._isfile, path)
	if existsOk and exists then
		return pcall(self._delfile, path)
	end
	return true
end

function FileStorage:Exists(name)
	local ok, exists = pcall(self._isfile, self:_path(name))
	return ok and exists
end

function FileStorage:List()
	if type(self._listfiles) ~= "function" then
		return {}
	end
	local ok, files = pcall(self._listfiles, self.Folder)
	if not ok or type(files) ~= "table" then
		return {}
	end
	local result = {}
	for _, path in ipairs(files) do
		local normalized = tostring(path):gsub("\\", "/")
		local name = normalized:match("([^/]+)%.json$")
		if name then
			table.insert(result, name)
		end
	end
	table.sort(result)
	return result
end

SilenceUI.Storage = {
	Memory = MemoryStorage,
	File = FileStorage,
}

-- Config manager -------------------------------------------------------------

local ConfigManager = {}
ConfigManager.__index = ConfigManager

function ConfigManager.new(window, options)
	options = options or {}
	local storage = options.Storage
	if not storage then
		storage = FileStorage.IsSupported()
			and FileStorage.new(options.Folder or "SilenceConfig")
			or MemoryStorage.new()
	end
	local defaultName = options.DefaultName or (window.Id .. "Config")

	local self = setmetatable({
		Window = window,
		Storage = storage,
		SchemaVersion = 1,
		DefaultName = defaultName,
		AutoSave = options.AutoSave ~= false,
		AutoLoad = options.AutoLoad ~= false,
		AutoSaveDelay = math.max(tonumber(options.AutoSaveDelay) or 0.8, 0.1),
		SaveTheme = options.SaveTheme == true,
		SaveWindow = options.SaveWindow == true,
		Changed = Signal.new(),
		Saved = Signal.new(),
		Loaded = Signal.new(),
		Error = Signal.new(),
		_destroyed = false,
		_autoSaveThread = nil,
		_currentName = defaultName,
		_pendingControls = {},
		_maid = Maid.new(),
	}, ConfigManager)

	self._maid:Give(self.Changed)
	self._maid:Give(self.Saved)
	self._maid:Give(self.Loaded)
	self._maid:Give(self.Error)
	self._maid:Give(window.ControlChanged:Connect(function(_, _, control)
		if control and control.Save == false then
			return
		end
		self.Changed:Fire()
		if self.AutoSave then
			self:_queueAutoSave()
		end
	end))
	self._maid:Give(window.ThemeChanged:Connect(function()
		if self.AutoSave and self.SaveTheme then
			self:_queueAutoSave()
		end
	end))
	if self.AutoLoad then
		task.defer(function()
			if not self._destroyed and self:Exists(self._currentName) then
				self:Load(self._currentName)
			end
		end)
	end

	pcall(function()
		game:BindToClose(function()
			if not self._destroyed and self.AutoSave and self._autoSaveThread then
				self:Save(self._currentName)
			end
		end)
	end)

	return self
end

function ConfigManager:_emitError(message)
	warn("[SilenceUI Config] " .. tostring(message))
	self.Error:Fire(tostring(message))
	return false, tostring(message)
end

function ConfigManager:_queueAutoSave()
	if self._autoSaveThread then
		task.cancel(self._autoSaveThread)
	end
	self._autoSaveThread = task.delay(self.AutoSaveDelay, function()
		self._autoSaveThread = nil
		if not self._destroyed then
			self:Save(self._currentName)
		end
	end)
end

function ConfigManager:Capture()
	local controls = {}
	for id, control in pairs(self.Window._controls) do
		if control.Save ~= false and type(control.GetValue) == "function" then
			local ok, value = pcall(control.GetValue, control)
			if ok then
				controls[id] = value
			end
		end
	end

	local data = {
		SchemaVersion = self.SchemaVersion,
		LibraryVersion = SilenceUI.Version,
		Timestamp = os.time(),
		Controls = controls,
	}
	if self.SaveTheme then
		data.Theme = Util.Copy(self.Window:GetTheme())
		data.Quality = self.Window.RequestedQuality
		data.Scale = self.Window.Scale
		data.ReducedMotion = self.Window.ReducedMotion
	end
	if self.SaveWindow then
		data.Window = {
			Position = self.Window.Frame.Position,
			Size = self.Window.Frame.Size,
			SelectedTab = self.Window:GetSelectedTab(),
		}
	end
	return data
end

function ConfigManager:Apply(data, silent)
	if type(data) ~= "table" then
		return self:_emitError("Config root must be a table")
	end
	if tonumber(data.SchemaVersion) ~= self.SchemaVersion then
		data = self:Migrate(data)
		if not data then
			return self:_emitError("Unsupported config schema")
		end
	end

	if self.SaveTheme and type(data.Theme) == "table" then
		self.Window:SetTheme(data.Theme)
	end
	if self.SaveTheme and data.Quality then
		self.Window:SetQuality(data.Quality)
	end
	if self.SaveTheme and type(data.Scale) == "number" then
		self.Window:SetScale(data.Scale)
	end
	if self.SaveTheme and type(data.ReducedMotion) == "boolean" then
		self.Window:SetReducedMotion(data.ReducedMotion)
	end
	if self.SaveWindow and type(data.Window) == "table" then
		if typeof(data.Window.Position) == "UDim2" then
			self.Window.Frame.Position = data.Window.Position
		end
		if typeof(data.Window.Size) == "UDim2" then
			self.Window.Frame.Size = data.Window.Size
		end
		if type(data.Window.SelectedTab) == "string" then
			self.Window:SelectTab(data.Window.SelectedTab)
		end
	end

	if type(data.Controls) == "table" then
		for id, value in pairs(data.Controls) do
			local control = self.Window._controls[id]
			if control and control.Save ~= false and type(control.SetValue) == "function" then
				local ok, message = pcall(control.SetValue, control, value, silent ~= false)
				if not ok then
					warn("[SilenceUI Config] Failed to restore", id, message)
				end
			else
				self._pendingControls[id] = Util.DeepCopy(value)
			end
		end
	end
	return true
end

function ConfigManager:RestoreControl(control)
	if self._destroyed or not control or control.Save == false
		or type(control.SetValue) ~= "function" then
		return false
	end
	local value = self._pendingControls[control.Id]
	if value == nil then
		return false
	end
	self._pendingControls[control.Id] = nil
	local ok, message = pcall(control.SetValue, control, Util.DeepCopy(value), true)
	if not ok then
		warn("[SilenceUI Config] Failed to restore", control.Id, message)
		return false
	end
	return true
end

function ConfigManager:Migrate(data)
	-- Future schema migrations are chained here.
	if data.SchemaVersion == nil then
		data.SchemaVersion = 1
		return data
	end
	return nil
end

function ConfigManager:Save(name)
	if self._destroyed then
		return self:_emitError("Config manager is destroyed")
	end
	name = normalizeConfigName(name or self._currentName)
	if not name then
		return self:_emitError("Config name is empty")
	end
	local captureOk, data = pcall(self.Capture, self)
	if not captureOk then
		return self:_emitError(data)
	end
	local encodeOk, encoded = pcall(Serializer.Encode, data)
	if not encodeOk then
		return self:_emitError(encoded)
	end
	local writeOk, success, message = pcall(self.Storage.Write, self.Storage, name, encoded)
	if not writeOk or success == false then
		return self:_emitError(message or success)
	end
	self._currentName = name
	self.Saved:Fire(name, data)
	return true
end

function ConfigManager:Load(name)
	if self._destroyed then
		return self:_emitError("Config manager is destroyed")
	end
	name = normalizeConfigName(name or self._currentName)
	if not name then
		return self:_emitError("Select a config to load")
	end
	local readOk, content = pcall(self.Storage.Read, self.Storage, name)
	if not readOk or type(content) ~= "string" then
		return self:_emitError("Config not found: " .. name)
	end
	local decodeOk, data = pcall(Serializer.Decode, content)
	if not decodeOk then
		return self:_emitError(data)
	end
	local applyOk, message = self:Apply(data, true)
	if not applyOk then
		return false, message
	end
	self._currentName = name
	self.Loaded:Fire(name, data)
	return true
end

function ConfigManager:Delete(name)
	name = normalizeConfigName(name or self._currentName)
	if not name then
		return self:_emitError("Select a config to delete")
	end
	local ok, success, message = pcall(self.Storage.Delete, self.Storage, name)
	if not ok or success == false then
		return self:_emitError(message or success)
	end
	return true
end

function ConfigManager:Rename(oldName, newName)
	oldName = normalizeConfigName(oldName)
	newName = normalizeConfigName(newName)
	if not oldName then
		return self:_emitError("Select a config to rename")
	end
	if not newName then
		return self:_emitError("Enter a valid new config name")
	end
	if oldName == newName then
		return true
	end
	local content = self.Storage:Read(oldName)
	if type(content) ~= "string" then
		return self:_emitError("Config not found: " .. oldName)
	end
	local success, message = self.Storage:Write(newName, content)
	if success == false then
		return self:_emitError(message)
	end
	self.Storage:Delete(oldName)
	if self._currentName == oldName then
		self._currentName = newName
	end
	return true
end

function ConfigManager:Duplicate(sourceName, targetName)
	sourceName = normalizeConfigName(sourceName)
	targetName = normalizeConfigName(targetName)
	if not sourceName then
		return self:_emitError("Select a config to duplicate")
	end
	if not targetName then
		return self:_emitError("Enter a valid target config name")
	end
	if self:Exists(targetName) then
		return self:_emitError("Config already exists: " .. targetName)
	end
	local content = self.Storage:Read(sourceName)
	if type(content) ~= "string" then
		return self:_emitError("Config not found: " .. sourceName)
	end
	local success, message = self.Storage:Write(targetName, content)
	if success == false then
		return self:_emitError(message)
	end
	return true
end

function ConfigManager:List()
	local ok, result = pcall(self.Storage.List, self.Storage)
	if not ok or type(result) ~= "table" then
		return {}
	end
	local filtered = {}
	for _, name in ipairs(result) do
		if name ~= NativePreferences.FileName then
			table.insert(filtered, name)
		end
	end
	return filtered
end

function ConfigManager:Exists(name)
	name = normalizeConfigName(name or self._currentName)
	if not name then
		return false
	end
	local ok, result = pcall(self.Storage.Exists, self.Storage, name)
	return ok and result == true
end

function ConfigManager:Create(name)
	name = normalizeConfigName(name)
	if not name then
		return self:_emitError("Config name is empty")
	end
	if self:Exists(name) then
		return self:_emitError("Config already exists: " .. name)
	end
	return self:Save(name)
end

function ConfigManager:SetCurrentName(name)
	name = normalizeConfigName(name)
	if not name then
		return false, "Config name is empty"
	end
	self._currentName = name
	return true
end

function ConfigManager:ResetControls(silent)
	for _, control in pairs(self.Window._controls) do
		if control.Save ~= false and type(control.Reset) == "function" then
			local ok, message = pcall(control.Reset, control, silent ~= false)
			if not ok then
				warn("[SilenceUI Config] Failed to reset", control.Id, message)
			end
		end
	end
end

function ConfigManager:Export()
	local ok, result = pcall(Serializer.Encode, self:Capture())
	if not ok then
		self:_emitError(result)
		return nil
	end
	return result
end

function ConfigManager:Import(content, applyNow)
	local ok, data = pcall(Serializer.Decode, content)
	if not ok then
		return self:_emitError(data)
	end
	if applyNow ~= false then
		return self:Apply(data, true)
	end
	return data
end

function ConfigManager:SetAutoSave(enabled)
	self.AutoSave = enabled == true
	if not self.AutoSave and self._autoSaveThread then
		task.cancel(self._autoSaveThread)
		self._autoSaveThread = nil
	end
end

function ConfigManager:GetCurrentName()
	return self._currentName
end

function ConfigManager:Destroy()
	if self._destroyed then
		return
	end
	if self.AutoSave then
		self:Save(self._currentName)
	end
	self._destroyed = true
	if self._autoSaveThread then
		task.cancel(self._autoSaveThread)
		self._autoSaveThread = nil
	end
	self._maid:Destroy()
end

function Window:CreateConfigManager(options)
	if self._configManager then
		return self._configManager
	end
	self._configManager = ConfigManager.new(self, options)
	return self._configManager
end

function Window:GetConfigManager()
	return self._configManager
end

