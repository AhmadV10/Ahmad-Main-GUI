	})
	Util.Corner(hueCursor, 4)
	Util.Stroke(hueCursor, Color3.new(0, 0, 0), 0.2, 1)

	local alpha
	local alphaCursor
	if options.AllowAlpha then
		alpha = Util.Create("ImageButton", {
			Name = "Alpha",
			AutoButtonColor = false,
			BackgroundColor3 = self._value,
			BorderSizePixel = 0,
			Image = "",
			Position = UDim2.fromOffset(0, 166),
			Size = UDim2.new(1, 0, 0, 16),
			ZIndex = 61,
			Parent = popup,
		})
