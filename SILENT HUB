function Util.Tween(object, duration, properties, style, direction)
	if duration <= 0 then
		for property, value in pairs(properties) do
			object[property] = value
		end
		return nil
	end

	local tween = TweenService:Create(
		object,
		TweenInfo.new(
			duration,
			style or Enum.EasingStyle.Quint,
			direction or Enum.EasingDirection.Out
		),
		properties
	)
	tween:Play()
	return tween
end

function Util.SafeCall(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local arguments = table.pack(...)
	task.spawn(function()
		local ok, message = xpcall(function()
			callback(table.unpack(arguments, 1, arguments.n))
		end, debug.traceback)
		if not ok then
			warn("[SilenceUI] Callback failed:\n" .. tostring(message))
		end
	end)
end

function Util.Copy(source)
	local output = {}
	for key, value in pairs(source) do
		output[key] = value
	end
	return output
end

function Util.DeepCopy(source, visited)
	if type(source) ~= "table" then
		return source
	end
	visited = visited or {}
	if visited[source] then
		return visited[source]
	end
	local output = {}
	visited[source] = output
	for key, value in pairs(source) do
		output[Util.DeepCopy(key, visited)] = Util.DeepCopy(value, visited)
	end
	return output
end

function Util.Round(value, step)
	if step <= 0 then
		return value
	end
	local inverse = 1 / step
	return math.round(value * inverse) / inverse
end

function Util.ColorToHex(color)
	return string.format(
		"#%02X%02X%02X",
		math.round(color.R * 255),
		math.round(color.G * 255),
		math.round(color.B * 255)
	)
end

function Util.HexToColor(value)
	if type(value) ~= "string" then
		return nil
	end
	local clean = value:gsub("#", "")
	if #clean ~= 6 or clean:find("[^%x]") then
		return nil
	end
	local red = tonumber(clean:sub(1, 2), 16)
	local green = tonumber(clean:sub(3, 4), 16)
	local blue = tonumber(clean:sub(5, 6), 16)
	if not red or not green or not blue then
		return nil
	end
	return Color3.fromRGB(red, green, blue)
end

function Util.IsPrimaryInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

function Util.PositionPopup(popup, target, scale, gap, margin)
	scale = math.max(tonumber(scale) or 1, 0.01)
	gap = tonumber(gap) or 6
	margin = math.max(tonumber(margin) or 8, 0)

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local targetPosition = target.AbsolutePosition
	local targetSize = target.AbsoluteSize
	local popupWidth = (popup.Size.X.Offset + viewport.X * popup.Size.X.Scale) * scale
	local popupHeight = (popup.Size.Y.Offset + viewport.Y * popup.Size.Y.Scale) * scale

	local rightX = targetPosition.X + targetSize.X
	local topY = targetPosition.Y + targetSize.Y + gap
	if topY + popupHeight > viewport.Y - margin then
		topY = targetPosition.Y - popupHeight - gap
	end

	rightX = math.clamp(rightX, margin + popupWidth, math.max(margin + popupWidth, viewport.X - margin))
	topY = math.clamp(topY, margin, math.max(margin, viewport.Y - popupHeight - margin))
	popup.Position = UDim2.fromOffset(rightX, topY)
	return Vector2.new(rightX, topY)
end

function Util.BindFocusRing(object, getTheme, maid)
	object.Selectable = true
	local theme = getTheme()
	local stroke = Util.Create("UIStroke", {
		Name = "FocusRing",
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = theme.FocusRing,
		Transparency = 1,
		Thickness = 2,
		Parent = object,
	})
	maid:Give(object.SelectionGained:Connect(function()
		stroke.Color = getTheme().FocusRing
		stroke.Transparency = 0.08
	end))
	maid:Give(object.SelectionLost:Connect(function()
		stroke.Transparency = 1
	end))
	return stroke
end

function Util.Find(array, predicate)
	for index, value in ipairs(array) do
		if predicate(value, index) then
			return value, index
		end
	end
	return nil, nil
end


local Maid = {}
Maid.__index = Maid

local function cleanTask(taskObject)
	local kind = typeof(taskObject)
	if kind == "RBXScriptConnection" then
		taskObject:Disconnect()
	elseif kind == "Instance" then
		taskObject:Destroy()
	elseif kind == "function" then
		taskObject()
	elseif kind == "thread" then
		task.cancel(taskObject)
	elseif type(taskObject) == "table" then
		if type(taskObject.Destroy) == "function" then
			taskObject:Destroy()
		elseif type(taskObject.Disconnect) == "function" then
			taskObject:Disconnect()
		end
	end
end

function Maid.new()
	return setmetatable({
		_tasks = {},
		_destroyed = false,
	}, Maid)
end

function Maid:Give(taskObject)
	assert(not self._destroyed, "Cannot add to destroyed Maid")
	table.insert(self._tasks, taskObject)
	return taskObject
end

function Maid:Set(key, taskObject)
	assert(not self._destroyed, "Cannot set on destroyed Maid")
	local previous = self._tasks[key]
	if previous == taskObject then
		return taskObject
	end
	if previous ~= nil then
		self._tasks[key] = nil
		local ok, message = pcall(cleanTask, previous)
		if not ok then
			warn("[SilenceUI] Cleanup failed:", message)
		end
	end
	if taskObject ~= nil then
		self._tasks[key] = taskObject
	end
	return taskObject
end

function Maid:Replace(key, taskObject)
	return self:Set(key, taskObject)
end

function Maid:IsDestroyed()
	return self._destroyed
end

function Maid:Remove(key)
	self:Set(key, nil)
end

function Maid:Clean()
	local tasks = self._tasks
	self._tasks = {}
	for key, taskObject in pairs(tasks) do
		tasks[key] = nil
		local ok, message = pcall(cleanTask, taskObject)
		if not ok then
			warn("[SilenceUI] Cleanup failed:", message)
		end
	end
end

function Maid:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:Clean()
end


local SignalConnection = {}
SignalConnection.__index = SignalConnection

function SignalConnection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	self._handler = nil
end

SignalConnection.Destroy = SignalConnection.Disconnect

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({
		_connections = {},
		_waiting = {},
		_destroyed = false,
	}, Signal)
end

function Signal:Connect(handler)
	assert(not self._destroyed, "Signal is destroyed")
	assert(type(handler) == "function", "Signal handler must be a function")
	local connection = setmetatable({
		Connected = true,
		_handler = handler,
	}, SignalConnection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Once(handler)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	if self._destroyed then
		return
	end
	local arguments = table.pack(...)
	local active = table.create(#self._connections)
	for _, connection in ipairs(self._connections) do
		if connection.Connected and connection._handler then
			table.insert(active, connection)
			local handler = connection._handler
			task.spawn(function()
				local ok, message = xpcall(function()
					handler(table.unpack(arguments, 1, arguments.n))
				end, debug.traceback)
				if not ok then
					warn("[SilenceUI] Signal failed:\n" .. tostring(message))
				end
			end)
		end
	end
	self._connections = active

	local waiting = self._waiting
	self._waiting = {}
	for _, threadObject in ipairs(waiting) do
		task.spawn(threadObject, table.unpack(arguments, 1, arguments.n))
	end
end

function Signal:Wait()
	assert(not self._destroyed, "Signal is destroyed")
	table.insert(self._waiting, coroutine.running())
	return coroutine.yield()
end

function Signal:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	for _, threadObject in ipairs(self._waiting) do
		task.cancel(threadObject)
	end
	table.clear(self._connections)
	table.clear(self._waiting)
end


