local PagedListControl = {}

function PagedListControl.new(context, parent, options)
	local theme = context:GetTheme()
	local items = Util.DeepCopy(options.Items or {})
	local pageSize = math.clamp(tonumber(options.PageSize) or 20, 5, 100)
	local rowHeight = math.max(tonumber(options.RowHeight) or 34, 24)
	local currentPage = 1
	local totalHeight = 42 + rowHeight * math.min(pageSize, tonumber(options.VisibleRows) or pageSize) + 40
	local root = Util.Create("Frame", {
		Name = options.Id or "PagedList",
		BackgroundColor3 = theme.SurfaceRaised,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		LayoutOrder = options.Order or 0,
		Size = UDim2.new(1, 0, 0, totalHeight),
		Parent = parent,
	})
	Util.Corner(root, theme.RadiusLarge)
	local rootStroke = Util.Stroke(root, theme.Border, 0.82, 1)
	rootStroke.Name = "GlassStroke"
	styleGlass(root, theme, context.Quality, nil, "Panel")
	local header = Util.Create("Frame", {
		Name = "Header",
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 38),
		Parent = root,
	})
	styleGlass(header, theme, context.Quality, nil, "Inset")
	local title = Util.Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = options.Title or "Items",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(0.5, -12, 1, 0),
		Parent = header,
	})
	local search = Util.Create("TextBox", {
		Name = "Search",
		BackgroundColor3 = theme.SurfaceRaised,
		BackgroundTransparency = 0.14,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = theme.FontNormal or Enum.Font.Gotham,
		PlaceholderText = options.SearchPlaceholder or "Search",
		PlaceholderColor3 = theme.TextMuted,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(150, 26),
		Parent = header,
	})
	Util.Corner(search, 6)
	Util.Padding(search, 0, 8, 0, 8)
	styleGlass(search, theme, context.Quality, nil, "Inset")

	local rowsHolder = Util.Create("Frame", {
		Name = "Rows",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 44),
		Size = UDim2.new(1, -16, 1, -86),
		Parent = root,
	})
	Util.List(rowsHolder, 2)
	local footer = Util.Create("Frame", {
		Name = "Footer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 38),
		Parent = root,
	})
	local previous = Util.Create("TextButton", {
		Name = "Previous",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = "Previous",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 10,
		Position = UDim2.fromOffset(8, 5),
		Size = UDim2.fromOffset(76, 28),
		Parent = footer,
	})
	Util.Corner(previous, 6)
	styleGlass(previous, theme, context.Quality, nil, "Inset")
	local nextButton = Util.Create("TextButton", {
		Name = "Next",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = "Next",
		TextColor3 = theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 10,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 5),
		Size = UDim2.fromOffset(76, 28),
		Parent = footer,
	})
	Util.Corner(nextButton, 6)
	styleGlass(nextButton, theme, context.Quality, nil, "Inset")
	local pageLabel = Util.Create("TextLabel", {
		Name = "Page",
		BackgroundTransparency = 1,
		Font = theme.FontMedium or Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.TextMuted,
		TextSize = (theme.TextSizeOffset or 0) + 10,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 5),
		Size = UDim2.fromOffset(150, 28),
		Parent = footer,
	})

	local maid = Maid.new()
	maid:Give(root)
	local pageMaid = Maid.new()
	maid:Set("Page", pageMaid)
	local selectedId = options.Default

	local function itemId(item, index)
		if type(item) == "table" then
			return item.Id or item.Key or tostring(index)
		end
		return tostring(index)
	end

	local function itemTitle(item)
		if type(item) == "table" then
			return item.Title or item.Name or item.Id or "Item"
		end
		return tostring(item)
	end

	local function itemDescription(item)
		return type(item) == "table" and item.Description or nil
	end

	local function filteredItems()
		local query = string.lower(search.Text)
		if query == "" then
			return items
		end
		local result = {}
		for index, item in ipairs(items) do
			local searchable = string.lower(
				itemTitle(item)
				.. " "
				.. tostring(itemDescription(item) or "")
				.. " "
				.. itemId(item, index)
			)
			if string.find(searchable, query, 1, true) then
				table.insert(result, item)
			end
		end
		return result
	end

	local function render()
		pageMaid:Destroy()
		pageMaid = Maid.new()
		maid:Set("Page", pageMaid)
		for _, child in ipairs(rowsHolder:GetChildren()) do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end

		local filtered = filteredItems()
		local pageCount = math.max(1, math.ceil(#filtered / pageSize))
		currentPage = math.clamp(currentPage, 1, pageCount)
		local startIndex = (currentPage - 1) * pageSize + 1
		local endIndex = math.min(startIndex + pageSize - 1, #filtered)
		local nextTheme = context:GetTheme()

		for index = startIndex, endIndex do
			local item = filtered[index]
			local id = itemId(item, index)
			local selected = selectedId == id
			local row = Util.Create("TextButton", {
				Name = id,
				AutoButtonColor = false,
				BackgroundColor3 = selected and nextTheme.Accent or nextTheme.SurfaceRaised,
				BackgroundTransparency = selected and 0.16 or 0.34,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Text = "",
				Size = UDim2.new(1, 0, 0, rowHeight),
				Parent = rowsHolder,
			})
			Util.Corner(row, 6)
			Util.Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Font = nextTheme.FontMedium or Enum.Font.GothamMedium,
				Text = itemTitle(item),
				TextColor3 = selected and nextTheme.AccentText or nextTheme.Text,
				TextSize = (nextTheme.TextSizeOffset or 0) + 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(10, itemDescription(item) and 3 or 0),
				Size = UDim2.new(1, -20, itemDescription(item) and 0.5 or 1, 0),
				Parent = row,
			})
			if itemDescription(item) then
				Util.Create("TextLabel", {
					Name = "Description",
					BackgroundTransparency = 1,
					Font = nextTheme.FontNormal or Enum.Font.Gotham,
					Text = itemDescription(item),
					TextColor3 = selected and nextTheme.AccentText or nextTheme.TextMuted,
					TextSize = (nextTheme.TextSizeOffset or 0) + 9,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 10, 0.5, 0),
					Size = UDim2.new(1, -20, 0.5, -3),
					Parent = row,
				})
			end
			pageMaid:Give(row.Activated:Connect(function()
				selectedId = id
				render()
				Util.SafeCall(options.OnSelected, item, id, index)
			end))
		end

		pageLabel.Text = string.format(
			"Page %d / %d  -  %d items",
			currentPage,
			pageCount,
			#filtered
		)
		previous.TextTransparency = currentPage <= 1 and 0.55 or 0
		nextButton.TextTransparency = currentPage >= pageCount and 0.55 or 0
	end

	local api = {
		Id = options.Id or "PagedList",
		Save = false,
		Root = root,
		Destroyed = false,
	}

	function api:SetItems(nextItems)
		assert(type(nextItems) == "table", "Items must be a table")
		items = Util.DeepCopy(nextItems)
		currentPage = 1
		render()
	end

	function api:GetItems()
		return Util.DeepCopy(items)
	end

	function api:SetPage(page)
		currentPage = math.max(1, math.floor(tonumber(page) or 1))
		render()
	end

	function api:GetPage()
		return currentPage
	end

	function api:SetQuery(query)
		search.Text = tostring(query or "")
	end

	function api:GetSelected()
		return selectedId
	end

	function api:SetVisible(visible)
		root.Visible = visible == true
	end

	function api:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		maid:Destroy()
	end

	maid:Give(previous.Activated:Connect(function()
		if currentPage > 1 then
			currentPage -= 1
			render()
		end
	end))
	maid:Give(nextButton.Activated:Connect(function()
		local pageCount = math.max(1, math.ceil(#filteredItems() / pageSize))
		if currentPage < pageCount then
			currentPage += 1
			render()
		end
	end))
	maid:Give(search:GetPropertyChangedSignal("Text"):Connect(function()
		currentPage = 1
		render()
	end))
	maid:Give(context:WatchTheme(function(nextTheme)
		styleGlass(root, nextTheme, context.Quality, nil, "Panel")
		styleGlass(header, nextTheme, context.Quality, nil, "Inset")
		title.TextColor3 = nextTheme.Text
		title.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		title.TextSize = (nextTheme.TextSizeOffset or 0) + 12
		styleGlass(search, nextTheme, context.Quality, nil, "Inset")
		search.TextColor3 = nextTheme.Text
		search.PlaceholderColor3 = nextTheme.TextMuted
		search.Font = nextTheme.FontNormal or Enum.Font.Gotham
		search.TextSize = (nextTheme.TextSizeOffset or 0) + 10
		styleGlass(previous, nextTheme, context.Quality, nil, "Inset")
		previous.TextColor3 = nextTheme.Text
		previous.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		previous.TextSize = (nextTheme.TextSizeOffset or 0) + 10
		styleGlass(nextButton, nextTheme, context.Quality, nil, "Inset")
		nextButton.TextColor3 = nextTheme.Text
		nextButton.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		nextButton.TextSize = (nextTheme.TextSizeOffset or 0) + 10
		pageLabel.TextColor3 = nextTheme.TextMuted
		pageLabel.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
		pageLabel.TextSize = (nextTheme.TextSizeOffset or 0) + 10
		render()
	end))
	render()
	return api
end

