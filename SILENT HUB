			if control and type(control.GetValue) == "function" then
				return control:GetValue()
			end
			return nil
		end,
		__newindex = function(_, key, value)
			local control = self._controls[key]
			if not control or type(control.SetValue) ~= "function" then
				error("Unknown or immutable control flag: " .. tostring(key))
			end
			control:SetValue(value)
		end,
		__pairs = function()
			local snapshot = {}
			for id, control in pairs(self._controls) do
				if type(control.GetValue) == "function" then
					snapshot[id] = control:GetValue()
				end
