		PlaceholderText = "#FFFFFF",
		Text = Util.ColorToHex(self._value),
		TextColor3 = theme.Text,
		TextSize = 13,
		Position = UDim2.fromOffset(0, options.AllowAlpha and 194 or 166),
		Size = UDim2.new(1, 0, 0, 30),
		ZIndex = 61,
		Parent = popup,
	})

	local hueValue, saturationValue, brightnessValue = self._value:ToHSV()
	local open = false
	local draggingSaturation = false
	local draggingHue = false
	local draggingAlpha = false

	local function render(nextTheme)
		preview.BackgroundColor3 = self._value
		preview.BackgroundTransparency = 1 - self._alpha
		previewStroke.Color = nextTheme.Border
		styleGlass(popup, nextTheme, context.Quality, nil, "Overlay")
		if popupScale then
			popupScale.Scale = context.Scale or 1
		end
		hexBox.BackgroundTransparency = 1
		hexBox.TextColor3 = nextTheme.Text
		saturation.BackgroundColor3 = Color3.fromHSV(hueValue, 1, 1)
		saturationCursor.Position = UDim2.fromScale(saturationValue, 1 - brightnessValue)
		hueCursor.Position = UDim2.fromScale(hueValue, 0.5)
		if alpha and alphaCursor then
			alpha.BackgroundColor3 = self._value
			alphaCursor.Position = UDim2.fromScale(self._alpha, 0.5)
		end
		hexBox.Text = Util.ColorToHex(self._value)
	end
	self._renderControl = render

	local function commit(silent)
		self._value = Color3.fromHSV(hueValue, saturationValue, brightnessValue)
		render(context:GetTheme())
		if not silent then
			self.Changed:Fire(self._value, self._alpha)
			Util.SafeCall(self._callback, self._value, self._alpha)
		end
	end

	function self:SetValue(value, alphaValue, silent)
		if type(value) == "table" and typeof(value.Color) == "Color3" then
			silent = alphaValue
			alphaValue = value.Alpha
			value = value.Color
		end
		if typeof(value) == "string" then
			value = Util.HexToColor(value)
		end
		if typeof(value) ~= "Color3" then
			return
		end
		self._value = value
		hueValue, saturationValue, brightnessValue = value:ToHSV()
		if type(alphaValue) == "number" then
			self._alpha = math.clamp(alphaValue, 0, 1)
		end
		render(context:GetTheme())
		if not silent then
			self.Changed:Fire(self._value, self._alpha)
			Util.SafeCall(self._callback, self._value, self._alpha)
		end
	end

	function self:GetValue()
		return {
			Color = self._value,
			Alpha = self._alpha,
		}
	end

	function self:Reset(silent)
		self:SetValue(self._default, self._defaultAlpha, silent)
	end

	local function setSaturation(x, y)
		local position = saturation.AbsolutePosition
		local size = saturation.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		saturationValue = math.clamp((x - position.X) / size.X, 0, 1)
		brightnessValue = 1 - math.clamp((y - position.Y) / size.Y, 0, 1)
		commit(false)
	end

	local function setHue(x)
		if hue.AbsoluteSize.X <= 0 then
			return
		end
		hueValue = math.clamp((x - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		commit(false)
	end

	local function setAlpha(x)
		if not alpha or alpha.AbsoluteSize.X <= 0 then
			return
		end
		self._alpha = math.clamp((x - alpha.AbsolutePosition.X) / alpha.AbsoluteSize.X, 0, 1)
		commit(false)
	end

	local function beginDrag(input)
		local dragMaid = Maid.new()
		self._maid:Set("ColorDrag", dragMaid)
		dragMaid:Give(UserInputService.InputChanged:Connect(function(changedInput)
			if changedInput.UserInputType ~= Enum.UserInputType.MouseMovement
				and changedInput.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			if draggingSaturation then
				setSaturation(changedInput.Position.X, changedInput.Position.Y)
			elseif draggingHue then
				setHue(changedInput.Position.X)
			elseif draggingAlpha then
				setAlpha(changedInput.Position.X)
			end
		end))
		dragMaid:Give(input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				draggingSaturation = false
				draggingHue = false
				draggingAlpha = false
				self._maid:Set("ColorDrag", nil)
			end
		end))
	end

	self._maid:Give(preview.Activated:Connect(function()
		if self.Disabled then
			return
		end
		open = not open
		
		if open then
			context:SetScrollingEnabled(false)
			Util.PositionPopup(popup, preview, context.Scale, 6, 8)

			-- Outside-click detector
			local connection
			connection = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local mousePos = input.Position
					local function isInside(guiObject)
						local pos = guiObject.AbsolutePosition
						local size = guiObject.AbsoluteSize
						return mousePos.X >= pos.X and mousePos.X <= pos.X + size.X
							and mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y
					end
					
					if not isInside(popup) and not isInside(preview) then
						open = false
						popup.Visible = false
						context:SetScrollingEnabled(true)
						self._maid:Remove("ColorPickerOutsideClick")
					end
				end
			end)
			self._maid:Set("ColorPickerOutsideClick", connection)
		else
			context:SetScrollingEnabled(true)
			self._maid:Remove("ColorPickerOutsideClick")
		end

		popup.Visible = open
	end))
	self._maid:Give(function()
		if open then
			context:SetScrollingEnabled(true)
		end
	end)
	self._maid:Give(saturation.InputBegan:Connect(function(input)
		if Util.IsPrimaryInput(input) then
			draggingSaturation = true
			setSaturation(input.Position.X, input.Position.Y)
			beginDrag(input)
		end
	end))
	self._maid:Give(hue.InputBegan:Connect(function(input)
		if Util.IsPrimaryInput(input) then
			draggingHue = true
			setHue(input.Position.X)
			beginDrag(input)
		end
	end))
	if alpha then
		self._maid:Give(alpha.InputBegan:Connect(function(input)
			if Util.IsPrimaryInput(input) then
				draggingAlpha = true
				setAlpha(input.Position.X)
				beginDrag(input)
			end
		end))
	end
	self._maid:Give(hexBox.FocusLost:Connect(function(enterPressed)
		if not enterPressed then
			hexBox.Text = Util.ColorToHex(self._value)
			return
		end
		local color = Util.HexToColor(hexBox.Text)
		if color then
			self:SetValue(color, self._alpha)
		else
			hexBox.Text = Util.ColorToHex(self._value)
		end
	end))

	render(theme)
	return self
end

-- Segmented control ----------------------------------------------------------

local SegmentedControl = {}

function SegmentedControl.new(context, parent, options)
	local items = normalizeDropdownOptions(options.Options or options.Values or {})
	local first = items[1] and items[1].Id or ""
	local self = BaseControl.new(context, parent, options, 84)
	self._default = options.Default or first
	self._value = self._default
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	local holder = Util.Create("Frame", {
		Name = "Segments",
		BackgroundColor3 = theme.Control,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -10),
		Size = UDim2.new(1, 0, 0, 38),
		Parent = self.Content,
	})
	Util.Corner(holder, theme.RadiusSmall)
	styleGlass(holder, theme, context.Quality, nil, "Inset")
	local holderPadding = Util.Padding(holder, 3)
	local holderList = Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = holder,
	})

	self.TitleLabel.Position = UDim2.fromOffset(0, 4)
	self.TitleLabel.Size = UDim2.new(1, 0, 0, 24)

	local buttons = {}

	local function render(nextTheme, animate)
		styleGlass(holder, nextTheme, context.Quality, nil, "Inset")
		local count = math.max(#items, 1)
		for id, button in pairs(buttons) do
			local selected = self._value == id
			button.Size = UDim2.new(1 / count, -((count - 1) * 3) / count, 1, 0)
			button.Font = nextTheme.FontMedium or Enum.Font.GothamMedium
			button.TextSize = (nextTheme.TextSizeOffset or 0) + 11
			local properties = {
				BackgroundColor3 = selected and nextTheme.SurfaceRaised or nextTheme.Control,
				BackgroundTransparency = selected and 0 or 1,
				TextColor3 = selected and nextTheme.Text or nextTheme.TextMuted,
			}
			if animate then
				Util.Tween(button, context:GetMotion("Fast"), properties)
			else
				for property, value in pairs(properties) do
					button[property] = value
				end
			end
			local corner = button:FindFirstChildOfClass("UICorner")
			if corner then
				corner.CornerRadius = UDim.new(0, math.max(nextTheme.RadiusSmall - 2, 0))
			end
		end
	end
	self._renderControl = render

	local function buildButtons()
		for _, button in pairs(buttons) do
			button:Destroy()
		end
		table.clear(buttons)

		for index, item in ipairs(items) do
			local button = Util.Create("TextButton", {
				Name = item.Id,
				AutoButtonColor = false,
				BackgroundColor3 = theme.Control,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamMedium,
				LayoutOrder = index,
				Text = item.Title,
				TextColor3 = theme.TextMuted,
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Size = UDim2.new(1 / math.max(#items, 1), 0, 1, 0),
				Parent = holder,
			})
			Util.Corner(button, math.max(theme.RadiusSmall - 2, 0))
			buttons[item.Id] = button
			self._maid:Give(button.Activated:Connect(function()
				if not self.Disabled then
					self:SetValue(item.Id)
				end
			end))
		end
		render(context:GetTheme(), false)
	end

	function self:SetValue(value, silent)
		if type(value) ~= "string" then
			return
		end
		local valid = false
		for _, item in ipairs(items) do
			if item.Id == value then
				valid = true
				break
			end
		end
		if not valid or self._value == value then
			return
		end
		self._value = value
		render(context:GetTheme(), true)
		if not silent then
			self.Changed:Fire(value)
			Util.SafeCall(self._callback, value)
		end
	end

	function self:SetOptions(values, preserveValue)
		items = normalizeDropdownOptions(values)
		if not preserveValue then
			self._value = items[1] and items[1].Id or ""
		else
			local valid = false
			for _, item in ipairs(items) do
				if item.Id == self._value then
					valid = true
					break
				end
			end
			if not valid then
				self._value = items[1] and items[1].Id or ""
			end
		end
		buildButtons()
	end

	buildButtons()
	return self
end

