function Window:AddAppearanceTab(options)
	options = options or {}
	local id = options.Id or "__SilenceUIAppearance"
	local existing = self:GetTab(id)
	if existing then
		return existing
	end
	local tab = self:AddTab({
		Id = id,
		Title = options.Title or "Appearance",
		Icon = options.Icon or "palette",
		Order = options.Order or 9999,
	})
	local appearance = tab:AddSection({
		Id = "__NativeAppearance",
		Title = "Interface",
		Description = "Theme settings are shared and saved automatically.",
	})
	local themeModeControl = appearance:AddDropdown({
		Id = "__ThemeMode",
		Title = "Theme",
		Options = Themes.GetNames(),
		Default = self._themeMode or "Custom",
		Save = false,
		OnChanged = function(value)
			if value ~= "Custom" then
				self:SetTheme(value)
			end
		end,
	})
	local fontFamiliesList = {}
	do
		local familiesSet = {}
		local suffixes = { "Bold", "Semibold", "Medium", "Light", "Italic", "Black", "Regular", "Thin", "ExtraBold" }
		for _, item in ipairs(Enum.Font:GetEnumItems()) do
			local name = item.Name
			local base = name
			for _, suffix in ipairs(suffixes) do
				if name:sub(-#suffix) == suffix and name ~= suffix then
					base = name:sub(1, #name - #suffix)
					break
				end
			end
			if base ~= "" and not familiesSet[base] then
				familiesSet[base] = true
				table.insert(fontFamiliesList, base)
			end
		end
		table.sort(fontFamiliesList)
	end

	local fontDropdown = appearance:AddDropdown({
		Id = "__FontFamily",
		Title = "Font Family",
		Options = fontFamiliesList,
		Default = self._theme.FontFamily or "Gotham",
		UseOptionFont = true,
		Save = false,
		OnChanged = function(value)
			local variants = {
