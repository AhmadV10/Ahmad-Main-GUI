function Window:AddToggleButton(options)
	options = options or {}
	if self._toggleButton and options.InternalMinimize ~= true then
		return self._toggleButton
	end
	local theme = self:GetTheme()
	local toggleScreen = Util.Create("ScreenGui", {
		Name = self.Id .. (
			options.InternalMinimize == true and "_Minimized" or "_Toggle"
		),
		DisplayOrder = self.Root.DisplayOrder + 1,
		IgnoreGuiInset = false,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = self.Root.Parent,
	})
	protectGui(toggleScreen)
	local internalMinimize = options.InternalMinimize == true
	local size = math.clamp(tonumber(options.Size) or 48, 36, 72)
	local button = Util.Create("TextButton", {
		Name = "ToggleButton",
		Active = true,
		AutoButtonColor = false,
		BackgroundColor3 = theme.SurfaceRaised,
		BackgroundTransparency = internalMinimize and 1 or 0,
		BorderSizePixel = 0,
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = options.Position or UDim2.new(1, -18, 0, 18),
		Size = UDim2.fromOffset(size, size),
		Parent = toggleScreen,
	})
	if not internalMinimize then
		Util.Corner(button, options.Round == false and theme.RadiusMedium or size * 0.5)
		Util.Stroke(button, theme.Border, 0.35, theme.StrokeThickness)
	end
	local requestedIcon = internalMinimize and BRAND_ICON or (options.Icon or "settings")
	local asset = iconAsset(requestedIcon) or requestedIcon
	local preserveIconColor = internalMinimize or options.PreserveIconColor == true
		or (
			type(requestedIcon) == "string"
			and string.match(requestedIcon, "^https?://") ~= nil
		)
	local icon
	if asset then
		icon = Util.Create("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Image = asset,
			ImageColor3 = options.IconColor
				or (preserveIconColor and Color3.new(1, 1, 1) or theme.Icon),
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = internalMinimize
				and UDim2.fromScale(1, 1)
				or UDim2.fromOffset(math.floor(size * 0.48), math.floor(size * 0.48)),
			Parent = button,
		})
		if internalMinimize then
			Util.Corner(icon, math.max(math.floor(size * 0.22), 8))
		end
		resolveRemoteImage(requestedIcon, function(resolvedAsset)
			if icon and icon.Parent and type(resolvedAsset) == "string" then
				icon.Image = resolvedAsset
			end
		end)
	else
		icon = Util.Create("TextLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = tostring(options.Text or "UI"),
			TextColor3 = theme.Icon,
			TextSize = 12,
			Size = UDim2.fromScale(1, 1),
			Parent = button,
		})
	end

	local toggleMaid = Maid.new()
	local ownerWindow = self
	local draggedToggle = false
	self._maid:Give(toggleMaid)
	toggleMaid:Give(toggleScreen)
	toggleMaid:Give(button.Activated:Connect(function()
		if not draggedToggle then
			if self._minimized then
				self:SetMinimized(false)
			else
				self:Toggle()
			end
		end
		draggedToggle = false
	end))
	toggleMaid:Give(self:WatchTheme(function(nextTheme)
		if not internalMinimize then
			button.BackgroundColor3 = nextTheme.SurfaceRaised
			local stroke = button:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = nextTheme.Border
				stroke.Thickness = nextTheme.StrokeThickness
			end
		end
		if icon:IsA("ImageLabel") then
			icon.ImageColor3 = options.IconColor
				or (preserveIconColor and Color3.new(1, 1, 1) or nextTheme.Icon)
		else
			icon.TextColor3 = nextTheme.Icon
		end
	end))

	if options.Draggable ~= false then
		local dragging = false
		local inputStart = Vector2.zero
		local positionStart = button.Position
		toggleMaid:Give(button.InputBegan:Connect(function(input)
			if Util.IsPrimaryInput(input) then
				dragging = true
				draggedToggle = false
				inputStart = input.Position
				positionStart = button.Position
				local dragMaid = Maid.new()
				toggleMaid:Set("Drag", dragMaid)
				dragMaid:Give(UserInputService.InputChanged:Connect(function(changedInput)
					if dragging and (
						changedInput.UserInputType == Enum.UserInputType.MouseMovement
						or changedInput.UserInputType == Enum.UserInputType.Touch
					) then
						local delta = changedInput.Position - inputStart
						if delta.Magnitude > 4 then
							draggedToggle = true
						end
						button.Position = UDim2.new(
							positionStart.X.Scale,
							positionStart.X.Offset + delta.X,
							positionStart.Y.Scale,
							positionStart.Y.Offset + delta.Y
						)
					end
				end))
				dragMaid:Give(input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						toggleMaid:Set("Drag", nil)
						if ownerWindow and not ownerWindow.Destroyed then
							ownerWindow:_queueNativePreferenceSave()
						end
					end
				end))
			end
		end))
	end

	local api = {
		Root = button,
		ScreenGui = toggleScreen,
	}
	local ownerWindow = self
	function api:SetVisible(visible)
		toggleScreen.Enabled = visible == true
	end
	function api:SetPosition(position)
		if typeof(position) == "UDim2" then
			button.Position = position
		end
	end
	function api:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		toggleMaid:Destroy()
		if ownerWindow._toggleButton == self then
			ownerWindow._toggleButton = nil
		end
		if ownerWindow._minimizeButton == self then
			ownerWindow._minimizeButton = nil
		end
	end
	if options.InternalMinimize == true then
		self._minimizeButton = api
	else
		self._toggleButton = api
	end
	return api
end

function Window:RegisterCommand(options)
	assert(type(options) == "table", "Command options are required")
	assert(type(options.Id) == "string" and options.Id ~= "", "Command Id is required")
	assert(type(options.Title) == "string" and options.Title ~= "", "Command title is required")
	assert(type(options.Callback) == "function", "Command callback is required")
	assert(self._commands[options.Id] == nil, "Duplicate command Id: " .. options.Id)

	local command = {
		Id = options.Id,
		Title = options.Title,
		Description = options.Description,
		Icon = options.Icon,
		Keywords = options.Keywords or {},
		Callback = options.Callback,
		Disabled = options.Disabled == true,
		Order = tonumber(options.Order) or 0,
	}
	self._commands[command.Id] = command

	local api = {}
	function api:SetDisabled(disabled)
		command.Disabled = disabled == true
	end
	function api:SetTitle(title)
		command.Title = tostring(title)
	end
	function api:Execute(...)
		if not command.Disabled then
			Util.SafeCall(command.Callback, ...)
			return true
		end
		return false
	end
	api.Command = command

	local ownerWindow = self
	function api:Destroy()
		if ownerWindow._commands[command.Id] == command then
			ownerWindow._commands[command.Id] = nil
		end
	end
	return api
end

function Window:RemoveCommand(id)
	if self._commands[id] then
		self._commands[id] = nil
		return true
	end
	return false
end

function Window:ExecuteCommand(id, ...)
	local command = self._commands[id]
	if not command or command.Disabled then
		return false
	end
	Util.SafeCall(command.Callback, ...)
	return true
end

