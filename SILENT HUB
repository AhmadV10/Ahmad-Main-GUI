function Window:_applyTheme()
	local theme = self._theme
	self.Frame.BackgroundColor3 = theme.Canvas
	self.Frame.BackgroundTransparency = 0.02
	local windowStroke = self.Frame:FindFirstChild("WindowStroke")
	if windowStroke then
		windowStroke.Color = theme.Border
	end
	self._content.BackgroundColor3 = theme.Canvas
	self._content.BackgroundTransparency = self.Quality == "Low" and 0 or 0.04
	self._sidebar.BackgroundColor3 = theme.Surface
	self._sidebar.BackgroundTransparency = 0.12
	local divider = self._sidebar:FindFirstChild("Divider")
	if divider then divider.BackgroundColor3 = theme.Border end
	local title = self._header:FindFirstChild("Title")
	local subtitle = self._header:FindFirstChild("Subtitle")
	if title then
		title.TextColor3 = theme.Text
		title.Font = theme.FontBold or Enum.Font.GothamBold
		title.TextSize = (theme.TextSizeOffset or 0) + 17
	end
	if subtitle then
		subtitle.TextColor3 = theme.TextMuted
		subtitle.Font = theme.FontMedium or Enum.Font.GothamMedium
		subtitle.TextSize = (theme.TextSizeOffset or 0) + 12
	end
	if self._pageTitle then
		self._pageTitle.TextColor3 = theme.Text
		self._pageTitle.Font = theme.FontBold or Enum.Font.GothamBold
		self._pageTitle.TextSize = (theme.TextSizeOffset or 0) + 20
	end
	if self._profile then
		local avatar = self._profile:FindFirstChild("Avatar")
		local displayName = self._profile:FindFirstChild("DisplayName")
		local username = self._profile:FindFirstChild("Username")
		if avatar then avatar.BackgroundColor3 = theme.SurfaceRaised end
		if displayName then displayName.TextColor3 = theme.Text end
		if username then username.TextColor3 = theme.TextMuted end
	end
	local windowActions = self._header:FindFirstChild("WindowActions")
	if windowActions then
		local minimize = windowActions:FindFirstChild("Minimize")
		local close = windowActions:FindFirstChild("Close")
		local fullscreen = windowActions:FindFirstChild("Fullscreen")
		styleGlass(windowActions, theme, self.Quality)
		if minimize then
			minimize.BackgroundColor3 = Color3.fromRGB(255, 204, 51)
			minimize.TextColor3 = Color3.fromRGB(105, 82, 0)
		end
		if close then
			close.BackgroundColor3 = Color3.fromRGB(255, 69, 58)
			close.TextColor3 = Color3.fromRGB(120, 16, 10)
		end
		if fullscreen then
			fullscreen.BackgroundColor3 = Color3.fromRGB(48, 209, 88)
			fullscreen.TextColor3 = Color3.fromRGB(10, 105, 40)
		end
	end
	local navigationList = self._navigation:FindFirstChildOfClass("UIListLayout")
	if navigationList then
		navigationList.Padding = UDim.new(0, theme.SpacingSmall)
	end
	local status = self._sidebar:FindFirstChild("WindowStatus")
	if status then
		local statusType = status:GetAttribute("StatusType")
		status.TextColor3 = statusType == "Error" and theme.Danger
			or statusType == "Success" and theme.Success
			or statusType == "Warning" and theme.Warning
			or theme.TextMuted
	end
	local corner = self.Frame:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(0, theme.RadiusWindow)
	end
	for _, callback in ipairs(table.clone(self._themeListeners)) do
		local ok, message = xpcall(function()
			callback(theme)
		end, debug.traceback)
		if not ok then
			warn("[SilenceUI] Theme listener failed:\n" .. tostring(message))
		end
	end
	self.ThemeChanged:Fire(theme)
end

function Window:SetQuality(quality)
	self.RequestedQuality = quality
	local resolved = resolveQuality(quality, self.Frame.AbsoluteSize)
	if resolved == self.Quality then
		if self._appearanceSync then
			self._appearanceSync()
		end
		self:SaveAppearanceNow()
		return
	end
	self.Quality = resolved
	self:_applyTheme()
	self:SaveAppearanceNow()
end

function Window:CalibrateQuality(options)
	options = options or {}
	if self._qualityCalibration then
		self._qualityCalibration:Destroy()
		self._qualityCalibration = nil
	end
	local calibrationMaid = Maid.new()
	self._qualityCalibration = calibrationMaid
	local duration = math.clamp(tonumber(options.Duration) or 1.25, 0.4, 4)
	local elapsed = 0
	local frames = 0
	local totalDelta = 0
	local finished = false

	local function finish()
		if finished then
			return
		end
		finished = true
		local averageDelta = frames > 0 and totalDelta / frames or 1 / 30
		local fps = averageDelta > 0 and 1 / averageDelta or 60
		local quality
		if fps < (tonumber(options.LowThreshold) or 43) then
			quality = "Low"
		elseif fps < (tonumber(options.HighThreshold) or 57) then
			quality = "Medium"
		else
			quality = UserInputService.TouchEnabled and "Medium" or "High"
		end
		self:SetQuality(quality)
		self.RequestedQuality = "Auto"
		self:_queueNativePreferenceSave()
		Util.SafeCall(options.OnComplete, quality, fps)
		calibrationMaid:Destroy()
		if self._qualityCalibration == calibrationMaid then
			self._qualityCalibration = nil
		end
	end

	calibrationMaid:Give(RunService.Heartbeat:Connect(function(delta)
		elapsed += delta
		frames += 1
		totalDelta += delta
		if elapsed >= duration then
			finish()
		end
	end))
	calibrationMaid:Give(task.delay(duration + 0.5, finish))
	return {
		Cancel = function()
			if not finished then
				finished = true
				calibrationMaid:Destroy()
				if self._qualityCalibration == calibrationMaid then
					self._qualityCalibration = nil
				end
			end
		end,
	}
end

