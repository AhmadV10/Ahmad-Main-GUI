		end
		local compact = frame.AbsoluteSize.X < 760
		local sidebarWidth = compact
			and 86
			or math.clamp(math.floor(frame.AbsoluteSize.X * 0.36), 340, 400)
		sidebar.Size = UDim2.new(0, sidebarWidth, 1, 0)
		content.Position = UDim2.fromOffset(sidebarWidth, 0)
		content.Size = UDim2.new(1, -sidebarWidth, 1, 0)
		title.Visible = not compact
		subtitle.Visible = false
		if scriptIcon then
			scriptIcon.Visible = not compact
		end
		profile.Visible = not compact
		windowActions.Position = compact
			and UDim2.fromOffset(3, 13)
			or (self._chromeExpanded and UDim2.fromOffset(18, 17) or UDim2.fromOffset(18, 29))
		actionExpander.Position = windowActions.Position
