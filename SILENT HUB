local function getFontVariant(family, weight)
	local map = FontFamilies[family]
	if map then
		return map[weight] or map.Normal
	end
	
	if weight == "Medium" then
		local ok, val = pcall(function() return Enum.Font[family .. "Medium"] end)
		if ok and val then return val end
	elseif weight == "Semibold" then
		local ok, val = pcall(function() return Enum.Font[family .. "Semibold"] end)
		if ok and val then return val end
	elseif weight == "Bold" then
		local ok, val = pcall(function() return Enum.Font[family .. "Bold"] end)
		if ok and val then return val end
	end
	local ok, val = pcall(function() return Enum.Font[family] end)
	return ok and val or Enum.Font.Gotham
end

function Themes.Resolve(theme)
	if theme == "Silence" or theme == nil then
		return Util.Copy(Themes.Silence)
	elseif theme == "Light" then
		return Util.Copy(Themes.Light)
	elseif theme == "Dark" then
		return Util.Copy(Themes.Dark)
	elseif type(theme) == "string" and Themes.Custom[theme] then
		return Util.Copy(Themes.Custom[theme])
	elseif type(theme) == "table" then
		return Themes.Patch(theme.Dark == false and Themes.Light or Themes.Dark, theme)
	end
	return Util.Copy(Themes.Silence)
end

function Themes.Register(name, patch, base)
	assert(type(name) == "string" and name ~= "", "Theme name is required")
	assert(
		name ~= "Silence" and name ~= "Dark" and name ~= "Light" and name ~= "Custom",
		"Built-in theme names are reserved"
	)
	assert(type(patch) == "table", "Theme patch must be a table")
	local baseTheme = Themes.Resolve(base or (patch.Dark == false and "Light" or "Dark"))
	local theme = Themes.Patch(baseTheme, patch)
	theme.Name = name
	Themes.Custom[name] = theme
	return theme
end

function Themes.Unregister(name)
	Themes.Custom[name] = nil
end

function Themes.GetNames()
	local names = { "Silence", "Light", "Dark", "Custom" }
	for name in pairs(Themes.Custom) do
		table.insert(names, name)
	end
	table.sort(names, function(a, b)
		if a == b then return false end
		local aRank = a == "Silence" and 1
			or a == "Light" and 2
			or a == "Dark" and 3
			or a == "Custom" and 4
			or 5
		local bRank = b == "Silence" and 1
			or b == "Light" and 2
			or b == "Dark" and 3
			or b == "Custom" and 4
			or 5
		if aRank ~= bRank then
			return aRank < bRank
		end
		return a < b
	end)
	return names
end

