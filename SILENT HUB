		task.defer(function()
			if not self.Destroyed then
				self:SetMinimized(true)
			end
		end)
	end
	if options.CalibrateQuality and requestedQuality == "Auto" then
		task.defer(function()
			if not self.Destroyed then
				self:CalibrateQuality(
					type(options.CalibrateQuality) == "table"
						and options.CalibrateQuality
						or {}
				)
			end
		end)
	end
	return self
end

