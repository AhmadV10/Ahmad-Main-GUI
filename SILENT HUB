			configText:SetValue(content, true)
			local clipboard = getGlobal("setclipboard")
			if type(clipboard) == "function" then
				pcall(clipboard, content)
				self:Notify({
					Title = "Config exported",
					Content = "JSON was copied to the clipboard.",
					Type = "Success",
				})
			else
				self:Notify({
					Title = "Config exported",
					Content = "Copy the JSON from the text field.",
					Type = "Success",
				})
			end
		end,
