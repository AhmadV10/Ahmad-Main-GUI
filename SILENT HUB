function Section.new(context, parent, options)
	options = options or {}
	local theme = context:GetTheme()
	local root = Util.Create("Frame", {
		Name = options.Id or "Section",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = options.Order or 0,
		Size = UDim2.new(1, 0, 0, 0),
		Parent = parent,
	})
	local rootList = Util.List(root, math.max(theme.SpacingMedium - 4, 0))
	local header
	if options.Title or options.Description then
		header = Util.Create("TextButton", {
			Name = "Header",
			AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			Size = UDim2.new(1, 0, 0, options.Description and 40 or 26),
			Parent = root,
		})
		Util.Create("TextLabel", {
			Name = "Title",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamSemibold,
			Text = options.Title or "",
			TextColor3 = theme.Text,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, options.Collapsible and -30 or 0, 0, 20),
			Parent = header,
		})
		if options.Description then
			Util.Create("TextLabel", {
				Name = "Description",
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				Text = options.Description,
				TextColor3 = theme.TextMuted,
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(0, 22),
				Size = UDim2.new(1, options.Collapsible and -30 or 0, 0, 16),
				Parent = header,
			})
		end
		if options.Collapsible then
			Util.Create("ImageLabel", {
				Name = "Arrow",
				BackgroundTransparency = 1,
				Image = iconAsset("chevron"),
				ImageColor3 = theme.TextMuted,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 2),
				Rotation = options.Collapsed and 0 or 90,
				Size = UDim2.fromOffset(16, 16),
				Parent = header,
			})
		end
	end

	local body = Util.Create("Frame", {
		Name = "Body",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		Visible = options.Collapsed ~= true,
		Parent = root,
	})
	local bodyList = Util.List(body, theme.SpacingMedium)

	local self = setmetatable({
		Id = options.Id or "Section",
		Root = root,
		Body = body,
		Header = header,
		Visible = options.Visible ~= false,
		Destroyed = false,
		_collapsed = options.Collapsed == true,
		Visible = options.Visible ~= false,
		_context = context,
		_controls = {},
		_groups = {},
		_currentGroup = nil,
		_flowOrder = 0,
		_maid = Maid.new(),
	}, Section)
	root.Visible = self.Visible
	self._maid:Give(root)
	self._maid:Give(context:WatchTheme(function(nextTheme)
		rootList.Padding = UDim.new(0, math.max(nextTheme.SpacingMedium - 4, 0))
		bodyList.Padding = UDim.new(0, nextTheme.SpacingMedium)
		if header then
			local title = header:FindFirstChild("Title")
			local description = header:FindFirstChild("Description")
			local arrow = header:FindFirstChild("Arrow")
			if title then
				title.TextColor3 = nextTheme.Text
				title.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
				title.TextSize = (nextTheme.TextSizeOffset or 0) + 15
			end
			if description then
				description.TextColor3 = nextTheme.TextMuted
				description.Font = nextTheme.FontNormal or Enum.Font.Gotham
				description.TextSize = (nextTheme.TextSizeOffset or 0) + 11
			end
			if arrow then arrow.ImageColor3 = nextTheme.TextMuted end
		end
	end))
	if header and options.Collapsible then
		self._maid:Give(header.Activated:Connect(function()
			self:SetCollapsed(not self._collapsed)
		end))
	end
	return self
end

function Section:_nextOrder()
	self._flowOrder += 1
	return self._flowOrder
end

function Section:_finishGroup()
	self._currentGroup = nil
end

function Section:_createGroup()
	local theme = self._context:GetTheme()
	local group = Util.Create("Frame", {
		Name = "SettingsGroup",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.GlassTint,
		BackgroundTransparency = theme.GlassTransparency,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		LayoutOrder = self:_nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		Parent = self.Body,
	})
	Util.Corner(group, theme.RadiusLarge)
	styleGlass(group, theme, self._context.Quality, nil, "Panel")
	local content = Util.Create("Frame", {
		Name = "Content",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		Parent = group,
	})
	Util.List(content, 0)

	local groupData = {
		Root = group,
		Content = content,
		Count = 0,
	}
	table.insert(self._groups, groupData)
	self._currentGroup = groupData
	self._maid:Give(self._context:WatchTheme(function(nextTheme)
		if group.Parent then
			styleGlass(group, nextTheme, self._context.Quality, nil, "Panel")
			local corner = group:FindFirstChildOfClass("UICorner")
			if corner then
				corner.CornerRadius = UDim.new(0, nextTheme.RadiusLarge)
			end
		end
	end))
	return groupData
end

function Section:_add(constructor, options)
	assert(not self.Destroyed, "Section is destroyed")
	local group = self._currentGroup or self:_createGroup()
	if group.Count > 0 then
		local theme = self._context:GetTheme()
		local dividerSlot = Util.Create("Frame", {
			Name = "DividerSlot",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = group.Count * 2,
			Size = UDim2.new(1, 0, 0, 1),
			Parent = group.Content,
		})
		local divider = Util.Create("Frame", {
			Name = "Divider",
			BackgroundColor3 = theme.Border,
			BackgroundTransparency = 0.68,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.new(1, -36, 0, 1),
			Parent = dividerSlot,
		})
		self._maid:Give(self._context:WatchTheme(function(nextTheme)
			if divider.Parent then
				divider.BackgroundColor3 = nextTheme.Border
			end
		end))
	end
	local controlOptions = Util.Copy(options)
	controlOptions.Order = group.Count * 2 + 1
	local control = constructor.new(self._context, group.Content, controlOptions)
	group.Count += 1
	table.insert(self._controls, control)
	return control
end

function Section:_addStandalone(constructor, options)
	assert(not self.Destroyed, "Section is destroyed")
	self:_finishGroup()
	local controlOptions = Util.Copy(options or {})
	controlOptions.Order = controlOptions.Order or self:_nextOrder()
	local control = constructor.new(self._context, self.Body, controlOptions)
	table.insert(self._controls, control)
	return control
end

function Section:AddLabel(options)
	options = type(options) == "string" and { Title = options } or options or {}
	self:_finishGroup()
	local theme = self._context:GetTheme()
	local baseSize = tonumber(options.TextSize) or 15
	local label = Util.Create("TextLabel", {
		Name = options.Id or "Label",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = options.Bold and (theme.FontBold or Enum.Font.GothamBold)
			or (options.Semibold and (theme.FontSemibold or Enum.Font.GothamSemibold)
			or (theme.FontMedium or Enum.Font.GothamMedium)),
		LayoutOrder = self:_nextOrder(),
		Text = options.Title or options.Text or "",
		TextColor3 = options.Color or theme.TextMuted,
		TextSize = baseSize + (theme.TextSizeOffset or 0),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -20, 0, 0),
		Parent = self.Body,
	})
	Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 18),
		PaddingTop = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 10),
		Parent = label,
	})
	self._maid:Give(self._context:WatchTheme(function(nextTheme)
		if label.Parent then
			if options.Color == nil then
				label.TextColor3 = nextTheme.TextMuted
			end
			label.Font = options.Bold and (nextTheme.FontBold or Enum.Font.GothamBold)
				or (options.Semibold and (nextTheme.FontSemibold or Enum.Font.GothamSemibold)
				or (nextTheme.FontMedium or Enum.Font.GothamMedium))
			label.TextSize = baseSize + (nextTheme.TextSizeOffset or 0)
		end
	end))
	local api = {
		Id = options.Id or "Label",
		Root = label,
		Save = false,
		Destroyed = false,
	}
	function api:SetText(value)
		label.Text = tostring(value or "")
	end
	function api:SetVisible(visible)
		label.Visible = visible == true
	end
	function api:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		label:Destroy()
	end
	table.insert(self._controls, api)
	return api
end

function Section:AddDescription(options)
	options = type(options) == "string" and { Text = options } or options or {}
	self:_finishGroup()
	local theme = self._context:GetTheme()
	local baseSize = tonumber(options.TextSize) or 13
	local flowOrder = self:_nextOrder()
