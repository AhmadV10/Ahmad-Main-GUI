function SilenceUI:RegisterIcon(name, asset)
	assert(type(name) == "string" and name ~= "", "Icon name is required")
	assert(type(asset) == "string", "Icon asset must be a string")
	Icons[name] = asset
end

local function iconAsset(value)
	if not value then
		return nil
	end
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(math.floor(value))
	end
	if type(value) == "string" and string.match(value, "^%d+$") then
		return "rbxassetid://" .. value
	end
	return Icons[value] or value
end

local remoteImageCache = {}

local function resolveRemoteImage(value, callback)
	local resolved = iconAsset(value)
	if type(resolved) ~= "string"
		or not string.match(resolved, "^https?://") then
		callback(resolved)
		return
	end
	if remoteImageCache[resolved] then
		callback(remoteImageCache[resolved])
		return
	end
	task.spawn(function()
		local customAsset = getGlobal("getcustomasset") or getGlobal("getsynasset")
		local writeFile = getGlobal("writefile")
		if type(customAsset) ~= "function" or type(writeFile) ~= "function" then
			callback(resolved)
			return
		end
		local extension = string.match(string.lower(resolved), "%.([a-z0-9]+)[^/]*$")
		if extension ~= "png" and extension ~= "jpg" and extension ~= "jpeg" and extension ~= "webp" then
			extension = "png"
		end
		local folder = "SilenceUIAssets"
		local makeFolder = getGlobal("makefolder")
		local isFolder = getGlobal("isfolder")
		if type(makeFolder) == "function" then
			local exists = false
			if type(isFolder) == "function" then
				local ok, result = pcall(isFolder, folder)
				exists = ok and result == true
			end
			if not exists then
				pcall(makeFolder, folder)
			end
		end
		local path = folder
			.. "/"
			.. HttpService:GenerateGUID(false)
			.. "."
			.. extension
		local downloaded, body = pcall(game.HttpGet, game, resolved)
		if not downloaded or type(body) ~= "string" then
			callback(resolved)
			return
		end
		local written = pcall(writeFile, path, body)
		if not written then
			callback(resolved)
			return
		end
		local loaded, asset = pcall(customAsset, path)
		if loaded and type(asset) == "string" then
			remoteImageCache[resolved] = asset
			callback(asset)
		else
			callback(resolved)
		end
	end)
end


local BaseControl = {}
BaseControl.__index = BaseControl

function BaseControl.new(context, parent, options, height)
	assert(type(options) == "table", "Control options are required")
	assert(type(options.Id) == "string" and options.Id ~= "", "Control Id is required")
	assert(type(options.Title) == "string", "Control Title is required")

	local theme = context:GetTheme()
	local root = Util.Create("Frame", {
		Name = options.Id,
		BackgroundColor3 = theme.SurfaceRaised,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = options.Order or 0,
		Size = UDim2.new(1, 0, 0, height or 60),
		Visible = options.Visible ~= false,
		Parent = parent,
	})

	local content = Util.Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -36, 1, 0),
		Parent = root,
	})
	local title = Util.Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = options.Title,
		TextColor3 = theme.Text,
		TextSize = 17,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0.58, 0, 1, 0),
		Parent = content,
	})

	local self = setmetatable({
		Id = options.Id,
		Save = options.Save ~= false,
		Root = root,
		Content = content,
		TitleLabel = title,
		Disabled = options.Disabled == true,
		Visible = options.Visible ~= false,
		Destroyed = false,
		Visible = options.Visible ~= false,
		Badge = options.Badge,
		BadgeStyle = options.BadgeStyle,
		Changed = Signal.new(),
		_maid = Maid.new(),
		_context = context,
		_default = nil,
		_value = nil,
		_callback = nil,
		_renderControl = nil,
	}, BaseControl)

	self._maid:Give(root)
	self._maid:Give(context:WatchTheme(function(nextTheme)
		if self.Destroyed then
			return
		end
		self:_applyBaseTheme(nextTheme)
		if self._renderControl then
			self._renderControl(nextTheme, false)
		end
	end))
	context:RegisterControl(self)
	if options.Tooltip and type(context.AttachTooltip) == "function" then
		self._maid:Give(context:AttachTooltip(root, {
			Text = options.Tooltip,
		Delay = options.TooltipDelay,
		Position = options.TooltipPosition,
		}))
	end
	self:_applyBaseTheme(theme)
	return self
end

function BaseControl:_applyBaseTheme(theme)
	self.Root.BackgroundTransparency = 1
	self.TitleLabel.TextColor3 = self.Disabled and theme.TextDisabled or theme.Text
	self.TitleLabel.Font = theme.FontNormal or Enum.Font.Gotham
	self.TitleLabel.TextSize = (theme.TextSizeOffset or 0) + 17
end

function BaseControl:GetValue()
	return self._value
end

function BaseControl:SetValue(value, silent)
	if self._value == value then
		return
	end
	self._value = value
	if not silent then
		self.Changed:Fire(value)
		Util.SafeCall(self._callback, value)
	end
end

function BaseControl:Reset(silent)
	self:SetValue(Util.DeepCopy(self._default), silent)
end

function BaseControl:SetDisabled(disabled)
	self.Disabled = disabled == true
	self:_applyBaseTheme(self._context:GetTheme())
end

function BaseControl:SetVisible(visible)
	self.Visible = visible == true
	self.Root.Visible = self.Visible
end

function BaseControl:SetTitle(value)
	self.TitleLabel.Text = tostring(value)
end

function BaseControl:SetCallback(callback)
	assert(callback == nil or type(callback) == "function", "Callback must be a function or nil")
	self._callback = callback
end

function BaseControl:SetOrder(order)
	self.Root.LayoutOrder = tonumber(order) or 0
end

function BaseControl:GetDefault()
	return Util.DeepCopy(self._default)
end

function BaseControl:IsDisabled()
	return self.Disabled
end

function BaseControl:IsVisible()
	return self.Visible
end

function BaseControl:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	self._context:UnregisterControl(self)
	self.Changed:Destroy()
	self._maid:Destroy()
end

