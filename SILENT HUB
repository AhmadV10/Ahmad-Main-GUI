function NotificationCenter:Notify(options)
	options = type(options) == "string" and { Title = options } or options or {}
	local theme = self._context:GetTheme()
	local itemMaid = Maid.new()
	local item = Util.Create("Frame", {
		Name = "Notification",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.SurfaceOverlay,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -40, 0, 0),
		ZIndex = 201,
		Parent = self.Root,
	})
	Util.Corner(item, theme.RadiusMedium)
	styleGlass(item, theme, self._context.Quality, nil, "Overlay")
	Util.Padding(item, 12)
	local contentList = Util.List(item, 4)
	local title = Util.Create("TextLabel", {
		Name = "Title",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = theme.FontSemibold or Enum.Font.GothamSemibold,
		Text = options.Title or "Notification",
		TextColor3 = options.Type == "Error" and theme.Danger
			or options.Type == "Success" and theme.Success
			or options.Type == "Warning" and theme.Warning
			or theme.Text,
		TextSize = (theme.TextSizeOffset or 0) + 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 0),
		ZIndex = 202,
		Parent = item,
	})
	local description
	if options.Content or options.Description then
		description = Util.Create("TextLabel", {
			Name = "Description",
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Font = theme.FontNormal or Enum.Font.Gotham,
			Text = options.Content or options.Description,
			TextColor3 = theme.TextMuted,
			TextSize = (theme.TextSizeOffset or 0) + 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, 0),
			ZIndex = 202,
			Parent = item,
		})
	end

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		local tween = Util.Tween(item, self._context:GetMotion("Normal"), {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(60, 0),
		})
		local function finish()
			local index = table.find(self._items, itemMaid)
			if index then
				table.remove(self._items, index)
			end
			itemMaid:Destroy()
		end
		if tween then
			tween.Completed:Once(finish)
		else
			finish()
		end
	end

	if type(options.Actions) == "table" and #options.Actions > 0 then
		local actions = Util.Create("Frame", {
			Name = "Actions",
			BackgroundTransparency = 1,
			LayoutOrder = 100,
			Size = UDim2.new(1, 0, 0, 30),
			ZIndex = 202,
			Parent = item,
		})
		Util.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = actions,
		})
		for index, actionDefinition in ipairs(options.Actions) do
			local actionButton = Util.Create("TextButton", {
				Name = "Action" .. tostring(index),
				AutoButtonColor = false,
				BackgroundColor3 = actionDefinition.Style == "Danger"
					and theme.Danger
					or actionDefinition.Style == "Accent"
						and theme.Accent
						or theme.Control,
				BorderSizePixel = 0,
				Font = theme.FontSemibold or Enum.Font.GothamSemibold,
				LayoutOrder = index,
				Text = actionDefinition.Text or actionDefinition.Title or "Action",
				TextColor3 = (
					actionDefinition.Style == "Danger"
					or actionDefinition.Style == "Accent"
				) and theme.AccentText or theme.Text,
				TextSize = (theme.TextSizeOffset or 0) + 10,
				Size = UDim2.fromOffset(78, 28),
				ZIndex = 203,
				Parent = actions,
			})
			Util.Corner(actionButton, theme.RadiusSmall)
			itemMaid:Give(actionButton.Activated:Connect(function()
				Util.SafeCall(actionDefinition.Callback)
				if actionDefinition.Close ~= false then
					close()
				end
			end))
		end
	end

	itemMaid:Give(item)
	itemMaid:Give(self._context:WatchTheme(function(nextTheme)
		styleGlass(item, nextTheme, self._context.Quality, nil, "Overlay")
		title.TextColor3 = options.Type == "Error" and nextTheme.Danger
			or options.Type == "Success" and nextTheme.Success
			or options.Type == "Warning" and nextTheme.Warning
			or nextTheme.Text
		title.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
		title.TextSize = (nextTheme.TextSizeOffset or 0) + 13
		if description then
			description.TextColor3 = nextTheme.TextMuted
			description.Font = nextTheme.FontNormal or Enum.Font.Gotham
			description.TextSize = (nextTheme.TextSizeOffset or 0) + 11
		end
	end))
	table.insert(self._items, itemMaid)
	Util.Tween(item, self._context:GetMotion("Normal"), {
		Position = UDim2.fromOffset(0, 0),
	})
	if options.Persistent ~= true then
		itemMaid:Give(task.delay(tonumber(options.Duration) or 4, close))
	end
	return {
		Close = close,
	}
end

function NotificationCenter:Destroy()
	for _, maid in ipairs(self._items) do
		maid:Destroy()
	end
	table.clear(self._items)
	self._maid:Destroy()
	self.Root:Destroy()
end

-- Native appearance preferences ---------------------------------------------

local NativePreferences = {
	Folder = "SilenceConfig",
	FileName = "ThemeConfig",
}

local function matchesRgb(color, red, green, blue)
	return typeof(color) == "Color3"
		and math.abs(color.R - red / 255) < 0.0001
		and math.abs(color.G - green / 255) < 0.0001
		and math.abs(color.B - blue / 255) < 0.0001
end

local function migrateNativePreferences(data)
	local version = tonumber(data.Version) or 1
	if version < 4 and type(data.Theme) == "table" then
		local theme = data.Theme
		if matchesRgb(theme.Control, 43, 35, 37) then
			theme.Control = Themes.Silence.Control
		end
		if matchesRgb(theme.ControlHover, 57, 43, 46) then
			theme.ControlHover = Themes.Silence.ControlHover
		end
		if matchesRgb(theme.ControlPressed, 72, 50, 54) then
			theme.ControlPressed = Themes.Silence.ControlPressed
		end
	end
	data.Version = 4
	return data
end

local function encodePreferenceValue(value)
	local kind = typeof(value)
	if kind == "Color3" then
		return {
			__type = "Color3",
			R = value.R,
			G = value.G,
			B = value.B,
		}
	elseif kind == "Vector2" then
		return {
			__type = "Vector2",
			X = value.X,
			Y = value.Y,
		}
	elseif kind == "UDim" then
		return {
			__type = "UDim",
			Scale = value.Scale,
			Offset = value.Offset,
		}
	elseif kind == "UDim2" then
		return {
			__type = "UDim2",
			XScale = value.X.Scale,
			XOffset = value.X.Offset,
			YScale = value.Y.Scale,
			YOffset = value.Y.Offset,
		}
	elseif kind == "EnumItem" then
		return {
			__type = "EnumItem",
			Enum = tostring(value.EnumType):gsub("^Enum%.", ""),
			Name = value.Name,
		}
	elseif kind == "table" then
		local output = {}
		for key, nested in pairs(value) do
			output[key] = encodePreferenceValue(nested)
		end
		return output
	end
	return value
end

local function decodePreferenceValue(value)
	if type(value) ~= "table" then
		return value
	end
	if value.__type == "Color3" then
		return Color3.new(
			tonumber(value.R) or 0,
			tonumber(value.G) or 0,
			tonumber(value.B) or 0
		)
	elseif value.__type == "Vector2" then
		return Vector2.new(tonumber(value.X) or 0, tonumber(value.Y) or 0)
	elseif value.__type == "UDim" then
		return UDim.new(tonumber(value.Scale) or 0, tonumber(value.Offset) or 0)
	elseif value.__type == "UDim2" then
		return UDim2.new(
			tonumber(value.XScale) or 0,
			tonumber(value.XOffset) or 0,
			tonumber(value.YScale) or 0,
			tonumber(value.YOffset) or 0
		)
	elseif value.__type == "EnumItem" then
		local enumType = Enum[value.Enum]
		return enumType and enumType[value.Name] or nil
	end
	local output = {}
	for key, nested in pairs(value) do
		output[key] = decodePreferenceValue(nested)
	end
	return output
end

function NativePreferences:_memory()
	local environment = if getgenv then getgenv() else _G
	environment.__SilenceUIThemeConfig = environment.__SilenceUIThemeConfig or {}
	return environment.__SilenceUIThemeConfig
end

function NativePreferences:_path()
	return self.Folder .. "/" .. self.FileName .. ".json"
end

function NativePreferences:_ensureFolders()
	local makefolderFunction = getGlobal("makefolder")
	if type(makefolderFunction) ~= "function" then
		return
	end
	local isfolderFunction = getGlobal("isfolder")
	for _, folder in ipairs({ self.Folder }) do
		local exists = false
		if type(isfolderFunction) == "function" then
			local ok, result = pcall(isfolderFunction, folder)
			exists = ok and result == true
		end
		if not exists then
			pcall(makefolderFunction, folder)
		end
	end
end

function NativePreferences:Load(id)
	local readfileFunction = getGlobal("readfile")
	local isfileFunction = getGlobal("isfile")
	local path = self:_path()
	local data
	if type(readfileFunction) == "function" then
		local shouldRead = true
		if type(isfileFunction) == "function" then
			local existsOk, exists = pcall(isfileFunction, path)
			shouldRead = existsOk and exists == true
		end
		if shouldRead then
			local readOk, content = pcall(readfileFunction, path)
			if readOk and type(content) == "string" then
				local decodeOk, decoded = pcall(HttpService.JSONDecode, HttpService, content)
				if decodeOk and type(decoded) == "table" then
					data = decodePreferenceValue(decoded)
				end
			end
		end
	end
	data = data or Util.DeepCopy(self:_memory())
	if type(data) ~= "table" or next(data) == nil then
		return nil
	end
	data = migrateNativePreferences(data)
	local windowData = type(data.Windows) == "table" and data.Windows[id] or nil
	return {
		Version = data.Version,
		Theme = Util.DeepCopy(data.Theme),
		ThemeMode = data.ThemeMode,
		Quality = data.Quality,
		Scale = data.Scale,
		ReducedMotion = data.ReducedMotion,
		Minimized = windowData and windowData.Minimized,
		MinimizePosition = windowData and windowData.MinimizePosition,
		WindowPosition = windowData and windowData.WindowPosition,
		WindowSize = windowData and windowData.WindowSize,
		SelectedTab = windowData and windowData.SelectedTab,
	}
end

function NativePreferences:Save(id, data)
	local current = self:LoadRaw()
	current.Version = 4
	current.Theme = Util.DeepCopy(data.Theme)
	current.ThemeMode = data.ThemeMode
	current.Quality = data.Quality
	current.Scale = data.Scale
	current.ReducedMotion = data.ReducedMotion
	current.Windows = type(current.Windows) == "table" and current.Windows or {}
	current.Windows[id] = {
		Minimized = data.Minimized,
		MinimizePosition = data.MinimizePosition,
		WindowPosition = data.WindowPosition,
		WindowSize = data.WindowSize,
		SelectedTab = data.SelectedTab,
	}
	local memory = self:_memory()
	table.clear(memory)
	for key, value in pairs(Util.DeepCopy(current)) do
		memory[key] = value
	end

	local writefileFunction = getGlobal("writefile")
	if type(writefileFunction) ~= "function" then
		return true
	end
	self:_ensureFolders()
	local encodeOk, encoded = pcall(
		HttpService.JSONEncode,
		HttpService,
		encodePreferenceValue(current)
	)
	if not encodeOk then
		return false, encoded
	end
	local path = self:_path()
	local writeOk, message = pcall(writefileFunction, path, encoded)
	return writeOk, message
end

function NativePreferences:LoadRaw()
	local readfileFunction = getGlobal("readfile")
	local isfileFunction = getGlobal("isfile")
	local path = self:_path()
	if type(readfileFunction) == "function" then
		local shouldRead = true
		if type(isfileFunction) == "function" then
			local existsOk, exists = pcall(isfileFunction, path)
			shouldRead = existsOk and exists == true
		end
		if shouldRead then
			local readOk, content = pcall(readfileFunction, path)
			if readOk and type(content) == "string" then
				local decodeOk, decoded = pcall(HttpService.JSONDecode, HttpService, content)
				if decodeOk and type(decoded) == "table" then
					return decodePreferenceValue(decoded)
				end
			end
		end
	end
	return Util.DeepCopy(self:_memory())
end

function NativePreferences:Delete()
	table.clear(self:_memory())
	local deleteFunction = getGlobal("delfile")
	local isfileFunction = getGlobal("isfile")
	local path = self:_path()
	if type(deleteFunction) == "function" and type(isfileFunction) == "function" then
		local existsOk, exists = pcall(isfileFunction, path)
		if existsOk and exists then
			return pcall(deleteFunction, path)
		end
	end
	return true
end

