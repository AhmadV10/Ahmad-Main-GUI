			Text = tostring(value),
			TextColor3 = theme.TextMuted,
			TextSize = (theme.TextSizeOffset or 0) + 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.fromOffset(0, 28),
			Parent = self.Content,
		})
	end
	local leftEndpoint = createEndpoint(
		"LeftEndpoint",
		options.LeftIcon or options.MinIcon or options.LeftText or options.MinLabel or options.StartLabel
	)
	local rightEndpoint = createEndpoint(
		"RightEndpoint",
		options.RightIcon or options.MaxIcon or options.RightText or options.MaxLabel or options.EndLabel
	)

	local function updateLayout()
		if self.Destroyed then
			return
		end
		local compact = self.Content.AbsoluteSize.X > 0 and self.Content.AbsoluteSize.X < 340
		local endpointGap = compact and 8 or 12
		local maxEndpointWidth = math.max(self.Content.AbsoluteSize.X * 0.28, 36)
		local function endpointWidth(endpoint)
			if not endpoint then return 0 end
			if endpoint:IsA("TextLabel") then
				local width = math.clamp(endpoint.TextBounds.X + 2, 22, maxEndpointWidth)
				endpoint.AutomaticSize = Enum.AutomaticSize.None
				endpoint.Size = UDim2.fromOffset(width, 28)
				return width
			end
			return math.max(endpoint.AbsoluteSize.X, 22)
		end
		local leftWidth = endpointWidth(leftEndpoint)
		local rightWidth = endpointWidth(rightEndpoint)
		local hasEndpoints = leftEndpoint ~= nil or rightEndpoint ~= nil

		if hasEndpoints then
			local trackLeft = leftWidth > 0 and leftWidth + endpointGap or 0
			local trackRight = rightWidth > 0 and rightWidth + endpointGap or 0
			self.TitleLabel.Visible = options.ShowTitle ~= false
			self.TitleLabel.Position = UDim2.fromOffset(0, 0)
			self.TitleLabel.Size = UDim2.new(0.58, 0, 0, 24)
			valueLabel.AnchorPoint = Vector2.new(1, 0)
			valueLabel.Position = UDim2.new(1, 0, 0, 3)
			track.Position = UDim2.new(0, trackLeft, 1, -14)
			track.Size = UDim2.new(1, -(trackLeft + trackRight), 0, 7)
			if leftEndpoint then
				leftEndpoint.AnchorPoint = Vector2.new(0, 0.5)
				leftEndpoint.Position = UDim2.new(0, 0, 1, -14)
			end
			if rightEndpoint then
				rightEndpoint.AnchorPoint = Vector2.new(1, 0.5)
				rightEndpoint.Position = UDim2.new(1, 0, 1, -14)
			end
		else
			local trackGap = compact and 12 or 18
			local maxValueWidth = compact and 112 or 150
			local titleWidth = options.ShowTitle == false
					and 0
				or math.clamp(self.TitleLabel.TextBounds.X + 2, 0, self.Content.AbsoluteSize.X * 0.3)
			local valueWidth = options.HideValue == true
					and 0
				or math.clamp(valueLabel.TextBounds.X + 4, 60, maxValueWidth)
			local trackLeft = titleWidth > 0 and titleWidth + trackGap or 0
			local trackRight = valueWidth > 0 and valueWidth + trackGap or 0
			self.TitleLabel.Visible = options.ShowTitle ~= false
			self.TitleLabel.Position = UDim2.fromOffset(0, 0)
			self.TitleLabel.Size = UDim2.new(0, titleWidth, 1, 0)
			valueLabel.AnchorPoint = Vector2.new(1, 0.5)
			valueLabel.Position = UDim2.new(1, 0, 0.5, 0)
			valueLabel.Size = UDim2.fromOffset(valueWidth, 18)
			track.Position = UDim2.new(0, trackLeft, 0.5, 0)
			track.Size = UDim2.new(1, -(trackLeft + trackRight), 0, 7)
		end
	end
	self._maid:Give(self.Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout))
	self._maid:Give(self.TitleLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	self._maid:Give(valueLabel:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	if leftEndpoint and leftEndpoint:IsA("TextLabel") then
		self._maid:Give(leftEndpoint:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	end
	if rightEndpoint and rightEndpoint:IsA("TextLabel") then
		self._maid:Give(rightEndpoint:GetPropertyChangedSignal("TextBounds"):Connect(updateLayout))
	end
	task.defer(updateLayout)

	local activeHandle = nil
	local function ratio(value)
		return (value - minimum) / (maximum - minimum)
	end
	local function valueAt(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then return minimum end
		local position = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		return Util.Round(minimum + position * (maximum - minimum), step)
	end

	local function render(nextTheme, animate)
		local lowRatio = ratio(self._value.Min)
		local highRatio = ratio(self._value.Max)
		local duration = animate and context:GetMotion("Fast") or 0
		track.BackgroundColor3 = nextTheme.Control
		fill.BackgroundColor3 = nextTheme.Accent
		valueLabel.TextColor3 = nextTheme.Accent
		if leftEndpoint and leftEndpoint:IsA("ImageLabel") then
			leftEndpoint.ImageColor3 = nextTheme.TextMuted
		elseif leftEndpoint then
			leftEndpoint.TextColor3 = nextTheme.TextMuted
			leftEndpoint.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
			leftEndpoint.TextSize = (nextTheme.TextSizeOffset or 0) + 13
		end
		if rightEndpoint and rightEndpoint:IsA("ImageLabel") then
			rightEndpoint.ImageColor3 = nextTheme.TextMuted
		elseif rightEndpoint then
			rightEndpoint.TextColor3 = nextTheme.TextMuted
			rightEndpoint.Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold
			rightEndpoint.TextSize = (nextTheme.TextSizeOffset or 0) + 13
		end
		valueLabel.Text = tostring(self._value.Min)
			.. (options.Suffix or "")
			.. " - "
			.. tostring(self._value.Max)
			.. (options.Suffix or "")
		Util.Tween(lowKnob, duration, { Position = UDim2.fromScale(lowRatio, 0.5) })
		Util.Tween(highKnob, duration, { Position = UDim2.fromScale(highRatio, 0.5) })
		Util.Tween(fill, duration, {
			Position = UDim2.fromScale(lowRatio, 0),
			Size = UDim2.new(highRatio - lowRatio, 0, 1, 0),
		})
	end
	self._renderControl = render

	local function fire(silent)
		if not silent then
			local value = Util.DeepCopy(self._value)
			self.Changed:Fire(value)
			Util.SafeCall(self._callback, value.Min, value.Max, value)
		end
	end

	function self:SetValue(value, silent)
		if type(value) ~= "table" then return end
		local low = tonumber(value.Min or value[1])
		local high = tonumber(value.Max or value[2])
		if not low or not high then return end
		low = math.clamp(Util.Round(low, step), minimum, maximum)
		high = math.clamp(Util.Round(high, step), minimum, maximum)
		if low > high then low, high = high, low end
		self._value = { Min = low, Max = high }
		render(context:GetTheme(), true)
		fire(silent)
	end

	function self:SetRange(low, high, silent)
		self:SetValue({ Min = low, Max = high }, silent)
	end

	local function updateFromX(x)
		local value = valueAt(x)
		if activeHandle == "Min" then
			self._value.Min = math.min(value, self._value.Max)
		else
			self._value.Max = math.max(value, self._value.Min)
		end
		render(context:GetTheme(), false)
		fire(false)
	end

	self._maid:Give(track.InputBegan:Connect(function(input)
		if self.Disabled or not Util.IsPrimaryInput(input) then return end
		local clicked = valueAt(input.Position.X)
		activeHandle = math.abs(clicked - self._value.Min) <= math.abs(clicked - self._value.Max)
			and "Min"
			or "Max"
		updateFromX(input.Position.X)
		local dragMaid = Maid.new()
		self._maid:Set("RangeDrag", dragMaid)
		dragMaid:Give(UserInputService.InputChanged:Connect(function(changedInput)
			if changedInput.UserInputType == Enum.UserInputType.MouseMovement
				or changedInput.UserInputType == Enum.UserInputType.Touch then
				updateFromX(changedInput.Position.X)
			end
		end))
		dragMaid:Give(input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				activeHandle = nil
				self._maid:Set("RangeDrag", nil)
			end
		end))
	end))

	render(theme, false)
	return self
end

