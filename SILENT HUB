	local knob = Util.Create("Frame", {
		Name = "Knob",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = self._value and UDim2.fromOffset(29, 3) or UDim2.fromOffset(3, 3),
		Size = UDim2.fromOffset(26, 26),
		Parent = track,
	})
	Util.Corner(knob, 13)

	local function render(nextTheme, animate)
		local duration = animate and context:GetMotion("Fast") or 0
		local surface = track:FindFirstChild("GlassSurface")
		if self._value then
			if surface then
				surface.Visible = false
			end
			track.BackgroundTransparency = 0
			Util.Tween(track, duration, {
				BackgroundColor3 = options.Color or nextTheme.Accent,
			})
			trackStroke.Color = options.Color or nextTheme.Accent
			trackStroke.Transparency = 1
		else
			styleGlass(track, nextTheme, context.Quality, nil, "Inset")
			surface = track:FindFirstChild("GlassSurface")
			if surface then
				surface.Visible = true
			end
			trackStroke.Color = nextTheme.Accent
			trackStroke.Transparency = 0
		end
		Util.Tween(knob, duration, {
			Position = self._value and UDim2.fromOffset(29, 3) or UDim2.fromOffset(3, 3),
		})
	end
	self._renderControl = render

	function self:SetValue(value, silent)
		if type(value) ~= "boolean" or self._value == value then
			return
		end
		self._value = value
		render(context:GetTheme(), true)
		if not silent then
			self.Changed:Fire(value)
			Util.SafeCall(self._callback, value)
		end
	end

	self._maid:Give(track.Activated:Connect(function()
		if not self.Disabled then
			self:SetValue(not self._value)
		end
	end))

	function self:Toggle(silent)
		self:SetValue(not self._value, silent)
	end
	render(theme, false)
	return self
end

