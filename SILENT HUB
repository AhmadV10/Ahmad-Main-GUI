local TableControl = {}

function TableControl.new(context, parent, options)
	local theme = context:GetTheme()
	local columns = options.Columns or {}
	local data = Util.DeepCopy(options.Data or {})
	local maxRows = math.clamp(tonumber(options.MaxRows) or 100, 1, 1000)
	local rowHeight = math.max(tonumber(options.RowHeight) or 32, 24)
	local visibleRows = math.clamp(tonumber(options.VisibleRows) or 6, 2, 16)
	local height = 42 + rowHeight * visibleRows
	local root = Util.Create("Frame", {
		Name = options.Id or "Table",
		BackgroundColor3 = theme.SurfaceRaised,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		LayoutOrder = options.Order or 0,
		Size = UDim2.new(1, 0, 0, height),
		Parent = parent,
	})
	Util.Corner(root, theme.RadiusLarge)
	local rootStroke = Util.Stroke(root, theme.Border, 0.82, 1)
	rootStroke.Name = "GlassStroke"
	styleGlass(root, theme, context.Quality, nil, "Panel")
	local header = Util.Create("Frame", {
		Name = "Header",
		BackgroundColor3 = theme.Control,
		BackgroundTransparency = 0.16,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 36),
		Parent = root,
	})
	styleGlass(header, theme, context.Quality, nil, "Inset")
	local body = Util.Create("ScrollingFrame", {
		Name = "Body",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarImageColor3 = theme.TextMuted,
		ScrollBarThickness = 3,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 1, -36),
		Parent = root,
	})
	Util.List(body, 1)

	local maid = Maid.new()
	maid:Give(root)
	local renderMaid = Maid.new()
	maid:Set("Render", renderMaid)
	local sortKey = nil
	local sortAscending = true
	local selectedIndex = nil
	local rowObjects = {}
	local columnObjects = {}

	local function normalizedColumns()
		local result = {}
		for index, column in ipairs(columns) do
			if type(column) == "string" then
				table.insert(result, {
					Key = column,
					Title = column,
					Width = 1,
					Index = index,
				})
			elseif type(column) == "table" then
				table.insert(result, {
					Key = column.Key or column.Id or tostring(index),
					Title = column.Title or column.Name or column.Key or tostring(index),
					Width = math.max(tonumber(column.Width) or 1, 0.1),
					Format = column.Format,
					Index = index,
				})
			end
		end
		return result
	end

	local function sortedData()
		local result = Util.DeepCopy(data)
		if sortKey then
			table.sort(result, function(a, b)
				local left = a[sortKey]
				local right = b[sortKey]
				if left == right then return false end
				if type(left) == type(right) and (type(left) == "number" or type(left) == "string") then
					return sortAscending and left < right or left > right
				end
				left = tostring(left)
				right = tostring(right)
				return sortAscending and left < right or left > right
			end)
		end
		return result
	end

	local function clearRendered()
		renderMaid:Destroy()
		renderMaid = Maid.new()
		maid:Set("Render", renderMaid)
		for _, object in ipairs(rowObjects) do object:Destroy() end
		for _, object in ipairs(columnObjects) do object:Destroy() end
		table.clear(rowObjects)
		table.clear(columnObjects)
	end

	local function render()
		clearRendered()
		local nextTheme = context:GetTheme()
		local normalized = normalizedColumns()
		local totalWeight = 0
		for _, column in ipairs(normalized) do totalWeight += column.Width end
		totalWeight = math.max(totalWeight, 1)

		local xScale = 0
		for _, column in ipairs(normalized) do
			local widthScale = column.Width / totalWeight
			local headerButton = Util.Create("TextButton", {
				Name = tostring(column.Key),
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = nextTheme.FontSemibold or Enum.Font.GothamSemibold,
				Text = tostring(column.Title)
					.. (sortKey == column.Key and (sortAscending and "  ^" or "  v") or ""),
				TextColor3 = nextTheme.TextMuted,
				TextSize = (nextTheme.TextSizeOffset or 0) + 10,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.new(xScale, 8, 0, 0),
				Size = UDim2.new(widthScale, -12, 1, 0),
				Parent = header,
			})
			table.insert(columnObjects, headerButton)
			renderMaid:Give(headerButton.Activated:Connect(function()
				if sortKey == column.Key then
					sortAscending = not sortAscending
				else
					sortKey = column.Key
					sortAscending = true
				end
				render()
			end))
			xScale += widthScale
		end

		local rows = sortedData()
		for index = 1, math.min(#rows, maxRows) do
			local rowData = rows[index]
			local row = Util.Create("TextButton", {
				Name = "Row_" .. tostring(index),
				AutoButtonColor = false,
				BackgroundColor3 = selectedIndex == index and nextTheme.Accent or nextTheme.SurfaceRaised,
				BackgroundTransparency = selectedIndex == index and 0.16
					or (index % 2 == 0 and 0.32 or 0.44),
				BorderSizePixel = 0,
				LayoutOrder = index,
				Text = "",
				Size = UDim2.new(1, 0, 0, rowHeight),
				Parent = body,
			})
			table.insert(rowObjects, row)
			local rowX = 0
			for _, column in ipairs(normalized) do
				local widthScale = column.Width / totalWeight
				local value = rowData[column.Key]
				if type(column.Format) == "function" then
					local ok, formatted = pcall(column.Format, value, rowData, index)
					if ok then value = formatted end
				end
				Util.Create("TextLabel", {
					Name = tostring(column.Key),
					BackgroundTransparency = 1,
					Font = nextTheme.FontNormal or Enum.Font.Gotham,
					Text = tostring(value == nil and "" or value),
					TextColor3 = selectedIndex == index and nextTheme.AccentText or nextTheme.Text,
					TextSize = (nextTheme.TextSizeOffset or 0) + 10,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(rowX, 8, 0, 0),
					Size = UDim2.new(widthScale, -12, 1, 0),
					Parent = row,
				})
				rowX += widthScale
			end
			renderMaid:Give(row.Activated:Connect(function()
				selectedIndex = index
				render()
				Util.SafeCall(options.OnSelected, rowData, index)
			end))
		end
	end

	local api = {
		Id = options.Id or "Table",
		Save = false,
		Root = root,
		Destroyed = false,
	}

	function api:SetData(nextData)
		assert(type(nextData) == "table", "Table data must be a table")
		data = Util.DeepCopy(nextData)
		selectedIndex = nil
		render()
	end

	function api:GetData()
		return Util.DeepCopy(data)
	end

	function api:AddRow(row)
		table.insert(data, Util.DeepCopy(row))
		render()
	end

	function api:RemoveRow(index)
		if type(index) ~= "number" or not data[index] then
			return false
		end
		table.remove(data, index)
		selectedIndex = nil
		render()
		return true
	end

	function api:SetColumns(nextColumns)
		assert(type(nextColumns) == "table", "Columns must be a table")
		columns = Util.DeepCopy(nextColumns)
		sortKey = nil
		render()
	end

	function api:Sort(key, ascending)
		sortKey = key
		sortAscending = ascending ~= false
		render()
	end

	function api:SetVisible(visible)
		root.Visible = visible == true
	end

	function api:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		maid:Destroy()
	end

	maid:Give(context:WatchTheme(function(nextTheme)
		styleGlass(root, nextTheme, context.Quality, nil, "Panel")
		styleGlass(header, nextTheme, context.Quality, nil, "Inset")
		body.ScrollBarImageColor3 = nextTheme.TextMuted
		render()
	end))
	render()
	return api
end

