function Window:FitToViewport(margin)
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	margin = math.max(tonumber(margin) or 18, 0)
	local viewport = camera.ViewportSize
	local maximum = Vector2.new(
		math.max(viewport.X - margin * 2, 320),
		math.max(viewport.Y - margin * 2, 260)
	)
	local current = self.Frame.AbsoluteSize
	local nextWidth = math.min(current.X, maximum.X / self.Scale)
	local nextHeight = math.min(current.Y, maximum.Y / self.Scale)
	if nextWidth ~= current.X or nextHeight ~= current.Y then
		self.Frame.Size = UDim2.fromOffset(nextWidth, nextHeight)
		self._restoreSize = self.Frame.Size
	end
	self.Frame.Position = UDim2.fromScale(0.5, 0.5)
	return true
end

