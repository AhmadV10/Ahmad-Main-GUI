function Window:SelectRelativeTab(direction)
	direction = direction and direction < 0 and -1 or 1
	if #self._tabs == 0 then
		return false
	end
	local currentIndex = 0
	for index, tab in ipairs(self._tabs) do
		if tab.Id == self._selectedTab then
			currentIndex = index
			break
		end
	end
	for offset = 1, #self._tabs do
		local index = ((currentIndex - 1 + direction * offset) % #self._tabs) + 1
		local tab = self._tabs[index]
		if tab.Visible and not tab.Disabled then
			self:SelectTab(tab.Id)
			return true
		end
	end
	return false
end

function Window:EnableTabShortcuts()
	self._maid:Set("TabShortcuts", UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.Tab then
			return
		end
		local controlDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		if not controlDown then
			return
		end
		local shiftDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		self:SelectRelativeTab(shiftDown and -1 or 1)
	end))
end

