function Tab:GetSection(id)
	for _, section in ipairs(self._sections) do
		if section.Id == id and not section.Destroyed then
			return section
		end
	end
	return nil
end

function Tab:RemoveSection(id)
	for index, section in ipairs(self._sections) do
