				Content = "The config '" .. tostring(name or "") .. "' will be deleted permanently.",
				Danger = true,
				ConfirmText = "Delete",
				Buttons = {
					{
						Text = "Cancel",
						Value = false,
					},
					{
						Text = "Delete",
						Value = true,
						Style = "Danger",
						Callback = function()
							local success, message = manager:Delete(name)
							self:Notify({
								Title = success and "Config deleted" or "Delete failed",
								Content = success and name or message,
								Type = success and "Success" or "Error",
							})
							if success then refreshList() end
						end,
					},
				},
			})
		end,
	})
	persistence:AddToggle({
		Id = "__AutoSave",
		Title = "Auto save",
		Default = manager.AutoSave,
		Save = false,
		OnChanged = function(value)
			manager:SetAutoSave(value)
