end

local function resolveQuality(requested, viewport)
	if requested ~= nil and requested ~= "Auto" then
		return requested
	end
	viewport = viewport or Vector2.new(1280, 720)
	if UserInputService.TouchEnabled and viewport.X < 900 then
		return "Low"
	end
	if viewport.X * viewport.Y > 2560 * 1440 then
		return "Medium"
	end
	return "High"
end

local function styleGlass(frame, theme, quality, overrideTransparency, profile, tintOverride)
	profile = profile or "Surface"
	local glassBorder = theme.Dark and Color3.fromRGB(84, 84, 88) or theme.GlassBorder
	local transparency
	if profile == "Overlay" then
		transparency = quality == "Low" and 0.035
			or theme.Dark and 0.055
			or 0.075
	elseif profile == "Inset" then
		transparency = quality == "Low" and (theme.Dark and 0.16 or 0.08)
			or quality == "Medium" and (theme.Dark and 0.22 or 0.12)
			or (theme.Dark and 0.28 or 0.16)
	elseif profile == "Panel" then
		local tierTransparency = quality == "Low" and 0.02
			or quality == "Medium" and 0.07
			or 0.1
		transparency = overrideTransparency ~= nil
			and math.clamp(overrideTransparency, 0, 0.14)
			or math.min(theme.GlassTransparency, tierTransparency)
	else
		transparency = overrideTransparency ~= nil
			and math.clamp(overrideTransparency, 0, 0.38)
			or math.clamp(theme.GlassTransparency, 0.04, 0.28)
	end

	local insetAccent = tintOverride or theme.Accent
	local insetTint = theme.Dark and theme.SurfaceOverlay or theme.SurfaceRaised
	frame.BackgroundColor3 = profile == "Overlay"
			and (theme.Dark and theme.SurfaceOverlay or theme.GlassTint:Lerp(theme.SurfaceRaised, 0.86))
		or profile == "Inset"
			and insetTint
		or theme.GlassTint
	frame.BackgroundTransparency = transparency

	local stroke = frame:FindFirstChild("GlassStroke")
	if not stroke then
		stroke = Util.Stroke(frame, glassBorder, 0.55, theme.StrokeThickness)
		stroke.Name = "GlassStroke"
	end
	stroke.Color = glassBorder
	stroke.Thickness = theme.StrokeThickness
	stroke.Transparency = profile == "Inset"
			and 0
		or theme.Dark
			and (quality == "Low" and 0.62 or quality == "Medium" and 0.54 or 0.48)
		or (quality == "Low" and 0.5 or quality == "Medium" and 0.36 or 0.24)
	if profile == "Inset" then
		stroke.Color = insetAccent
	end

	local supportsSurfaceGradient = frame:IsA("Frame")
		or frame:IsA("ScrollingFrame")
		or frame:IsA("CanvasGroup")
	local gradientParent = frame
	if not supportsSurfaceGradient then
		local oldGradient = frame:FindFirstChild("GlassGradient")
		if oldGradient then
			oldGradient:Destroy()
		end
		local isTextBox = frame:IsA("TextBox")
		local surfaceParent = isTextBox and frame.Parent or frame
		local surfaceName = isTextBox and (frame.Name .. "GlassSurface") or "GlassSurface"
		local surface = surfaceParent and surfaceParent:FindFirstChild(surfaceName)
		if not surface then
			surface = Util.Create("Frame", {
				Name = surfaceName,
				Active = false,
				BackgroundColor3 = insetTint,
				BackgroundTransparency = 0.34,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0, 0),
				Size = UDim2.fromScale(1, 1),
				ZIndex = math.max(frame.ZIndex - 1, 0),
				Parent = surfaceParent,
			})
		end
		surface.BackgroundColor3 = insetTint
		surface.BackgroundTransparency = overrideTransparency ~= nil
				and math.clamp(overrideTransparency, 0.08, 0.5)
			or 0
		surface.ZIndex = math.max(frame.ZIndex - 1, 0)
		frame.BackgroundTransparency = 1
		local padding = not isTextBox and frame:FindFirstChildOfClass("UIPadding") or nil
		if isTextBox then
			surface.AnchorPoint = frame.AnchorPoint
			surface.Position = frame.Position
			surface.Size = frame.Size
			surface.Rotation = frame.Rotation
		elseif padding then
			surface.Position = UDim2.new(
				-padding.PaddingLeft.Scale,
				-padding.PaddingLeft.Offset,
				-padding.PaddingTop.Scale,
				-padding.PaddingTop.Offset
			)
			surface.Size = UDim2.new(
				1 + padding.PaddingLeft.Scale + padding.PaddingRight.Scale,
				padding.PaddingLeft.Offset + padding.PaddingRight.Offset,
				1 + padding.PaddingTop.Scale + padding.PaddingBottom.Scale,
				padding.PaddingTop.Offset + padding.PaddingBottom.Offset
			)
		else
			surface.Position = UDim2.fromScale(0, 0)
			surface.Size = UDim2.fromScale(1, 1)
		end
		local parentCorner = frame:FindFirstChildOfClass("UICorner")
		local surfaceCorner = surface:FindFirstChildOfClass("UICorner")
		if not surfaceCorner then
			surfaceCorner = Util.Corner(surface, parentCorner and parentCorner.CornerRadius.Offset or theme.RadiusSmall)
		end
		if parentCorner then
			surfaceCorner.CornerRadius = parentCorner.CornerRadius
		end
		gradientParent = surface
	end
	local gradient = gradientParent:FindFirstChild("GlassGradient")
	if not gradient then
		gradient = Util.Create("UIGradient", {
			Name = "GlassGradient",
			Rotation = 110,
			Parent = gradientParent,
		})
	end
	if profile == "Inset" then
		gradientParent.BackgroundColor3 = insetTint
		gradientParent.BackgroundTransparency = 0
		local glow = gradientParent:FindFirstChild("AccentGlow")
		if glow then
			glow:Destroy()
		end
		gradient.Rotation = -35
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.Dark and Color3.fromRGB(6, 6, 8) or theme.SurfaceRaised),
			ColorSequenceKeypoint.new(0.54, theme.Dark and Color3.fromRGB(12, 12, 15) or theme.GlassTint),
			ColorSequenceKeypoint.new(0.78, insetAccent),
			ColorSequenceKeypoint.new(1, insetAccent),
		})
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, theme.Dark and 0.18 or 0.28),
			NumberSequenceKeypoint.new(0.54, theme.Dark and 0.24 or 0.42),
			NumberSequenceKeypoint.new(0.78, 0),
			NumberSequenceKeypoint.new(1, 0),
		})
	elseif profile == "Overlay" then
		if theme.Dark then
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(0.46, Color3.fromRGB(248, 248, 250)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(236, 236, 240)),
			})
		else
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, theme.GlassHighlight),
				ColorSequenceKeypoint.new(0.14, theme.SurfaceRaised),
				ColorSequenceKeypoint.new(
					0.58,
					theme.GlassTint:Lerp(theme.SurfaceRaised, 0.84)
				),
				ColorSequenceKeypoint.new(
					1,
					theme.SurfaceRaised:Lerp(theme.GlassTint, 0.16)
				),
			})
		end
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0),
		})
	elseif quality == "Low" then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.GlassHighlight),
			ColorSequenceKeypoint.new(0.28, theme.GlassTint),
			ColorSequenceKeypoint.new(1, theme.Surface),
		})
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.82),
			NumberSequenceKeypoint.new(1, 0.92),
		})
	elseif quality == "Medium" then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.GlassHighlight),
			ColorSequenceKeypoint.new(0.28, theme.GlassTint),
			ColorSequenceKeypoint.new(1, theme.Surface),
		})
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.58),
			NumberSequenceKeypoint.new(0.38, 0.86),
			NumberSequenceKeypoint.new(1, 0.72),
		})
	else
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.GlassHighlight),
			ColorSequenceKeypoint.new(0.28, theme.GlassTint),
			ColorSequenceKeypoint.new(1, theme.Surface),
		})
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.38),
			NumberSequenceKeypoint.new(0.22, 0.76),
			NumberSequenceKeypoint.new(0.58, 0.9),
			NumberSequenceKeypoint.new(1, 0.62),
		})
	end
end


