-- Dropdown -------------------------------------------------------------------

local DropdownControl = {}

local function normalizeDropdownOptions(options)
	local normalized = {}
	for _, option in ipairs(options or {}) do
		if type(option) == "string" then
			table.insert(normalized, {
				Id = option,
				Title = option,
			})
		elseif type(option) == "table" and type(option.Id) == "string" then
			table.insert(normalized, {
				Id = option.Id,
				Title = option.Title or option.Id,
				Icon = option.Icon,
			})
		end
	end
	return normalized
end

function DropdownControl.new(context, parent, options)
	local choices = normalizeDropdownOptions(options.Options)
	local multi = options.Multi == true
	local first = choices[1] and choices[1].Id or ""
	local default = multi and Util.DeepCopy(options.DefaultMulti or {}) or (options.Default or first)

	local self = BaseControl.new(context, parent, options, 62)
	self._default = default
	self._value = Util.DeepCopy(default)
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	local useOptionFont = options.UseOptionFont == true or options.Id == "__FontFamily"
	local selectButton = Util.Create("TextButton", {
		Name = "Select",
		AutoButtonColor = false,
		BackgroundColor3 = theme.ControlHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.52, 0, 1, 0),
		Parent = self.Content,
	})
	Util.BindFocusRing(selectButton, function() return context:GetTheme() end, self._maid)
	local selectedLabel = Util.Create("TextLabel", {
		Name = "Selected",
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = theme.TextMuted,
		TextSize = 17,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, -28, 1, 0),
		Parent = selectButton,
	})
	local arrow = Util.Create("ImageLabel", {
		Name = "Arrow",
		BackgroundTransparency = 1,
		Image = iconAsset("chevron"),
		ImageColor3 = theme.TextMuted,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Rotation = 0,
		Size = UDim2.fromOffset(14, 14),
		Parent = selectButton,
	})

	local contentHeight = #choices > 0 and (#choices * 41 + 11) or 12
	local isScrollable = contentHeight > 218
	local menuHeight = isScrollable and 218 or contentHeight
	local scrollBarThickness = isScrollable and 3 or 0

	local menu = Util.Create("ScrollingFrame", {
		Name = "DropdownMenu",
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		BackgroundColor3 = theme.SurfaceRaised,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(0, 0, 0, contentHeight),
		ClipsDescendants = true,
		ScrollBarImageColor3 = theme.TextMuted,
		ScrollBarThickness = scrollBarThickness,
		Visible = false,
		ZIndex = 2000,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(),
		Size = UDim2.fromOffset(220, menuHeight),
		Parent = context.Root,
	})
	self._maid:Give(menu)
	local menuShadow = Util.Create("Frame", {
		Name = "DropdownShadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 1999,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(),
		Size = UDim2.fromOffset(222, menuHeight + 2),
		Parent = context.Root,
	})
	self._maid:Give(menuShadow)
	Util.Corner(menuShadow, theme.RadiusLarge + 1)
	local menuShadowScale = Util.Create("UIScale", {
		Scale = context.Scale or 1,
		Parent = menuShadow,
	})
	local menuScale = Util.Create("UIScale", {
		Scale = context.Scale or 1,
		Parent = menu,
	})
	Util.Corner(menu, theme.RadiusLarge)
	Util.Padding(menu, 6)
	Util.List(menu, 1)

	local isOpen = false
	local optionButtons = {}
	local choiceMaid = Maid.new()
	self._maid:Set("DropdownChoices", choiceMaid)

	local function contains(id)
		return multi and table.find(self._value, id) ~= nil or self._value == id
	end

	local function displayText()
		if not multi then
			for _, choice in ipairs(choices) do
				if choice.Id == self._value then
					return choice.Title
				end
			end
			return options.Placeholder or "Select"
		end

		if #self._value == 0 then
			return options.Placeholder or "None"
		elseif #self._value > 2 then
			return tostring(#self._value) .. " selected"
		end

		local names = {}
		for _, id in ipairs(self._value) do
			for _, choice in ipairs(choices) do
				if choice.Id == id then
					table.insert(names, choice.Title)
					break
				end
			end
		end
		return table.concat(names, ", ")
	end

	local function render(nextTheme, animate)
		selectButton.BackgroundColor3 = nextTheme.ControlHover
		selectButton.BackgroundTransparency = 1
		selectedLabel.TextColor3 = nextTheme.TextMuted
		selectedLabel.Font = (useOptionFont and not multi) and getFontVariant(self._value, "Normal") or (nextTheme.FontNormal or Enum.Font.Gotham)
		selectedLabel.TextSize = (nextTheme.TextSizeOffset or 0) + 17
		selectedLabel.Text = displayText()
		arrow.ImageColor3 = nextTheme.TextMuted
		styleGlass(menu, nextTheme, context.Quality, nil, "Overlay")
		menuShadow.BackgroundTransparency = 1
		menu.ScrollBarImageColor3 = nextTheme.TextMuted
		if menuScale then
			menuScale.Scale = context.Scale or 1
		end
		menuShadowScale.Scale = context.Scale or 1
		Util.Tween(arrow, animate and context:GetMotion("Fast") or 0, {
			Rotation = isOpen and -90 or 0,
		})
		for id, button in pairs(optionButtons) do
			local selected = contains(id)
			local check = button:FindFirstChild("Check")
			if check then
				check.Visible = selected
				check.ImageColor3 = nextTheme.Accent
			end
			local title = button:FindFirstChild("Title")
			if title then
				title.TextColor3 = nextTheme.Text
				if not useOptionFont then
					title.Font = nextTheme.FontNormal or Enum.Font.Gotham
				end
				title.TextSize = (nextTheme.TextSizeOffset or 0) + 13
			end
			button.BackgroundColor3 = nextTheme.SurfaceRaised
		end
	end
	self._renderControl = render

	for _, choice in ipairs(choices) do
		local optionButton = Util.Create("TextButton", {
			Name = choice.Id,
			Active = true,
			AutoButtonColor = false,
			BackgroundColor3 = theme.SurfaceRaised,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			Size = UDim2.new(1, 0, 0, 40),
			ZIndex = 2001,
			Parent = menu,
		})
		Util.Corner(optionButton, theme.RadiusSmall)
		
		local check = Util.Create("ImageLabel", {
			Name = "Check",
			BackgroundTransparency = 1,
			Image = iconAsset("check"),
			ImageColor3 = theme.Accent,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 8, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			Visible = contains(choice.Id),
			ZIndex = 2002,
			Parent = optionButton,
		})

		local title = Util.Create("TextLabel", {
			Name = "Title",
			BackgroundTransparency = 1,
			Font = useOptionFont and getFontVariant(choice.Id, "Normal") or (theme.FontNormal or Enum.Font.Gotham),
			Text = choice.Title,
			TextColor3 = theme.Text,
			TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			Position = UDim2.fromOffset(28, 0),
			Size = UDim2.new(1, -34, 1, 0),
			ZIndex = 2002,
			Parent = optionButton,
		})

		choiceMaid:Give(optionButton.MouseEnter:Connect(function()
			Util.Tween(optionButton, context:GetMotion("Fast") or 0.15, {
				BackgroundTransparency = 0.7,
			})
		end))
		choiceMaid:Give(optionButton.MouseLeave:Connect(function()
			Util.Tween(optionButton, context:GetMotion("Fast") or 0.15, {
				BackgroundTransparency = 1,
			})
		end))

		optionButtons[choice.Id] = optionButton
		choiceMaid:Give(optionButton.Activated:Connect(function()
			if multi then
				local nextValue = table.clone(self._value)
				local index = table.find(nextValue, choice.Id)
				if index then
					table.remove(nextValue, index)
				else
					table.insert(nextValue, choice.Id)
				end
				self:SetValue(nextValue)
			else
				self:SetValue(choice.Id)
				isOpen = false
				task.defer(function()
					menu.Visible = false
					menuShadow.Visible = false
				end)
				context:SetScrollingEnabled(true)
				self._maid:Remove("DropdownOutsideClick")
			end
			render(context:GetTheme(), true)
		end))
	end

	function self:SetValue(value, silent)
		local nextValue
		if multi then
			if type(value) ~= "table" then
				return
			end
			nextValue = {}
			for _, id in ipairs(value) do
				for _, choice in ipairs(choices) do
					if id == choice.Id and not table.find(nextValue, id) then
						table.insert(nextValue, id)
						break
					end
				end
			end
		else
			if type(value) ~= "string" then
				return
			end
			local valid = false
			for _, choice in ipairs(choices) do
				if choice.Id == value then
					valid = true
					break
				end
			end
			if not valid then
				return
			end
			nextValue = value
		end

		self._value = nextValue
		render(context:GetTheme(), false)
		if not silent then
			self.Changed:Fire(Util.DeepCopy(nextValue))
			Util.SafeCall(self._callback, Util.DeepCopy(nextValue))
		end
	end

	function self:SetOptions(nextOptions, preserveValue)
		choices = normalizeDropdownOptions(nextOptions)
		choiceMaid:Destroy()
		choiceMaid = Maid.new()
		self._maid:Set("DropdownChoices", choiceMaid)
		for _, button in pairs(optionButtons) do
			button:Destroy()
		end
		table.clear(optionButtons)
		if not preserveValue then
			self._value = multi and {} or (choices[1] and choices[1].Id or "")
		end
		-- Runtime replacement intentionally rebuilds only menu rows, not the control.
		for _, choice in ipairs(choices) do
			local optionButton = Util.Create("TextButton", {
				Name = choice.Id,
				Active = true,
				AutoButtonColor = false,
					BackgroundColor3 = context:GetTheme().SurfaceRaised,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = "",
				Size = UDim2.new(1, 0, 0, 40),
				ZIndex = 2001,
				Parent = menu,
			})
			Util.Corner(optionButton, context:GetTheme().RadiusSmall)
			
			local check = Util.Create("ImageLabel", {
				Name = "Check",
				BackgroundTransparency = 1,
				Image = iconAsset("check"),
				ImageColor3 = context:GetTheme().Accent,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				Visible = contains(choice.Id),
				ZIndex = 2002,
				Parent = optionButton,
			})

			local title = Util.Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				Text = choice.Title,
				TextColor3 = context:GetTheme().Text,
				TextSize = 13,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Position = UDim2.fromOffset(28, 0),
				Size = UDim2.new(1, -34, 1, 0),
				ZIndex = 2002,
				Parent = optionButton,
			})

			choiceMaid:Give(optionButton.MouseEnter:Connect(function()
				Util.Tween(optionButton, context:GetMotion("Fast") or 0.15, {
					BackgroundTransparency = 0.7,
				})
			end))
			choiceMaid:Give(optionButton.MouseLeave:Connect(function()
				Util.Tween(optionButton, context:GetMotion("Fast") or 0.15, {
					BackgroundTransparency = 1,
				})
			end))

			optionButtons[choice.Id] = optionButton
			choiceMaid:Give(optionButton.Activated:Connect(function()
				if multi then
					local nextValue = table.clone(self._value)
					local index = table.find(nextValue, choice.Id)
					if index then
						table.remove(nextValue, index)
					else
						table.insert(nextValue, choice.Id)
					end
					self:SetValue(nextValue)
				else
					self:SetValue(choice.Id)
					isOpen = false
					task.defer(function()
						menu.Visible = false
						menuShadow.Visible = false
					end)
					self._maid:Remove("DropdownOutsideClick")
				end
			end))
		end
		local nextContentHeight = #choices > 0 and (#choices * 41 + 11) or 12
		local nextIsScrollable = nextContentHeight > 218
		local nextMenuHeight = nextIsScrollable and 218 or nextContentHeight
		local nextScrollBarThickness = nextIsScrollable and 3 or 0

		menu.Size = UDim2.fromOffset(220, nextMenuHeight)
		menuShadow.Size = UDim2.fromOffset(222, nextMenuHeight + 2)
		menu.CanvasSize = UDim2.new(0, 0, 0, nextContentHeight)
		menu.ScrollBarThickness = nextScrollBarThickness
		render(context:GetTheme(), false)
	end

	self._maid:Give(selectButton.Activated:Connect(function()
		if self.Disabled then
			return
		end
		isOpen = not isOpen
		
		if isOpen then
			context:SetScrollingEnabled(false)
			local popupPosition = Util.PositionPopup(menu, selectButton, context.Scale, 6, 8)
			menuShadow.Position = UDim2.fromOffset(popupPosition.X + 1, popupPosition.Y + 2)

			-- Outside-click detector
			local connection
			connection = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local mousePos = input.Position
					local function isInside(guiObject)
						local pos = guiObject.AbsolutePosition
						local size = guiObject.AbsoluteSize
						return mousePos.X >= pos.X and mousePos.X <= pos.X + size.X
							and mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y
					end
					
					if not isInside(menu) and not isInside(selectButton) then
						isOpen = false
						menu.Visible = false
						menuShadow.Visible = false
						context:SetScrollingEnabled(true)
						render(context:GetTheme(), true)
						self._maid:Remove("DropdownOutsideClick")
					end
				end
			end)
			self._maid:Set("DropdownOutsideClick", connection)
		else
			context:SetScrollingEnabled(true)
			self._maid:Remove("DropdownOutsideClick")
		end

		menu.Visible = isOpen
		menuShadow.Visible = isOpen
		render(context:GetTheme(), true)
	end))

	self._maid:Give(function()
		if isOpen then
			context:SetScrollingEnabled(true)
		end
	end)
	render(theme, false)
	return self
end

-- Keybind --------------------------------------------------------------------

local KeybindControl = {}

function KeybindControl.new(context, parent, options)
	local self = BaseControl.new(context, parent, options, 58)
	self._default = options.Default or Enum.KeyCode.Unknown
	self._value = self._default
	self._callback = options.OnChanged

	local theme = context:GetTheme()
	local captureButton = Util.Create("TextButton", {
		Name = "Keybind",
		AutoButtonColor = false,
		BackgroundColor3 = theme.ControlHover,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Enum.Font.Gotham,
		Text = self._value.Name,
		TextColor3 = theme.TextMuted,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = self.Content,
	})
	Util.BindFocusRing(captureButton, function() return context:GetTheme() end, self._maid)

	local capturing = false
	local held = false
	local toggled = false
	local mode = options.Mode or "Press"

	local function render(nextTheme)
		captureButton.BackgroundColor3 = nextTheme.ControlHover
		captureButton.BackgroundTransparency = capturing and 0.86 or 1
		captureButton.TextColor3 = capturing and nextTheme.Accent or nextTheme.TextMuted
		captureButton.Text = capturing and "Press a key..." or self._value.Name
		captureButton.Font = nextTheme.FontNormal or Enum.Font.Gotham
		captureButton.TextSize = (nextTheme.TextSizeOffset or 0) + 15
	end
	self._renderControl = render

	function self:SetValue(value, silent)
		if typeof(value) == "string" then
			value = Enum.KeyCode[value]
		end
		if typeof(value) ~= "EnumItem" or value.EnumType ~= Enum.KeyCode then
			return
		end
		if self._value == value then
			return
		end
		self._value = value
		render(context:GetTheme())
		if not silent then
			self.Changed:Fire(value)
			Util.SafeCall(self._callback, value)
		end
	end

	self._maid:Give(captureButton.Activated:Connect(function()
		if self.Disabled then
			return
		end
		capturing = true
		render(context:GetTheme())
	end))

	function self:_HandleInputBegan(input, processed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		if capturing then
			capturing = false
			if input.KeyCode ~= Enum.KeyCode.Escape then
				self:SetValue(input.KeyCode)
			else
				render(context:GetTheme())
			end
			return
		end
		if processed or self.Disabled or input.KeyCode ~= self._value then
			return
		end
		if mode == "Hold" then
			held = true
			Util.SafeCall(options.OnTriggered, true)
		elseif mode == "Toggle" then
			toggled = not toggled
			Util.SafeCall(options.OnTriggered, toggled)
		else
			Util.SafeCall(options.OnTriggered, true)
		end
	end

	function self:_HandleInputEnded(input)
		if mode == "Hold" and held and input.KeyCode == self._value then
			held = false
			Util.SafeCall(options.OnTriggered, false)
		end
	end

	context:RegisterKeybindControl(self)
	self._maid:Give(function()
		context:UnregisterKeybindControl(self)
	end)
	return self
end

