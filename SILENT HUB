local function getEnvironment()
	return if getgenv then getgenv() else _G
end

local function getGlobal(name)
	local environment = getEnvironment()
	local val = environment and environment[name] or nil
	if val == nil then
		val = _G[name]
	end
	if val == nil then
		local ok, fenv = pcall(getfenv, 0)
		if ok and fenv then
			val = fenv[name]
		end
	end
	if val == nil then
		local ok, fenv = pcall(getfenv, 1)
		if ok and fenv then
			val = fenv[name]
		end
	end
	return val
end

local sharedEnvironment = getEnvironment()
local runtimeRegistry = sharedEnvironment and sharedEnvironment.__SilenceUIRuntime
if type(runtimeRegistry) ~= "table" then
	runtimeRegistry = {
		Windows = {},
	}
	if sharedEnvironment then
		sharedEnvironment.__SilenceUIRuntime = runtimeRegistry
	end
elseif type(runtimeRegistry.Windows) ~= "table" then
	runtimeRegistry.Windows = {}
end

local function resolveGuiParent(explicitParent)
	if explicitParent then
		return explicitParent
	end

	local getHiddenGui = getGlobal("gethui")
	if type(getHiddenGui) == "function" then
		local ok, result = pcall(getHiddenGui)
		if ok and typeof(result) == "Instance" then
			return result
		end
	end

	local localPlayer = Players.LocalPlayer
	if localPlayer then
		local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then
			return playerGui
		end
	end

	return game:GetService("CoreGui")
end

local function protectGui(screenGui)
	local synGlobal = getGlobal("syn")
	if type(synGlobal) == "table" and type(synGlobal.protect_gui) == "function" then
		pcall(synGlobal.protect_gui, screenGui)
		return
	end

	local protect = getGlobal("protectgui") or getGlobal("protect_gui")
	if type(protect) == "function" then
		pcall(protect, screenGui)
	end
end


local Util = {}

function Util.Create(className, properties, children)
	local object = Instance.new(className)
	if properties then
		for property, value in pairs(properties) do
			if property ~= "Parent" then
				object[property] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = object
		end
	end
	if properties and properties.Parent then
		object.Parent = properties.Parent
	end
	return object
end

function Util.Corner(parent, radius)
	return Util.Create("UICorner", {
