function Window:AddTab(options)
	assert(not self.Destroyed, "Window is destroyed")
	assert(type(options) == "table", "Tab options are required")
	assert(self._tabById[options.Id] == nil, "Duplicate tab Id: " .. tostring(options.Id))
	local tab = Tab.new(self, self._content, self._navigation, options)
	local previousTab = self._tabs[#self._tabs]
	if previousTab then
		previousTab.NavigationButton.NextSelectionDown = tab.NavigationButton
		tab.NavigationButton.NextSelectionUp = previousTab.NavigationButton
	end
	table.insert(self._tabs, tab)
	self._tabById[tab.Id] = tab
	if self._preferredTab == tab.Id and tab.Visible and not tab.Disabled then
		self:SelectTab(tab.Id)
	elseif not self._selectedTab and tab.Visible and not tab.Disabled then
		self:SelectTab(tab.Id)
	end
	task.defer(function()
		if self.Destroyed then
			return
		end
		local compact = self.Frame.AbsoluteSize.X < 760
		local label = tab.NavigationButton:FindFirstChild("Label")
		if label then
			label.Visible = not compact
		end
	end)
	return tab
end

function Window:AddNavigationHeader(options)
	options = type(options) == "string" and { Title = options } or options or {}
	local theme = self:GetTheme()
	local label = Util.Create("TextLabel", {
		Name = options.Id or "NavigationHeader",
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = options.Order or 0,
		Text = string.upper(tostring(options.Title or "Group")),
		TextColor3 = theme.TextMuted,
		TextSize = 9,
		TextTransparency = 0.12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 24),
		Visible = options.Visible == true,
		Parent = self._navigation,
	})
	local headerMaid = Maid.new()
	headerMaid:Give(label)
	headerMaid:Give(self:WatchTheme(function(nextTheme)
		label.TextColor3 = nextTheme.TextMuted
	end))
	self._maid:Give(headerMaid)

	local api = {
		Root = label,
		Destroyed = false,
	}
	function api:SetTitle(value)
		label.Text = string.upper(tostring(value or ""))
	end
	function api:SetVisible(visible)
		label.Visible = visible == true
	end
	function api:SetOrder(order)
		label.LayoutOrder = tonumber(order) or 0
	end
	function api:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		headerMaid:Destroy()
	end
	return api
end

