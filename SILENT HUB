function Section:SetCollapsed(collapsed)
	self._collapsed = collapsed == true
	self.Body.Visible = not self._collapsed
	if self.Header then
		local arrow = self.Header:FindFirstChild("Arrow")
		if arrow then
			Util.Tween(arrow, self._context:GetMotion("Fast"), {
				Rotation = self._collapsed and 0 or 90,
			})
		end
	end
end

function Section:SetVisible(visible)
	self.Visible = visible == true
	self.Root.Visible = self.Visible
end

function Section:SetTitle(value)
	if not self.Header then
		return
	end
	local title = self.Header:FindFirstChild("Title")
	if title then
		title.Text = tostring(value or "")
	end
end

function Section:SetDescription(value)
	if not self.Header then
		return
	end
	local description = self.Header:FindFirstChild("Description")
	if description then
		description.Text = tostring(value or "")
		description.Visible = value ~= nil and value ~= ""
	end
end

function Section:GetControl(id)
	for _, control in ipairs(self._controls) do
		if control.Id == id and not control.Destroyed then
			return control
		end
	end
	return nil
end

function Section:RemoveControl(id)
	for index, control in ipairs(self._controls) do
		if control.Id == id then
			table.remove(self._controls, index)
			control:Destroy()
			return true
		end
	end
	return false
end

function Section:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, control in ipairs(self._controls) do
		control:Destroy()
	end
	table.clear(self._controls)
	self._maid:Destroy()
end

-- Tab ------------------------------------------------------------------------

local Tab = {}
Tab.__index = Tab

function Tab.new(context, contentParent, navigationParent, options)
	assert(type(options.Id) == "string" and options.Id ~= "", "Tab Id is required")
	assert(type(options.Title) == "string", "Tab Title is required")

	local theme = context:GetTheme()
	local root = Util.Create("ScrollingFrame", {
		Name = options.Id,
		Active = true,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarImageColor3 = theme.TextMuted,
		ScrollBarImageTransparency = 0.35,
		ScrollBarThickness = 3,
		Position = UDim2.fromOffset(0, 68),
		Size = UDim2.new(1, 0, 1, -68),
		Visible = false,
		Parent = contentParent,
	})
	local pagePadding = Util.Padding(
		root,
		theme.SpacingLarge,
		theme.SpacingLarge,
		theme.SpacingLarge,
		theme.SpacingLarge
	)
	local pageList = Util.List(root, theme.SpacingLarge)

	local navigationButton = Util.Create("TextButton", {
		Name = options.Id,
		AutoButtonColor = false,
		BackgroundColor3 = getTabSelectionColor(theme),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = options.Order or 0,
		Text = "",
		Size = UDim2.new(1, 0, 0, 60),
		Visible = options.Visible ~= false,
		Parent = navigationParent,
	})
	Util.Corner(navigationButton, 30)

	local iconShadow = Util.Create("Frame", {
		Name = "IconShadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = theme.Dark and 0.72 or 0.86,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(13, 13),
		Size = UDim2.fromOffset(38, 38),
		Parent = navigationButton,
	})
	Util.Corner(iconShadow, 11)

	local tabIcon = Util.Create("Frame", {
		Name = "Icon",
		BackgroundColor3 = options.IconBackground or theme.TabIconBackground,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 11),
		Size = UDim2.fromOffset(38, 38),
		Parent = navigationButton,
	})
	Util.Corner(tabIcon, 11)

	local asset = iconAsset(options.Icon)
	if asset then
		Util.Create("ImageLabel", {
			Name = "Glyph",
			BackgroundTransparency = 1,
			Image = asset,
			ImageColor3 = TAB_ICON_GLYPH_COLOR,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(22, 22),
			ZIndex = 2,
			Parent = tabIcon,
		})
	else
		Util.Create("TextLabel", {
			Name = "Glyph",
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = string.upper(string.sub(options.Title, 1, 1)),
			TextColor3 = TAB_ICON_GLYPH_COLOR,
			TextSize = 12,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(22, 22),
			ZIndex = 2,
			Parent = tabIcon,
		})
	end
	local iconStroke = Util.Stroke(tabIcon, Color3.new(1, 1, 1), 0.58, 1)
	iconStroke.Name = "IconStroke"
	local label = Util.Create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = options.Title,
		TextColor3 = theme.TextMuted,
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(66, 0),
		Size = UDim2.new(1, -76, 1, 0),
		Parent = navigationButton,
	})

	local self = setmetatable({
		Id = options.Id,
		Title = options.Title,
		Icon = options.Icon,
		Root = root,
		NavigationButton = navigationButton,
		Badge = options.Badge,
		BadgeStyle = options.BadgeStyle,
		IconBackground = options.IconBackground,
		Selected = false,
		Disabled = options.Disabled == true,
		Visible = options.Visible ~= false,
		Destroyed = false,
		_sections = {},
		_context = context,
		_maid = Maid.new(),
		_builder = options.Build,
		_built = options.Build == nil,
		_building = false,
		_flowSection = nil,
	}, Tab)
	self._maid:Give(root)
	self._maid:Give(navigationButton)
	Util.BindFocusRing(navigationButton, function() return context:GetTheme() end, self._maid)
	self._maid:Give(navigationButton.Activated:Connect(function()
		if not self.Disabled then
			context:SelectTab(self.Id)
		end
	end))
	self._maid:Give(navigationButton.MouseEnter:Connect(function()
		if not self.Selected and not self.Disabled then
			navigationButton.BackgroundColor3 = context:GetTheme().TabHover
			navigationButton.BackgroundTransparency = 0.78
		end
	end))
	self._maid:Give(navigationButton.MouseLeave:Connect(function()
		self:_render(context:GetTheme())
	end))
	self._maid:Give(context:WatchTheme(function(nextTheme)
		pagePadding.PaddingTop = UDim.new(0, nextTheme.SpacingLarge)
		pagePadding.PaddingRight = UDim.new(0, nextTheme.SpacingLarge)
		pagePadding.PaddingBottom = UDim.new(0, nextTheme.SpacingLarge)
		pagePadding.PaddingLeft = UDim.new(0, nextTheme.SpacingLarge)
		pageList.Padding = UDim.new(0, nextTheme.SpacingLarge)
		self:_render(nextTheme)
	end))
	self:_render(theme)
	if options.Badge ~= nil then
		self:SetBadge(options.Badge, options.BadgeStyle)
	end
	return self
end

function Tab:_render(theme)
	self.NavigationButton.BackgroundColor3 = getTabSelectionColor(theme)
	self.NavigationButton.BackgroundTransparency = self.Selected and 0 or 1
	local icon = self.NavigationButton:FindFirstChild("Icon")
	local label = self.NavigationButton:FindFirstChild("Label")
	if icon then
		icon.BackgroundColor3 = self.IconBackground or theme.TabIconBackground
		local iconStroke = icon:FindFirstChild("IconStroke")
		if iconStroke then
			iconStroke.Color = theme.GlassHighlight
			iconStroke.Transparency = theme.Dark and 0.68 or 0.48
		end
		local glyph = icon:FindFirstChild("Glyph")
		if glyph and glyph:IsA("ImageLabel") then
			glyph.ImageColor3 = TAB_ICON_GLYPH_COLOR
		elseif glyph and glyph:IsA("TextLabel") then
			glyph.TextColor3 = TAB_ICON_GLYPH_COLOR
		end
	end
	local iconShadow = self.NavigationButton:FindFirstChild("IconShadow")
	if iconShadow then
		iconShadow.BackgroundTransparency = theme.Dark and 0.72 or 0.86
	end
	if label then
		label.Font = self.Selected and (theme.FontSemibold or Enum.Font.GothamSemibold) or (theme.FontNormal or Enum.Font.Gotham)
		label.TextSize = (theme.TextSizeOffset or 0) + 16
		label.TextColor3 = self.Selected
			and theme.Text
			or (self.Disabled and theme.TextDisabled or theme.TextMuted)
	end
	local badge = self.NavigationButton:FindFirstChild("Badge")
	if badge then
		badge.BackgroundColor3 = self.BadgeStyle == "Danger" and theme.Danger
			or self.BadgeStyle == "Success" and theme.Success
			or self.BadgeStyle == "Warning" and theme.Warning
			or theme.Accent
		badge.TextColor3 = theme.AccentText
	end
	local corner = self.NavigationButton:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(0, 30)
	end
end

function Tab:SetSelected(selected)
	self.Selected = selected == true
	self.Root.Visible = self.Selected and self.Visible
	if self.Selected and not self._built and not self._building then
		self._building = true
		local ok, message = xpcall(function()
			self._builder(self)
		end, debug.traceback)
		self._building = false
		self._built = true
		if not ok then
			warn("[SilenceUI] Lazy tab build failed for " .. self.Id .. ":\n" .. tostring(message))
		end
	end
	self:_render(self._context:GetTheme())
end

function Tab:IsBuilt()
	return self._built
end

function Tab:Build()
	if self._built or self._building then
		return false
	end
	self._building = true
	local ok, message = xpcall(function()
		self._builder(self)
	end, debug.traceback)
	self._building = false
	self._built = true
	if not ok then
		warn("[SilenceUI] Lazy tab build failed for " .. self.Id .. ":\n" .. tostring(message))
		return false, message
	end
	return true
end

function Tab:SetVisible(visible)
	self.Visible = visible == true
	self.NavigationButton.Visible = self.Visible
	self.Root.Visible = self.Visible and self.Selected
end

function Tab:SetDisabled(disabled)
	self.Disabled = disabled == true
	self:_render(self._context:GetTheme())
end

function Tab:SetTitle(value)
	self.Title = tostring(value)
	local label = self.NavigationButton:FindFirstChild("Label")
	if label then
		label.Text = self.Title
	end
end

function Tab:SetIcon(value)
	self.Icon = value
	local icon = self.NavigationButton:FindFirstChild("Icon")
	local glyph = icon and icon:FindFirstChild("Glyph")
	local asset = iconAsset(value)
	if glyph and glyph:IsA("ImageLabel") and asset then
		glyph.Image = asset
	elseif glyph and glyph:IsA("TextLabel") and not asset then
		glyph.Text = tostring(value or string.upper(string.sub(self.Title, 1, 1)))
	end
end

function Tab:SetBadge(value, style)
	self.Badge = value
	self.BadgeStyle = style
	local badge = self.NavigationButton:FindFirstChild("Badge")
	if value == nil or value == false or tostring(value) == "" then
		if badge then
			badge:Destroy()
		end
		local label = self.NavigationButton:FindFirstChild("Label")
		if label then
			label.Size = UDim2.new(1, -76, 1, 0)
		end
		return
	end
	if not badge then
		badge = Util.Create("TextLabel", {
			Name = "Badge",
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = self._context:GetTheme().Accent,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamSemibold,
			Text = "",
			TextColor3 = self._context:GetTheme().AccentText,
			TextSize = 9,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(0, 20),
			Parent = self.NavigationButton,
		})
		Util.Corner(badge, 10)
	end
	badge.Text = "  " .. tostring(value) .. "  "
	local label = self.NavigationButton:FindFirstChild("Label")
	if label then
		label.Size = UDim2.new(1, -110, 1, 0)
	end
	self:_render(self._context:GetTheme())
end

function Tab:AddSection(options)
	assert(not self.Destroyed, "Tab is destroyed")
	local section = Section.new(self._context, self.Root, options)
	table.insert(self._sections, section)
	return section
