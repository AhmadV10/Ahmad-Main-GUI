		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -24, 1, -76),
		ZIndex = 602,
		Parent = palette,
	})
	Util.List(results, 5)

	local closed = false
	local rows = {}
	local rowMaid = Maid.new()
	paletteMaid:Set("Rows", rowMaid)
	local selectedIndex = 1
	local visibleCommands = {}

	local function close()
		if closed then return end
		closed = true
		paletteMaid:Destroy()
	end

	local function commandSearchText(command)
		local keywords = type(command.Keywords) == "table"
			and table.concat(command.Keywords, " ")
			or tostring(command.Keywords or "")
		return string.lower(
			command.Title
			.. " "
			.. tostring(command.Description or "")
			.. " "
			.. keywords
		)
	end

	local function renderSelection()
		for index, command in ipairs(visibleCommands) do
			local row = rows[command.Id]
			if row then
				local selected = index == selectedIndex
				row.BackgroundColor3 = selected and self:GetTheme().Accent or self:GetTheme().SurfaceRaised
				row.BackgroundTransparency = selected and 0 or 0.24
				local title = row:FindFirstChild("Title")
				local description = row:FindFirstChild("Description")
				if title then
					title.TextColor3 = selected and self:GetTheme().AccentText or self:GetTheme().Text
				end
				if description then
					description.TextColor3 = selected and self:GetTheme().AccentText or self:GetTheme().TextMuted
				end
			end
		end
	end

	local function execute(command)
		if command and not command.Disabled then
			close()
			Util.SafeCall(command.Callback)
		end
	end

	local function rebuild()
		rowMaid:Destroy()
		rowMaid = Maid.new()
		paletteMaid:Set("Rows", rowMaid)
		for _, row in pairs(rows) do
			row:Destroy()
		end
		table.clear(rows)
		table.clear(visibleCommands)

		local query = string.lower(search.Text):gsub("^%s+", ""):gsub("%s+$", "")
		for _, command in pairs(self._commands) do
			if not command.Disabled and (
				query == ""
				or string.find(commandSearchText(command), query, 1, true)
			) then
				table.insert(visibleCommands, command)
			end
		end
		table.sort(visibleCommands, function(a, b)
			if a.Order ~= b.Order then
				return a.Order < b.Order
			end
			return a.Title < b.Title
		end)
		selectedIndex = math.clamp(selectedIndex, 1, math.max(#visibleCommands, 1))

		for index, command in ipairs(visibleCommands) do
			local row = Util.Create("TextButton", {
				Name = command.Id,
				AutoButtonColor = false,
				BackgroundColor3 = theme.SurfaceRaised,
				BackgroundTransparency = 0.24,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Text = "",
				Size = UDim2.new(1, 0, 0, command.Description and 52 or 42),
				ZIndex = 603,
				Parent = results,
			})
			Util.Corner(row, theme.RadiusSmall)
			Util.Create("TextLabel", {
				Name = "Title",
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				Text = command.Title,
				TextColor3 = theme.Text,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				Position = UDim2.fromOffset(12, command.Description and 5 or 0),
				Size = UDim2.new(1, -24, command.Description and 0.5 or 1, 0),
				ZIndex = 604,
				Parent = row,
			})
			if command.Description then
				Util.Create("TextLabel", {
					Name = "Description",
					BackgroundTransparency = 1,
					Font = Enum.Font.Gotham,
					Text = command.Description,
					TextColor3 = theme.TextMuted,
					TextSize = 10,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 12, 0.5, 0),
					Size = UDim2.new(1, -24, 0.5, -4),
					ZIndex = 604,
					Parent = row,
				})
			end
			rows[command.Id] = row
			rowMaid:Give(row.Activated:Connect(function()
				execute(command)
			end))
			rowMaid:Give(row.MouseEnter:Connect(function()
				selectedIndex = index
				renderSelection()
			end))
		end
		renderSelection()
	end

	paletteMaid:Give(overlay)
	paletteMaid:Give(search:GetPropertyChangedSignal("Text"):Connect(rebuild))
	paletteMaid:Give(overlay.Activated:Connect(close))
	paletteMaid:Give(UserInputService.InputBegan:Connect(function(input, processed)
		local navigationKey = input.KeyCode == Enum.KeyCode.Return
			or input.KeyCode == Enum.KeyCode.KeypadEnter
			or input.KeyCode == Enum.KeyCode.Up
			or input.KeyCode == Enum.KeyCode.Down
			or input.KeyCode == Enum.KeyCode.Escape
		if processed and not navigationKey then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape then
			close()
		elseif input.KeyCode == Enum.KeyCode.Down then
			selectedIndex = math.min(selectedIndex + 1, math.max(#visibleCommands, 1))
			renderSelection()
		elseif input.KeyCode == Enum.KeyCode.Up then
			selectedIndex = math.max(selectedIndex - 1, 1)
			renderSelection()
		elseif input.KeyCode == Enum.KeyCode.Return
			or input.KeyCode == Enum.KeyCode.KeypadEnter then
			execute(visibleCommands[selectedIndex])
		end
	end))
	paletteMaid:Give(self:WatchTheme(function(nextTheme)
		styleGlass(palette, nextTheme, self.Quality, nil, "Overlay")
		search.BackgroundColor3 = nextTheme.Control
		search.TextColor3 = nextTheme.Text
		search.PlaceholderColor3 = nextTheme.TextMuted
		renderSelection()
	end))

	rebuild()
	task.defer(function()
		if not closed then
			search:CaptureFocus()
		end
	end)
	return {
		Close = close,
		Root = overlay,
	}
end

function Window:Popover(target, options)
	assert(typeof(target) == "Instance" and target:IsA("GuiObject"), "Popover target must be a GuiObject")
	options = options or {}
	local items = options.Items or {}
	local theme = self:GetTheme()
	local popoverMaid = Maid.new()
	local overlay = Util.Create("TextButton", {
		Name = "PopoverOverlay",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 700,
		Parent = self.Root,
	})
	local width = math.clamp(tonumber(options.Width) or 210, 140, 360)
	local itemHeight = math.max(tonumber(options.ItemHeight) or 36, 28)
	local separatorCount = 0
	for _, item in ipairs(items) do
		if item.Separator then
			separatorCount += 1
		end
	end
	local contentHeight = (#items - separatorCount) * itemHeight + separatorCount * 9 + 8
	local panel = Util.Create("Frame", {
		Name = "Popover",
		BackgroundColor3 = theme.SurfaceOverlay,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, contentHeight),
		ZIndex = 701,
		Parent = overlay,
	})
	Util.Corner(panel, theme.RadiusMedium)
	styleGlass(panel, theme, self.Quality, nil, "Overlay")
	Util.Padding(panel, 4)
	Util.List(panel, 1)

	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local targetPosition = target.AbsolutePosition
	local targetSize = target.AbsoluteSize
	local x = targetPosition.X
	local y = targetPosition.Y + targetSize.Y + 6
	if options.Align == "Right" then
		x = targetPosition.X + targetSize.X - width
	elseif options.Align == "Center" then
		x = targetPosition.X + targetSize.X * 0.5 - width * 0.5
	end
	if y + contentHeight > viewport.Y - 8 then
		y = targetPosition.Y - contentHeight - 6
	end
	x = math.clamp(x, 8, math.max(8, viewport.X - width - 8))
	y = math.clamp(y, 8, math.max(8, viewport.Y - contentHeight - 8))
	panel.Position = UDim2.fromOffset(x, y)

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		popoverMaid:Destroy()
	end

	for index, item in ipairs(items) do
		if item.Separator then
			Util.Create("Frame", {
				Name = "Separator" .. tostring(index),
				BackgroundColor3 = theme.Border,
				BackgroundTransparency = 0.5,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, 8),
				ZIndex = 702,
				Parent = panel,
			})
		else
			local button = Util.Create("TextButton", {
				Name = item.Id or ("Item" .. tostring(index)),
				AutoButtonColor = false,
				BackgroundColor3 = theme.SurfaceRaised,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamMedium,
				LayoutOrder = index,
				Text = "  " .. tostring(item.Title or item.Text or "Item"),
				TextColor3 = item.Disabled and theme.TextDisabled
					or item.Danger and theme.Danger
					or theme.Text,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, 0, 0, itemHeight),
				ZIndex = 702,
				Parent = panel,
			})
			Util.Corner(button, math.max(theme.RadiusSmall - 2, 0))
			popoverMaid:Give(button.MouseEnter:Connect(function()
				if not item.Disabled then
					button.BackgroundColor3 = item.Danger and theme.Danger or theme.Accent
					button.BackgroundTransparency = 0
					button.TextColor3 = theme.AccentText
				end
			end))
			popoverMaid:Give(button.MouseLeave:Connect(function()
				button.BackgroundTransparency = 1
				button.TextColor3 = item.Disabled and theme.TextDisabled
					or item.Danger and theme.Danger
					or theme.Text
			end))
			popoverMaid:Give(button.Activated:Connect(function()
				if item.Disabled then
					return
				end
				Util.SafeCall(item.Callback)
				if item.Close ~= false then
					close()
				end
			end))
		end
	end

	popoverMaid:Give(overlay)
	popoverMaid:Give(overlay.Activated:Connect(close))
	popoverMaid:Give(self:WatchTheme(function(nextTheme)
		styleGlass(panel, nextTheme, self.Quality, nil, "Overlay")
	end))
	return {
		Close = close,
		Root = panel,
	}
end

